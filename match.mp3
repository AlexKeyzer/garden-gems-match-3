      } else {
        [523, 659, 784, 1047, 1319].forEach(function (f, i) {
          Sound.tone({ f0: f, dur: 0.22, type: 'sine', vol: 0.16, delay: i * 0.05 });
        });
      }
    },
    spawn: function () { this.tone({ f0: 700, f1: 1200, dur: 0.15, type: 'sine', vol: 0.15 }); },
    click: function () { this.tone({ f0: 600, f1: 800, dur: 0.06, type: 'sine', vol: 0.12 }); },
    coin: function () { this.tone({ f0: 988, dur: 0.09, type: 'square', vol: 0.1 }); this.tone({ f0: 1319, dur: 0.14, type: 'square', vol: 0.1, delay: 0.08 }); },
    win: function () {
      if (this.playBuf('win', 0.9)) return;
      var seq = [523, 659, 784, 1047, 784, 1047, 1319];
      var self = this;
      seq.forEach(function (f, i) { self.tone({ f0: f, dur: 0.22, type: 'triangle', vol: 0.22, delay: i * 0.12 }); });
    },
    lose: function () {
      var seq = [392, 349, 311, 262];
      var self = this;
      seq.forEach(function (f, i) { self.tone({ f0: f, dur: 0.25, type: 'triangle', vol: 0.18, delay: i * 0.15 }); });
    },
    shuffle: function () {
      for (var i = 0; i < 5; i++) this.tone({ f0: 300 + i * 90, f1: 500 + i * 90, dur: 0.08, type: 'sine', vol: 0.1, delay: i * 0.04 });
    },

    /* procedural calm music loop */
    startMusic: function () {
      if (!this.ctx || this.musicTimer) return;
      var self = this;
      this.nextNoteTime = this.ctx.currentTime + 0.1;
      this.musicStep = 0;
      this.musicTimer = setInterval(function () { self.scheduleMusic(); }, 250);
      this.scheduleMusic();
    },
    stopMusic: function () {
      if (this.musicTimer) { clearInterval(this.musicTimer); this.musicTimer = null; }
    },
    scheduleMusic: function () {
      if (!this.ctx || !this.musicEnabled || this.externalMute) return;
      var chords = [
        [261.6, 329.6, 392.0],  // C
        [220.0, 261.6, 329.6],  // Am
        [174.6, 261.6, 349.2],  // F
        [196.0, 246.9, 293.7]   // G
      ];
      var melody = [523, 587, 659, 587, 523, 494, 440, 494];
      while (this.nextNoteTime < this.ctx.currentTime + 0.6) {
        var step = this.musicStep;
        var ch = chords[Math.floor(step / 4) % chords.length];
        if (step % 4 === 0) {
          for (var i = 0; i < ch.length; i++) {
            this.tone({ f0: ch[i] / 2, dur: 1.9, type: 'sine', vol: 0.045, dest: this.musicGain, atk: 0.4, delay: this.nextNoteTime - this.ctx.currentTime });
          }
        }
        if (step % 2 === 1) {
          var m = melody[(step * 3 + Math.floor(step / 8)) % melody.length];
          this.tone({ f0: m, dur: 0.5, type: 'triangle', vol: 0.03, dest: this.musicGain, atk: 0.02, delay: this.nextNoteTime - this.ctx.currentTime });
        }
        this.nextNoteTime += 0.5;
        this.musicStep++;
      }
    },
    refreshMusic: function () {
      var want = this.musicEnabled && !this.externalMute && !paused;
      if (want && !this.musicTimer) this.startMusic();
      if (!want && this.musicTimer) this.stopMusic();
    },
    suspend: function () {
      this.externalMute = true;
      this.stopMusic();
      try { if (this.ctx && this.ctx.state === 'running') this.ctx.suspend(); } catch (e) { /* noop */ }
    },
    resume: function () {
      this.externalMute = false;
      try { if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume(); } catch (e) { /* noop */ }
      this.refreshMusic();
    }
  };

  /* ---------------- assets ---------------- */
  var IMG_LIST = ['bg_menu', 'bg_game', 'bg_shop', 'board_frame'];
  for (var gi = 0; gi < GEM_KEYS.length; gi++) IMG_LIST.push(GEM_KEYS[gi]);
  IMG_LIST.push('special_bomb', 'special_lightning', 'special_rainbow',
    'block_wood', 'block_stone',
    'item_01', 'item_02', 'item_03', 'item_04', 'item_05',
    'ui_play', 'ui_levels', 'ui_shop', 'ui_achieve', 'ui_settings', 'ui_sound_on', 'ui_sound_off',
    'ui_hammer', 'ui_shuffle',
    'eq_water', 'eq_hive', 'eq_greenhouse', 'eq_lantern', 'eq_fountain', 'eq_scarecrow',
    'jp_torii', 'jp_lantern', 'jp_koi', 'jp_bonsai', 'jp_bridge',
    'md_amphora', 'md_cypress', 'md_pergola', 'md_statue', 'md_orange',
    'tr_palm', 'tr_orchid', 'tr_hammock', 'tr_flamingo', 'tr_tiki',
    'wn_snowman', 'wn_pine', 'wn_garland', 'wn_feeder', 'wn_icefount',
    'nt_mushroom', 'nt_arch', 'nt_crystal', 'nt_owl', 'nt_jar',
    'coin');
  for (var fi = 1; fi <= 10; fi++) IMG_LIST.push('gnome_' + (fi < 10 ? '0' + fi : fi));
  var images = {};

  function loadAssets(onProgress) {
    return new Promise(function (resolve) {
      var total = IMG_LIST.length, done = 0;
      IMG_LIST.forEach(function (name) {
        var im = new Image();
        im.onload = im.onerror = function () {
          done++;
          if (onProgress) onProgress(done / total);
          if (done === total) resolve();
        };
        im.src = 'img/' + name + '.png';
        images[name] = im;
      });
    });
  }
  function img(name) { return images[name]; }
  function imgReady(name) { var i = images[name]; return i && i.complete && i.naturalWidth > 0; }

  /* ---------------- session state ---------------- */
  var G = {
    screen: 'boot',            // boot|menu|levels|game|shop|achieve|settings
    level: null,               // level config object
    levelNum: 0,
    isDaily: false,
    grid: null,
    rng: Math.random,
    phase: 'idle',             // idle|anim (input locked while anim)
    moves: 0, movesUsed: 0,
    score: 0,
    collected: 0,              // collect-goal progress
    blocksTotal: 0, blocksDone: 0,
    deliveredTotal: 0, delivered: 0,
    gemsAtStart: 0,
    maxCascade: 0,
    selected: null,            // [r,c]
    hintMove: null, hintT: 0,
    boosterMode: null,         // null|'hammer'
    startBombPending: false,
    tutStep: 0, tutActive: false, tutMove: null,
    winShown: false, loseShown: false,
    sessionStart: 0, lastInterstitial: 0, playSegmentStart: 0,
    rainbowPick: null,         // {r,c,cb}
    scareLeft: 0,
    portalPairs: [],
    chocStart: 0,
    isEndless: false, endlessDepth: 0, endlessRunScore: 0,
    runMoves: [], ghostIdx: 0
  };
  var P = null;                // platform adapter
  var paused = false;          // external pause (gp pause / hidden tab / ad)

  /* ---------------- tween system (rAF-driven, pause-safe) ---------------- */
  var tweens = [];
  var timeScale = 1; // test hook: accelerate all tweens
  function tween(dur, upd, done, easeFn) {
    var tw = { t: 0, dur: Math.max(1, dur), upd: upd, done: done || null, ease: easeFn || easeOutQuad };
    tweens.push(tw);
    return tw;
  }
  function waitStep(ms, fn) { // sequence helper: run fn after ms of *unpaused* time
    tween(ms, null, fn);
  }
  function tweenStep(dt) {
    dt *= timeScale * ((save.settings && save.settings.fast) ? 1.7 : 1);
    for (var i = tweens.length - 1; i >= 0; i--) {
      var tw = tweens[i];
      tw.t += dt;
      var p = clamp(tw.t / tw.dur, 0, 1);
      if (tw.upd) tw.upd(tw.ease(p), p);
      if (p >= 1) { tweens.splice(i, 1); if (tw.done) tw.done(); }
    }
  }

  /* ---------------- particles / floaters / shake ---------------- */
  var particles = [];
  var PARTICLE_CAP = 260;
  function burst(x, y, color, n, power) {
    n = n || 8;
    for (var i = 0; i < n && particles.length < PARTICLE_CAP; i++) {
      var a = Math.random() * Math.PI * 2;
      var v = (0.5 + Math.random()) * (power || 120);
      particles.push({ x: x, y: y, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 40, life: 0.5 + Math.random() * 0.3, t: 0, color: color, size: 3 + Math.random() * 4, rot: Math.random() * 6.28 });
    }
  }
  function updateParticles(dt) {
    for (var i = particles.length - 1; i >= 0; i--) {
      var p = particles[i];
      p.t += dt;
      if (p.t >= p.life) { particles.splice(i, 1); continue; }
      p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 500 * dt; p.vx *= 0.98;
    }
  }
  var floaters = [];
  function floater(x, y, text, color, size) {
    if (floaters.length > 14) floaters.shift();
    floaters.push({ x: x, y: y, text: text, color: color || '#fff', size: size || 18, t: 0, life: 1.1 });
  }
  function updateFloaters(dt) {
    for (var i = floaters.length - 1; i >= 0; i--) {
      var f = floaters[i]; f.t += dt; f.y -= 34 * dt;
      if (f.t >= f.life) floaters.splice(i, 1);
    }
  }
  var shake = { mag: 0 };
  function doShake(m) { if (save.settings && save.settings.motionreduce) return; shake.mag = Math.min(10, shake.mag + m); }

  /* shockwave rings (juice) */
  var rings = [];
  function ring(x, y, color, maxR) {
    if (rings.length > 10) rings.shift();
    rings.push({ x: x, y: y, t: 0, life: 0.42, color: color, maxR: maxR || cellPx * 1.4 });
  }
  function updateRings(dt) {
    for (var i = rings.length - 1; i >= 0; i--) {
      rings[i].t += dt;
      if (rings[i].t >= rings[i].life) rings.splice(i, 1);
    }
  }

  /* dying cells (removed but still animating) */
  var dying = [];

  /* ---------------- canvas & layout ---------------- */
  var canvas, ctx, boardPx = 0, cellPx = 0, dpr = 1;
  var fpsStats = { frames: 0, last: 0, fps: 60 };

  function layout() {
    if (!canvas) return;
    var wrap = $('#boardWrap');
    if (!wrap) return;
    var w = wrap.clientWidth, h = wrap.clientHeight;
    if (w < 10 || h < 10) return;
    // reserve space for the decorative frame padding/border
    boardPx = Math.max(120, Math.floor(Math.min(w, h) - 36));
    cellPx = boardPx / SIZE;
    dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.floor(boardPx * dpr);
    canvas.height = Math.floor(boardPx * dpr);
    canvas.style.width = boardPx + 'px';
    canvas.style.height = boardPx + 'px';
  }

  function cellCenter(r, c) { return { x: (c + 0.5) * cellPx, y: (r + 0.5) * cellPx }; }

  function gemImageName(cell) {
    if (cell.sp === SP.BOMB) return 'special_bomb';
    if (cell.sp === SP.LIGHTNING) return 'special_lightning';
    if (cell.sp === SP.RAINBOW) return 'special_rainbow';
    return GEM_KEYS[cell.c] || GEM_KEYS[0];
  }
  var GEM_COLORS = ['#e74c3c', '#3d7bdc', '#3fbf54', '#f2c530', '#9b59d0', '#f08a2e', '#ef6fae', '#2ec4b6'];

  function render() {
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, boardPx, boardPx);
    if (G.screen !== 'game') return;

    var ox = 0, oy = 0;
    if (shake.mag > 0.2) {
      ox = (Math.random() - 0.5) * shake.mag * 2;
      oy = (Math.random() - 0.5) * shake.mag * 2;
    }
    ctx.save();
    ctx.translate(ox, oy);

    // board backdrop cells
    var pad = 2;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      ctx.fillStyle = (r + c) % 2 === 0 ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.16)';
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(c * cellPx + pad, r * cellPx + pad, cellPx - pad * 2, cellPx - pad * 2, 6);
      else ctx.rect(c * cellPx + pad, r * cellPx + pad, cellPx - pad * 2, cellPx - pad * 2);
      ctx.fill();
    }

    // selection & hint highlight
    var time = performance.now() / 1000;
    if (G.selected) {
      drawRing(G.selected[0], G.selected[1], '#ffe27a', 1, 4);
    }
    if (G.hintMove && G.phase === 'idle' && G.hintT < -3) {
      var pulse = 0.55 + 0.45 * Math.sin(time * 6);
      ctx.globalAlpha = pulse;
      drawRing(G.hintMove[0][0], G.hintMove[0][1], '#ffe27a', 0.9, 3);
      drawRing(G.hintMove[1][0], G.hintMove[1][1], '#ffe27a', 0.9, 3);
      ctx.globalAlpha = 1;
    }
    if (G.tutActive && G.tutMove) {
      var pulse2 = 0.55 + 0.45 * Math.sin(time * 6);
      ctx.globalAlpha = pulse2;
      drawRing(G.tutMove[0][0], G.tutMove[0][1], '#7CFC00', 1, 4);
      drawRing(G.tutMove[1][0], G.tutMove[1][1], '#7CFC00', 1, 4);
      ctx.globalAlpha = 1;
    }
    if (G.boosterMode === 'hammer') {
      ctx.globalAlpha = 0.5 + 0.5 * Math.sin(time * 8);
      ctx.strokeStyle = '#ffdf6b'; ctx.lineWidth = 4;
      ctx.strokeRect(3, 3, boardPx - 6, boardPx - 6);
      ctx.globalAlpha = 1;
    }

    // cells with soft ground shadow
    if (G.grid) {
      for (var rr = 0; rr < SIZE; rr++) for (var cc = 0; cc < SIZE; cc++) {
        var cell = G.grid[rr][cc];
        if (!cell) continue;
        if (G.selected && G.selected[0] === rr && G.selected[1] === cc && cell.t === T.GEM) {
          cell.vs = 1.12;
        } else if (cell.vs === 1.12) cell.vs = 1;
        var vx0 = (cell.vx !== undefined ? cell.vx : cc);
        var vy0 = (cell.vy !== undefined ? cell.vy : rr);
        if (cell.t === T.GEM || cell.t === T.ITEM) {
          var sc0 = cellCenter(0, 0);
          void sc0;
          ctx.globalAlpha = 0.22 * (cell.va !== undefined ? cell.va : 1);
          ctx.fillStyle = '#04140a';
          ctx.beginPath();
          ctx.ellipse((vx0 + 0.5) * cellPx, (vy0 + 0.86) * cellPx, cellPx * 0.32, cellPx * 0.12, 0, 0, 6.29);
          ctx.fill();
          ctx.globalAlpha = 1;
        }
        drawCell(cell, rr, cc);
      }
    }
    // portal rings (above gems for readability)
    for (var pp = 0; pp < G.portalPairs.length; pp++) {
      for (var pk = 0; pk < 2; pk++) {
        var pc = cellCenter(G.portalPairs[pp][pk][0], G.portalPairs[pp][pk][1]);
        var col = pk === 0 ? '#7ec8ff' : '#e08aff';
        ctx.save();
        ctx.translate(pc.x, pc.y);
        ctx.rotate(time * (pk === 0 ? 1.4 : -1.4));
        ctx.globalAlpha = 0.85;
        ctx.strokeStyle = col; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(0, 0, cellPx * 0.44, 0.4, 5.4); ctx.stroke();
        ctx.globalAlpha = 0.4;
        ctx.beginPath(); ctx.arc(0, 0, cellPx * 0.34, 3.5, 8.6); ctx.stroke();
        ctx.restore();
        ctx.globalAlpha = 1;
      }
    }
    // dying cells
    for (var d = dying.length - 1; d >= 0; d--) {
      var dc = dying[d];
      ctx.globalAlpha = Math.max(0, dc.alpha);
      var s = cellPx * dc.scale;
      var name = dc.img;
      if (imgReady(name)) ctx.drawImage(img(name), dc.x - s / 2, dc.y - s / 2, s, s);
      ctx.globalAlpha = 1;
    }
    // shockwave rings
    for (var ri = 0; ri < rings.length; ri++) {
      var rg = rings[ri];
      var kp = rg.t / rg.life;
      ctx.globalAlpha = (1 - kp) * 0.8;
      ctx.strokeStyle = rg.color;
      ctx.lineWidth = 4 * (1 - kp) + 1;
      ctx.beginPath();
      ctx.arc(rg.x, rg.y, rg.maxR * easeOutQuad(kp), 0, 6.29);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
    // particles
    for (var pi = 0; pi < particles.length; pi++) {
      var p2 = particles[pi];
      var k = 1 - p2.t / p2.life;
      ctx.globalAlpha = k;
      ctx.fillStyle = p2.color;
      var sz = p2.size * (0.5 + k * 0.8);
      ctx.save();
      ctx.translate(p2.x, p2.y); ctx.rotate(p2.rot + p2.t * 6);
      ctx.fillRect(-sz / 2, -sz / 2, sz, sz);
      ctx.restore();
    }
    ctx.globalAlpha = 1;
    // floaters
    ctx.textAlign = 'center';
    for (var fi2 = 0; fi2 < floaters.length; fi2++) {
      var f2 = floaters[fi2];
      var kk = 1 - f2.t / f2.life;
      ctx.globalAlpha = Math.min(1, kk * 1.6);
      ctx.font = 'bold ' + f2.size + 'px system-ui, sans-serif';
      ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(0,0,0,0.45)';
      ctx.strokeText(f2.text, f2.x, f2.y);
      ctx.fillStyle = f2.color;
      ctx.fillText(f2.text, f2.x, f2.y);
    }
    ctx.globalAlpha = 1;
    ctx.restore();
  }

  function drawRing(r, c, color, alpha, lw) {
    var p = cellCenter(r, c);
    ctx.globalAlpha = alpha;
    ctx.strokeStyle = color;
    ctx.lineWidth = lw;
    var rad = cellPx * 0.46;
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(p.x - rad, p.y - rad, rad * 2, rad * 2, rad * 0.35);
    else ctx.rect(p.x - rad, p.y - rad, rad * 2, rad * 2);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  function drawCell(cell, r, c) {
    var vx = (cell.vx !== undefined ? cell.vx : c);
    var vy = (cell.vy !== undefined ? cell.vy : r);
    var vs = (cell.vs !== undefined ? cell.vs : 1);
    var va = (cell.va !== undefined ? cell.va : 1);
    var x = (vx + 0.5) * cellPx, y = (vy + 0.5) * cellPx;
    var s = cellPx * 0.94 * vs;
    if (va < 1) ctx.globalAlpha = va;
    var name;
    if (cell.t === T.CHOC) {
      ctx.fillStyle = '#5a3413';
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(x - s / 2, y - s / 2, s, s, s * 0.3); else ctx.rect(x - s / 2, y - s / 2, s, s);
      ctx.fill();
      ctx.fillStyle = '#7a4a20';
      ctx.beginPath(); ctx.arc(x - s * 0.16, y - s * 0.1, s * 0.2, 0, 6.29); ctx.arc(x + s * 0.14, y + 0.12 * s, s * 0.17, 0, 6.29); ctx.fill();
      ctx.globalAlpha = 0.7 * va;
      ctx.fillStyle = 'rgba(255,230,190,0.5)';
      ctx.beginPath(); ctx.ellipse(x - s * 0.18, y - s * 0.24, s * 0.13, s * 0.07, -0.6, 0, 6.29); ctx.fill();
      ctx.globalAlpha = 1;
      return;
    }
    if (cell.t === T.BLOCK) name = cell.hp >= 2 ? 'block_stone' : 'block_wood';
    else if (cell.t === T.ITEM) name = 'item_0' + (cell.it || 1);
    else name = gemImageName(cell);
    if (imgReady(name)) {
      ctx.drawImage(img(name), x - s / 2, y - s / 2, s, s);
      if (cell.ice) {
        ctx.globalAlpha = (0.42 + 0.05 * Math.min(8, cell.ice)) * va;
        ctx.fillStyle = '#d8f0ff';
        ctx.beginPath();
        if (ctx.roundRect) ctx.roundRect(x - s / 2, y - s / 2, s, s, s * 0.22); else ctx.rect(x - s / 2, y - s / 2, s, s);
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.9)'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(x - s * 0.3, y - s * 0.1); ctx.lineTo(x - s * 0.05, y + s * 0.12); ctx.lineTo(x + s * 0.22, y - s * 0.18); ctx.stroke();
        ctx.globalAlpha = va;
      }
      if (cell.honey) {
        ctx.globalAlpha = 0.55 * va;
        ctx.fillStyle = '#f0b23c';
        ctx.beginPath(); ctx.arc(x, y, s * 0.52, 0, 6.29); ctx.fill();
        ctx.globalAlpha = 0.8 * va;
        ctx.fillStyle = 'rgba(255,240,180,0.8)';
        ctx.beginPath(); ctx.ellipse(x - s * 0.15, y - s * 0.2, s * 0.14, s * 0.09, -0.5, 0, 6.29); ctx.fill();
        ctx.globalAlpha = va;
      }
      if (cell.t === T.GEM && save.settings && save.settings.colorblind && cell.c >= 0) {
        var SYM = ['●', '▲', '■', '★', '◆', '⬟', '♥', '⬢'];
        ctx.globalAlpha = 0.95 * va;
        ctx.font = 'bold ' + Math.round(s * 0.34) + 'px system-ui, sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(0,0,0,0.65)';
        ctx.strokeText(SYM[cell.c], x, y + s * 0.02);
        ctx.fillStyle = '#fff';
        ctx.fillText(SYM[cell.c], x, y + s * 0.02);
        ctx.textBaseline = 'alphabetic';
        ctx.globalAlpha = va;
      }
      if (cell.t === T.GEM && cell.sp === SP.NONE && cell.flash > 0) {
        ctx.globalAlpha = cell.flash;
        ctx.fillStyle = '#fff';
        ctx.beginPath(); ctx.arc(x, y, s * 0.45, 0, 6.29); ctx.fill();
        cell.flash -= 0.05;
      }
    } else {
      // procedural fallback (no 404-crash): colored rounded square
      ctx.fillStyle = cell.t === T.GEM ? GEM_COLORS[cell.c] || '#888' : (cell.t === T.BLOCK ? '#8a6b45' : '#c9a86a');
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(x - s / 2, y - s / 2, s, s, s * 0.25);
      else ctx.rect(x - s / 2, y - s / 2, s, s);
      ctx.fill();
      if (cell.sp) { ctx.fillStyle = '#fff'; ctx.font = 'bold ' + (s * 0.4) + 'px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(cell.sp === SP.BOMB ? '💣' : (cell.sp === SP.LIGHTNING ? '⚡' : '🌈'), x, y); ctx.textBaseline = 'alphabetic'; }
    }
    ctx.globalAlpha = 1;
  }

  /* ---------------- main loop ---------------- */
  var lastTs = 0;
  function frame(ts) {
    requestAnimationFrame(frame);
    if (!lastTs) lastTs = ts;
    var dt = Math.min(50, ts - lastTs) / 1000;
    lastTs = ts;
    fpsStats.frames++;
    if (ts - fpsStats.last >= 1000) { fpsStats.fps = fpsStats.frames; fpsStats.frames = 0; fpsStats.last = ts; }
    if (!paused) {
      gardenT += dt;
      if (G.screen === 'garden') renderGardenScene(dt);
      tweenStep(dt * 1000);
      updateParticles(dt);
      updateFloaters(dt);
      updateRings(dt);
      if (shake.mag > 0) shake.mag = Math.max(0, shake.mag - dt * 24);
      if (G.phase === 'idle' && G.screen === 'game') {
        G.hintT -= dt;
        if (G.hintT <= -hintDelay() && !G.hintMove) refreshHint();
      }
    }
    render();
  }

  function refreshHint() {
    if (!G.grid) return;
    var gm = ghostNext();
    G.hintMove = gm || ME.findFirstMove(G.grid, G.portalPairs);
  }

  /* ================= SEASONAL EVENTS ================= */
  var EVENTS = [
    { id: 'bloom',  mod: 'bloom' },
    { id: 'frost',  mod: 'frost' },
    { id: 'honey',  mod: 'honey' }
  ];
  function currentEvent() {
    if (G.eventOverride) return G.eventOverride === 'none' ? null : G.eventOverride;
    return EVENTS[Math.floor(daysSinceEpoch() / 7) % EVENTS.length].id;
  }
  function applyEventMod(g, cfg, rng) {
    var ev = currentEvent();
    G.eventMod = ev;
    // keep the onboarding zone (1-10) and daily levels event-free
    if (!ev || cfg.n === 0 || (cfg.n > 0 && cfg.n <= 10)) return;
    if (ev !== 'bloom' && cfg.n <= 60) return; // frost/honey only from mid campaign
    var band = cfg.n <= 60 ? 1 : (cfg.n <= 140 ? 2 : 3);
    var k = 5 + band * 3;
    var guard = 0;
    while (k > 0 && guard < 300) {
      guard++;
      var r = Math.floor(rng() * SIZE), c = Math.floor(rng() * SIZE);
      var cell = g[r][c];
      if (!cell || cell.t !== T.GEM || cell.sp !== SP.NONE || cell.ice || cell.honey) continue;
      var nb2 = [[r - 1, c], [r + 1, c], [r, c - 1], [r, c + 1]];
      var clustered = false;
      for (var q = 0; q < 4; q++) {
        var nr = nb2[q][0], nc = nb2[q][1];
        if (ME.inb(nr, nc) && g[nr][nc] && (g[nr][nc].ice || g[nr][nc].honey)) { clustered = true; break; }
      }
      if (clustered) continue;
      if (ev === 'frost') cell.ice = 8; else cell.honey = 1; // ice = melt counter (moves)
      k--;
    }
  }

  /* ================= GARDEN GUESTS ================= */
  function guestSpawn() {
    if (save.guest) return;
    var rng = ME.makeRng((save.stats.total_levels * 2654435761) >>> 0);
    var chars = ['busya', 'buto', 'iskra', 'vorchun'];
    var ch = chars[Math.floor(rng() * chars.length)];
    var color = Math.floor(rng() * 6);
    var target = 15 + Math.floor(save.campaign_progress / 10) * 3;
    save.guest = { char: ch, color: color, target: target, progress: 0, done: false, claimed: false };
    persist();
    toast('👋 ' + t('guest_arrived', { name: t('char_' + ch) }));
  }
  function guestProgressAdd(color, n) {
    var g = save.guest;
    if (!g || g.done || g.claimed) return;
    if (color !== g.color) return;
    g.progress = Math.min(g.target, g.progress + n);
    if (g.progress >= g.target) { g.done = true; toast('💬 ' + t('guest_ready')); }
  }
  function guestClaim() {
    var g = save.guest;
    if (!g || !g.done || g.claimed) return;
    var reward = 120 + Math.floor(save.campaign_progress / 10) * 5;
    g.claimed = true;
    save.coins += reward; save.stats.coins_earned += reward;
    save.guest = null;
    persist(); Sound.coin();
    toast(t('guest_thx', { n: reward }));
    renderGarden();
  }

  /* ================= GAME LOGIC ================= */
  var levelRng = ME.makeRng(1);
  var moveMatchedRows = []; // rows where gems were matched during current move (for item sinking)
  G.curCascade = 0;
  G.cascadeCoins = false;

  /* ---------------- garden equipment meta ---------------- */
  function gardenObjs(g) { return window.Gardens.get(g).objs; }
  function equipLvlG(g, id) {
    var m = save.garden_equip && save.garden_equip[String(g)];
    return (m && m[id]) || 0;
  }
  function gardenComplete(g) {
    var objs = gardenObjs(g);
    for (var i = 0; i < objs.length; i++) if (equipLvlG(g, objs[i].id) < 2) return false;
    return true;
  }
  function bless(n) { return gardenComplete(n); }
  function bloomOf(g) {
    if (g === 0) return bloom0();
    var objs = gardenObjs(g), sum = 0;
    for (var i = 0; i < objs.length; i++) sum += equipLvlG(g, objs[i].id);
    return Math.round(sum / (objs.length * 2) * 100);
  }
  var EQUIP = [
    { id: 'water',      cost: [300, 600],    unlock: 1 },
    { id: 'hive',       cost: [500, 1000],   unlock: 10 },
    { id: 'greenhouse', cost: [400, 800],    unlock: 20 },
    { id: 'lantern',    cost: [350, 700],    unlock: 30 },
    { id: 'fountain',   cost: [800, 1500],   unlock: 40 },
    { id: 'scarecrow',  cost: [600, 1200],   unlock: 50 }
  ];
  function equipLvl(id) { return equipLvlG(0, id); }
  function boosterPrice(kind) {
    var base = kind === 'hammer' ? 100 : 50;
    var disc = (equipLvl('greenhouse') >= 2 ? 0.5 : (equipLvl('greenhouse') >= 1 ? 0.25 : 0)) + (bless(2) ? 0.1 : 0);
    disc = Math.min(0.6, disc);
    return Math.round(base * (1 - disc));
  }
  function hintDelay() { var v = equipLvl('lantern') >= 2 ? 1 : (equipLvl('lantern') >= 1 ? 2 : 4); return Math.max(1, v - (bless(3) ? 1 : 0)); }
  function levelBias() { return G.level && G.level.biasColor !== undefined ? { color: G.level.biasColor, weight: 2.2 } : null; }
  function countGems() {
    var n = 0;
    if (!G.grid) return 0;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.GEM) n++;
    }
    return n;
  }
  function countChoc() {
    var n = 0;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.CHOC) n++;
    }
    return n;
  }
  function countBlocks() {
    var n = 0;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.BLOCK) n++;
    }
    return n;
  }
  function daysSinceEpoch() { return Math.floor(Date.now() / 86400000); }
  function todayStr() { var d = new Date(); return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }

  function endlessCfg(depth) {
    var weekSeed = Math.floor(daysSinceEpoch() / 7);
    var rng = ME.makeRng((weekSeed * 1000 + depth * 37 + 11) >>> 0);
    var cfg = { n: 0, boss: false, seed: (weekSeed * 7919 + depth * 131 + 7) >>> 0 };
    cfg.colors = clamp(5 + Math.floor(depth / 4), 5, 8);
    cfg.moves = Math.max(12, 24 - Math.floor(depth / 2));
    var gt = ['score', 'collect', 'blocks', 'deliver'][Math.floor(rng() * 4)];
    cfg.goal = { type: gt };
    if (gt === 'score') cfg.goal.target = 1500 + depth * 350;
    if (gt === 'collect') { cfg.goal.color = Math.floor(rng() * cfg.colors); cfg.goal.target = 20 + depth * 2; cfg.biasColor = cfg.goal.color; }
    if (gt === 'blocks') { cfg.blocks = [[3, 3, 1], [3, 5, 1], [5, 3, 1], [5, 5, 1]].slice(0, 2 + (depth % 3)); cfg.goal.target = cfg.blocks.length; }
    if (gt === 'deliver') { cfg.items = [[2, 3, 1], [2, 5, 2]].slice(0, 1 + (depth % 2)); cfg.goal.target = cfg.items.length; }
    if (depth > 6 && rng() < 0.3) cfg.portals = [[[2, 1], [6, 7]]];
    if (depth > 10 && rng() < 0.25) { cfg.goal = { type: 'choc' }; cfg.choc = [[3, 3], [5, 5]]; }
    cfg.reward = 10 + depth * 2;
    return cfg;
  }
  function startEndless() {
    G.isEndless = true;
    G.endlessDepth = 0;
    G.endlessRunScore = 0;
    startLevel(0, { cfg: endlessCfg(0) });
  }
  function endlessUnlocked() { return save.campaign_progress > 200 || (save.best_run || 0) > 0; }
  function dailyCfg() {
    var cfg = LG.makeLevel(901 + (daysSinceEpoch() % 700));
    cfg.n = 0;
    cfg.reward = 30 + save.daily.streak * 5 + (bless(5) ? 15 : 0);
    cfg.noRefill = false;
    return cfg;
  }
  function dailyAvailable() { return save.daily.last_date !== todayStr(); }

  function startLevel(n, opts) {
    opts = opts || {};
    if (n > 200) n = 200;
    G.levelNum = n;
    G.isDaily = !!opts.daily;
    var cfg = opts.cfg ? opts.cfg : (opts.daily ? dailyCfg() : LG.makeLevel(n));
    G.level = cfg;
    G.grid = ME.createBoard({ colors: cfg.colors, blocks: cfg.blocks, items: cfg.items, rngSeed: cfg.seed, bias: cfg.biasColor !== undefined ? { color: cfg.biasColor, weight: 2.2 } : null });
    levelRng = ME.makeRng((cfg.seed ^ 0x9e3779b9) >>> 0);
    applyEventMod(G.grid, cfg, ME.makeRng((cfg.seed ^ 0x2545) >>> 0));
    G.moves = cfg.moves + equipLvl('water') + (bless(0) ? 1 : 0); G.movesUsed = 0; G.score = 0; G.collected = 0;
    G.scareLeft = equipLvl('scarecrow');
    G.blocksTotal = countBlocks(); G.blocksDone = 0;
    G.deliveredTotal = cfg.items ? cfg.items.length : 0; G.delivered = 0;
    G.maxCascade = 0; G.curCascade = 0; G.cascadeCoins = false;
    G.selected = null; G.hintMove = null; G.hintT = 0;
    G.phase = 'anim'; G.winShown = false; G.loseShown = false;
    G.boosterMode = null; G.rainbowPick = null;
    G.portalPairs = normPortals(cfg.portals);
    if (cfg.choc) {
      for (var ci = 0; ci < cfg.choc.length; ci++) {
        var cp = cfg.choc[ci];
        G.grid[cp[0]][cp[1]] = { t: T.CHOC, c: -1, sp: SP.NONE, hp: 1, it: 0, vx: cp[1], vy: cp[0], vs: 1, va: 1 };
      }
    }
    G.chocStart = Math.max(1, countChoc());
    G.runMoves = []; G.ghostIdx = 0;
    G.gemsAtStart = countGems();
    resolving = false;
    tweens.length = 0;
    dying.length = 0; particles.length = 0; floaters.length = 0; rings.length = 0;
    showScreen('game');
    layout();
    updateHud();
    // entry fall-in animation (staggered, tween-driven => pause-safe)
    var maxEnd = 0;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (!cell) continue;
      cell.vx = c;
      if (cell.t === T.BLOCK) { cell.vy = r; cell.vs = 1; cell.va = 1; continue; }
      var startVy = r - SIZE - (c % 3) * 0.6;
      var delay = c * 26 + r * 14;
      cell.vy = startVy - delay / 26;
      (function (cell2, from, to, dly) {
        maxEnd = Math.max(maxEnd, dly + 300);
        tween(dly + 300, function (p) {
          if (p * (dly + 300) < dly) return;
          var q = clamp((p * (dly + 300) - dly) / 300, 0, 1);
          cell2.vy = from + (to - from) * fallEase()(q);
        }, null, function (x) { return x; });
      })(cell, cell.vy, r, delay);
      cell.vs = 1; cell.va = 1;
    }
    if (G.startBombPending) {
      G.startBombPending = false;
      var mid = G.grid[4][4];
      if (mid && mid.t === T.GEM) { mid.sp = SP.BOMB; mid.vs = 0.3; tween(350, function (p) { mid.vs = 0.3 + 0.7 * easeOutBack(p); }); }
    }
    waitStep(maxEnd + 80, function () {
      G.phase = 'idle';
      refreshHintIfNeeded();
      if (save.stats.total_levels < 3 && !opts.tut) toast(t('hint_controls'));
      maybeShowStory(window.Story.preScene(n), null);
    });
    if (opts.tut) setupTutorial();
    else { G.tutActive = false; hideTutBanner(); }
    P.gameplayStart && P.gameplayStart();
    G.playSegmentStart = Date.now();
  }

  function refreshHintIfNeeded() { G.hintT = 0; G.hintMove = null; }

  /* ---------------- input ---------------- */
  var ptr = { down: false, sx: 0, sy: 0, cell: null, acted: false };

  function canvasPos(e) {
    var rect = canvas.getBoundingClientRect();
    return { x: (e.clientX - rect.left) * (boardPx / rect.width), y: (e.clientY - rect.top) * (boardPx / rect.height) };
  }
  function cellAtPos(x, y) {
    var c = Math.floor(x / cellPx), r = Math.floor(y / cellPx);
    if (r < 0 || r >= SIZE || c < 0 || c >= SIZE) return null;
    return [r, c];
  }
  function sameCell(a, b) { return a && b && a[0] === b[0] && a[1] === b[1]; }

  function onPointerDown(e) {
    Sound.init();
    if (paused || G.screen !== 'game') return;
    if (e.button !== undefined && e.button !== 0) return;
    var p = canvasPos(e);
    var cellRC = cellAtPos(p.x, p.y);
    ptr.down = true; ptr.sx = p.x; ptr.sy = p.y; ptr.cell = cellRC; ptr.acted = false;
    if (!cellRC) return;
    var cell = G.grid[cellRC[0]][cellRC[1]];
    if (G.boosterMode === 'hammer') {
      if (cell && cell.t === T.GEM) { ptr.acted = true; doHammer(cellRC[0], cellRC[1]); }
      return;
    }
    if (G.rainbowPick) return;
    if (G.phase !== 'idle') return;
    G.hintT = 0; G.hintMove = null;
    if (!cell || cell.t !== T.GEM) { G.selected = null; return; }
    if (G.selected && sameCell(G.selected, cellRC)) {
      // second tap on the same cell: activate special in place, else deselect
      if (cell.sp !== SP.NONE) { ptr.acted = true; G.selected = null; tapActivateSpecial(cellRC[0], cellRC[1]); }
      else G.selected = null;
      return;
    }
    if (G.selected && (ME.areAdjacent(G.selected, cellRC) || isPortalPair(G.selected, cellRC))) {
      ptr.acted = true;
      trySwap(G.selected, cellRC);
      G.selected = null;
      return;
    }
    G.selected = cellRC;
    Sound.click();
  }
  function onPointerMove(e) {
    if (!ptr.down || ptr.acted || paused || G.screen !== 'game') return;
    if (G.phase !== 'idle' || G.boosterMode === 'hammer' || G.rainbowPick) return;
    var p = canvasPos(e);
    var dx = p.x - ptr.sx, dy = p.y - ptr.sy;
    var dist = Math.sqrt(dx * dx + dy * dy);
    if (dist < Math.max(10, cellPx * 0.32)) return;
    if (!ptr.cell) return;
    var dr = 0, dc = 0;
    if (Math.abs(dx) > Math.abs(dy)) dc = dx > 0 ? 1 : -1; else dr = dy > 0 ? 1 : -1;
    var a = ptr.cell, b = [a[0] + dr, a[1] + dc];
    if (!ME.inb(b[0], b[1])) return;
    var cb = G.grid[b[0]][b[1]];
    if (!cb || cb.t !== T.GEM) return;
    ptr.acted = true;
    G.selected = null;
    trySwap(a, b);
  }
  function onPointerUp() { ptr.down = false; }

  /* ---------------- swap ---------------- */
  function normPortals(P) {
    if (!P || !P.length) return [];
    if (typeof P[0][0] === 'number') P = [P]; // single pair shorthand
    return P.map(function (p) { return [[p[0][0], p[0][1]], [p[1][0], p[1][1]]]; });
  }
  function isPortalPair(a, b) {
    for (var i = 0; i < G.portalPairs.length; i++) {
      var p = G.portalPairs[i];
      if ((sameCell(a, p[0]) && sameCell(b, p[1])) || (sameCell(a, p[1]) && sameCell(b, p[0]))) return true;
    }
    return false;
  }
  function trySwap(a, b) {
    if (G.phase !== 'idle') return false;
    if (!ME.areAdjacent(a, b) && !isPortalPair(a, b)) return false;
    G.runMoves.push([a.slice(), b.slice()]);
    var ca = G.grid[a[0]][a[1]], cb = G.grid[b[0]][b[1]];
    if (!ME.isSwappable(ca) || !ME.isSwappable(cb)) return false;
    if (G.tutActive && G.tutStep === 1 && G.tutMove) {
      var okPair = (sameCell(a, G.tutMove[0]) && sameCell(b, G.tutMove[1])) ||
                   (sameCell(a, G.tutMove[1]) && sameCell(b, G.tutMove[0]));
      if (!okPair) { Sound.invalid(); return false; }
    }
    G.phase = 'anim';
    G.selected = null; G.hintMove = null; G.hintT = 0;
    Sound.swap();
    ME.swapInGrid(G.grid, a, b);
    ca.vx = a[1]; ca.vy = a[0];
    cb.vx = b[1]; cb.vy = b[0];
    tween(200, function (p) {
      ca.vx = a[1] + (b[1] - a[1]) * p; ca.vy = a[0] + (b[0] - a[0]) * p;
      cb.vx = b[1] + (a[1] - b[1]) * p; cb.vy = b[0] + (a[0] - b[0]) * p;
    }, function () {
      ca.vx = b[1]; ca.vy = b[0]; cb.vx = a[1]; cb.vy = a[0];
      afterSwap(a, b, ca, cb);
    }, easeOutQuad);
    return true;
  }

  function afterSwap(a, b, ca, cb) {
    // after grid swap: ca sits at b, cb sits at a
    if (ca.sp !== SP.NONE || cb.sp !== SP.NONE) { doSpecialSwap(a, b, ca, cb); return; }
    if (ME.hasMatch(G.grid)) {
      spendMove();
      resolveBoard(b, null);
    } else {
      Sound.invalid();
      vibe(8);
      ME.swapInGrid(G.grid, a, b);
      var pa = cellCenter(a[0], a[1]), pb = cellCenter(b[0], b[1]);
      ring(pa.x, pa.y, '#ff6b5a', cellPx * 0.9);
      ring(pb.x, pb.y, '#ff6b5a', cellPx * 0.9);
      doShake(1.5);
      floater((pa.x + pb.x) / 2, (pa.y + pb.y) / 2 - cellPx * 0.55, t('msg_need3'), '#ffb3a6', 15);
      // wiggle then swap back: the refusal must be visible
      tween(120, function (p) {
        var w = Math.sin(p * Math.PI * 3) * 0.12;
        ca.vx = b[1] + w; cb.vx = a[1] - w;
        ca.vy = b[0]; cb.vy = a[0];
      }, function () {
        tween(200, function (p) {
          ca.vx = b[1] + (a[1] - b[1]) * p; ca.vy = b[0] + (a[0] - b[0]) * p;
          cb.vx = a[1] + (b[1] - a[1]) * p; cb.vy = a[0] + (b[0] - a[0]) * p;
        }, function () {
          ca.vx = a[1]; ca.vy = a[0]; cb.vx = b[1]; cb.vy = b[0];
          G.phase = 'idle';
          G.hintT = -3; // show a valid pair sooner after a refused swap
          G.hintMove = null;
        }, easeOutQuad);
      }, function (x) { return x; });
    }
  }

  function spendMove() {
    G.moves--; G.movesUsed++;
    meltTick();
    if (G.movesUsed % 2 === 0) chocSpread(); // chocolate creeps every 2nd move
    updateHud();
  }
  function meltTick() {
    if (G.eventMod !== 'frost') return;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.GEM && cell.ice) {
        cell.ice--;
        if (cell.ice <= 0) {
          cell.ice = 0;
          var p = cellCenter(r, c);
          burst(p.x, p.y, '#cfe8ff', 6, 100);
          Sound.tone({ f0: 800, f1: 1300, dur: 0.1, type: 'sine', vol: 0.08 });
        }
      }
    }
  }

  function doSpecialSwap(a, b, ca, cb) {
    spendMove();
    var set = {};
    function addCells(list) {
      for (var i = 0; i < list.length; i++) {
        var rc = list[i];
        if (!ME.inb(rc[0], rc[1])) continue;
        var cell = G.grid[rc[0]][rc[1]];
        if (!cell || cell.t !== T.GEM) continue;
        set[ME.key(rc[0], rc[1])] = rc;
      }
    }
    var kind = 'bomb';
    if (ca.sp === SP.RAINBOW && cb.sp === SP.RAINBOW) {
      for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
        var cl = G.grid[r][c];
        if (cl && cl.t === T.GEM) set[ME.key(r, c)] = [r, c];
      }
      kind = 'rainbow';
    } else if (ca.sp === SP.RAINBOW || cb.sp === SP.RAINBOW) {
      var rbPos = (ca.sp === SP.RAINBOW) ? b : a;
      var other = (ca.sp === SP.RAINBOW) ? cb : ca;
      var otherPos = (ca.sp === SP.RAINBOW) ? a : b;
      var color = other.c >= 0 ? other.c : ME.mostCommonColor(G.grid);
      addCells(ME.specialBlastCells(G.grid, rbPos[0], rbPos[1], SP.RAINBOW, color));
      addCells([otherPos]);
      kind = 'rainbow';
    } else {
      if (ca.sp !== SP.NONE) {
        addCells(ME.specialBlastCells(G.grid, b[0], b[1], ca.sp, cb.c >= 0 ? cb.c : undefined));
        registerSpecialTrigger(ca.sp);
        if (ca.sp === SP.BOMB) damageBlocksAround(b[0], b[1]);
      }
      if (cb.sp !== SP.NONE) {
        addCells(ME.specialBlastCells(G.grid, a[0], a[1], cb.sp, ca.c >= 0 ? ca.c : undefined));
        registerSpecialTrigger(cb.sp);
        if (cb.sp === SP.BOMB) damageBlocksAround(a[0], a[1]);
      }
      kind = (ca.sp === SP.LIGHTNING || cb.sp === SP.LIGHTNING) ? 'lightning' : 'bomb';
    }
    Sound.special(kind);
    doShake(5);
    var list = [];
    for (var k in set) list.push(set[k]);
    resolveBoard(null, { initialBlast: list });
  }

  function registerSpecialTrigger(sp) {
    if (sp === SP.BOMB) save.stats.bombs++;
    else if (sp === SP.LIGHTNING) save.stats.lightnings++;
    else if (sp === SP.RAINBOW) save.stats.rainbows++;
  }

  function tapActivateSpecial(r, c) {
    if (G.phase !== 'idle') return;
    var cell = G.grid[r][c];
    if (!cell || cell.t !== T.GEM || cell.sp === SP.NONE) return;
    if (cell.sp === SP.RAINBOW) {
      openRainbowPicker(r, c);
      return;
    }
    spendMove();
    registerSpecialTrigger(cell.sp);
    Sound.special(cell.sp === SP.BOMB ? 'bomb' : 'lightning');
    var color = cell.c >= 0 ? cell.c : undefined;
    var blast = ME.specialBlastCells(G.grid, r, c, cell.sp, color);
    if (cell.sp === SP.BOMB) damageBlocksAround(r, c);
    doShake(5);
    resolveBoard(null, { initialBlast: blast.concat([[r, c]]) });
  }

  function openRainbowPicker(r, c) {
    G.rainbowPick = { r: r, c: c };
    showRainbowPicker(function (color) {
      G.rainbowPick = null;
      spendMove();
      registerSpecialTrigger(SP.RAINBOW);
      Sound.special('rainbow');
      var blast = ME.specialBlastCells(G.grid, r, c, SP.RAINBOW, color);
      doShake(5);
      resolveBoard(null, { initialBlast: blast.concat([[r, c]]) });
    }, function () { G.rainbowPick = null; });
  }

  function thawAround(r, c) {
    var nb = [[r - 1, c], [r + 1, c], [r, c - 1], [r, c + 1]];
    for (var i = 0; i < nb.length; i++) {
      var rr = nb[i][0], cc = nb[i][1];
      if (!ME.inb(rr, cc)) continue;
      var cell = G.grid[rr][cc];
      if (cell && cell.t === T.GEM && cell.ice) {
        cell.ice = 0;
        var p = cellCenter(rr, cc);
        burst(p.x, p.y, '#cfe8ff', 8, 120);
        ring(p.x, p.y, '#bfe4ff', cellPx * 0.9);
        Sound.tone({ f0: 900, f1: 1400, dur: 0.12, type: 'sine', vol: 0.12 });
      }
      if (cell && cell.t === T.GEM && cell.honey) {
        cell.honey = 0;
        var p2 = cellCenter(rr, cc);
        burst(p2.x, p2.y, '#f0b23c', 6, 100);
      }
    }
  }
  function damageBlocksAround(r, c) {
    var nb = [[r - 1, c], [r + 1, c], [r, c - 1], [r, c + 1]];
    for (var i = 0; i < nb.length; i++) {
      var rr = nb[i][0], cc = nb[i][1];
      if (!ME.inb(rr, cc)) continue;
      var cell = G.grid[rr][cc];
      if (cell && cell.t === T.BLOCK) damageBlock(rr, cc);
      else if (cell && cell.t === T.CHOC) killChoc(rr, cc);
    }
  }
  function killChoc(r, c) {
    var cell = G.grid[r][c];
    if (!cell || cell.t !== T.CHOC) return;
    var p = cellCenter(r, c);
    burst(p.x, p.y, '#7a4a20', 10, 130);
    ring(p.x, p.y, '#c98a4a', cellPx);
    G.grid[r][c] = null;
    Sound.tone({ f0: 260, f1: 110, dur: 0.2, type: 'square', vol: 0.16 });
    updateHud();
  }
  function chocSpread() {
    var n = countChoc();
    if (n === 0 || n >= 10) return;
    var srcs = [];
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) if (G.grid[r][c] && G.grid[r][c].t === T.CHOC) srcs.push([r, c]);
    if (!srcs.length) return;
    var src = srcs[Math.floor(levelRng() * srcs.length)];
    var nb = [[src[0] - 1, src[1]], [src[0] + 1, src[1]], [src[0], src[1] - 1], [src[0], src[1] + 1]];
    var opts = [];
    for (var i = 0; i < nb.length; i++) {
      var rr = nb[i][0], cc = nb[i][1];
      if (ME.inb(rr, cc) && G.grid[rr][cc] && G.grid[rr][cc].t === T.GEM && !G.grid[rr][cc].sp) opts.push([rr, cc]);
    }
    if (!opts.length) return;
    var dst = opts[Math.floor(levelRng() * opts.length)];
    G.grid[dst[0]][dst[1]] = { t: T.CHOC, c: -1, sp: SP.NONE, hp: 1, it: 0, vx: dst[1], vy: dst[0], vs: 0.3, va: 1 };
    (function (cl) { tween(300, function (p) { cl.vs = 0.3 + 0.7 * easeOutBack(p); }, function () { cl.vs = 1; }); })(G.grid[dst[0]][dst[1]]);
    G.chocStart = Math.max(G.chocStart, countChoc());
    updateHud();
  }
  function damageBlock(r, c) {
    var cell = G.grid[r][c];
    if (!cell || cell.t !== T.BLOCK) return;
    cell.hp--;
    cell.flash = 0.7;
    if (cell.hp <= 0) {
      var p = cellCenter(r, c);
      burst(p.x, p.y, '#9a7b4f', 10, 140);
      ring(p.x, p.y, '#d9b98a', cellPx);
      G.grid[r][c] = null;
      G.blocksDone++;
      Sound.tone({ f0: 220, f1: 90, dur: 0.25, type: 'square', vol: 0.2 });
      updateHud();
    } else {
      Sound.tone({ f0: 300, f1: 240, dur: 0.1, type: 'square', vol: 0.1 });
    }
  }

  /* ---------------- resolve pipeline ---------------- */
  var resolving = false;

  function resolveBoard(pivot, opts) {
    if (resolving) return;
    resolving = true;
    G.phase = 'anim';
    var cascade = 0;
    var initial = opts && opts.initialBlast ? opts.initialBlast.slice() : null;
    var pivotCell = pivot;
    moveMatchedRows = [];

    function step() {
      var list;
      if (initial) {
        list = initial; initial = null;
        cascade = Math.max(cascade, 1);
        if (!list.length) { finish(); return; }
      } else {
        var analysis = ME.analyzeMatches(G.grid, cascade === 0 ? pivotCell : null);
        if (!analysis.removeList.length && !analysis.spawns.length) { finish(); return; }
        cascade++;
        if (cascade > G.maxCascade) G.maxCascade = cascade;

        // spawns first (transform cells into specials)
        var spawnList = analysis.spawns;
        for (var s = 0; s < spawnList.length; s++) {
          var sp = spawnList[s];
          var cell = G.grid[sp.r][sp.c];
          if (!cell) continue;
          cell.sp = sp.sp;
          if (sp.sp !== SP.RAINBOW && sp.color >= 0) cell.c = sp.color;
          if (sp.sp === SP.RAINBOW) cell.c = -1;
          cell.vs = 0.2; cell.flash = 1;
          save.stats.total_specials++;
          Sound.spawn();
          (function (cl) {
            tween(320, function (p) { cl.vs = 0.2 + 0.8 * easeOutBack(p); }, function () { cl.vs = 1; }, easeOutQuad);
          })(cell);
          var cp = cellCenter(sp.r, sp.c);
          burst(cp.x, cp.y, '#ffffff', 10, 150);
          ring(cp.x, cp.y, '#ffffff', cellPx * 1.6);
          floater(cp.x, cp.y - cellPx * 0.4, sp.sp === SP.BOMB ? '💣' : (sp.sp === SP.LIGHTNING ? '⚡' : '🌈'), '#fff', 20);
        }

        if (cascade > 1) {
          save.stats.cascade_events++;
          Sound.cascade(cascade);
          doShake(Math.min(6, 1.5 + cascade));
          var mid = cellCenter(4, 4);
          floater(mid.x, mid.y, t('msg_cascade', { n: cascade }), '#ffe27a', 20 + cascade);
        } else Sound.match(1);

        // protect freshly spawned specials from being removed in the same step
        list = [];
        for (var f = 0; f < analysis.removeList.length; f++) {
          var rk = ME.key(analysis.removeList[f][0], analysis.removeList[f][1]);
          if (analysis.spawnKeys[rk]) continue;
          list.push(analysis.removeList[f]);
        }
        save.stats.total_matches += (analysis.runCount || 1);
      }
      list = expandChains(list);
      if (!list.length) { afterGravity(); return; }
      removeCells(list, Math.max(1, cascade), afterGravity);
    }

    function afterGravity() {
      var moves = ME.applyGravity(G.grid);
      var maxDist = 1;
      for (var i = 0; i < moves.length; i++) maxDist = Math.max(maxDist, moves[i].r - moves[i].fromR);
      for (var m = 0; m < moves.length; m++) {
        (function (mv) {
          var cell = mv.cell;
          var from = mv.fromR, to = mv.r;
          cell.vy = from;
          var dur = 180 + (to - from) * 42;
          tween(dur, function (p) { cell.vy = from + (to - from) * p; }, function () { cell.vy = to; }, fallEase());
        })(moves[m]);
      }
      var fallDur = 180 + maxDist * 42 + 40;
      waitStep(fallDur, function () { checkDeliveredThenRefill(); });
    }

    function checkDeliveredThenRefill() {
      // items that reached the bottom row are delivered
      var gotAny = deliverBottomItems();
      updateHud();
      if (gotAny) {
        var mv2 = ME.applyGravity(G.grid);
        for (var i = 0; i < mv2.length; i++) {
          (function (mv) {
            var cell = mv.cell, from = mv.fromR, to = mv.r;
            cell.vy = from;
            tween(180 + (to - from) * 42, function (p) { cell.vy = from + (to - from) * p; }, function () { cell.vy = to; }, fallEase());
          })(mv2[i]);
        }
        waitStep(300, checkDeliveredThenRefill);
        return;
      }
      var spawns = ME.refill(G.grid, G.level.colors, levelRng, !G.level.noRefill, levelBias());
      for (var s = 0; s < spawns.length; s++) {
        (function (sp) {
          var cell = sp.cell, from = sp.fromR, to = sp.r;
          cell.vy = from;
          tween(200 + (to - from) * 40, function (p) { cell.vy = from + (to - from) * p; }, function () { cell.vy = to; }, fallEase());
        })(spawns[s]);
      }
      var refDur = spawns.length ? 300 : 20;
      waitStep(refDur, function () {
        var fThr = equipLvl('fountain') >= 1 ? 4 : 5;
        var fAmt = 20 + (equipLvl('fountain') >= 2 ? 15 : 0) + (bless(4) ? 10 : 0);
        if (G.maxCascade >= fThr && !G.cascadeCoins) {
          G.cascadeCoins = true;
          addCoins(fAmt);
          floater(boardPx / 2, boardPx * 0.2, '+' + fAmt + ' 🪙', '#ffd76a', 20);
        }
        if (cascade >= ME.MAX_CASCADES) { settleBoardSilently(); finish(); return; }
        step();
      });
    }

    function finish() {
      resolving = false;
      if (G.screen !== 'game') return; // level was abandoned mid-resolve
      G.curCascade = cascade;
      if (G.deliveredTotal > 0 && sinkItems()) {
        resolving = true;
        waitStep(260, function () {
          deliverBottomItems();
          updateHud();
          afterGravity();
        });
        return;
      }
      if (countGems() > 0) {
        var res = ensureMovesAvailable();
        if (res === 'shuffled') {
          popAllGems();
          waitStep(340, function () {
            G.phase = 'idle';
            if (!ME.hasAvailableMoves(G.grid, G.portalPairs) && countGems() > 0) { rainbowSweep(); return; }
            afterMoveChecks();
          });
          return;
        }
        if (res === 'deadlock') { rainbowSweep(); return; }
      }
      G.phase = 'idle';
      afterMoveChecks();
    }
    step();
  }

  function popAllGems() {
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.GEM) {
        cell.vx = c; cell.vy = r; cell.vs = 0.4; cell.va = 0.4;
        (function (cl) { tween(300, function (p) { cl.vs = 0.4 + 0.6 * p; cl.va = 0.4 + 0.6 * p; }, function () { cl.vs = 1; cl.va = 1; }); })(cell);
      }
    }
  }
  function rainbowSweep() {
    var all = [];
    for (var rr = 0; rr < SIZE; rr++) for (var cc2 = 0; cc2 < SIZE; cc2++) {
      var cl2 = G.grid[rr][cc2];
      if (cl2 && cl2.t === T.GEM) all.push([rr, cc2]);
    }
    if (!all.length) { G.phase = 'idle'; afterMoveChecks(); return; }
    Sound.special('rainbow');
    doShake(6);
    resolveBoard(null, { initialBlast: all });
  }
  function meltAll() {
    var any = false;
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.GEM && (cell.ice || cell.honey)) { cell.ice = 0; cell.honey = 0; any = true; }
    }
    return any;
  }
  // returns 'ok' | 'shuffled' | 'deadlock' | 'empty'
  function ensureMovesAvailable() {
    if (countGems() === 0) return 'empty';
    if (ME.hasAvailableMoves(G.grid, G.portalPairs)) return 'ok';
    toast(t('msg_no_moves'));
    Sound.shuffle();
    ME.shuffleGrid(G.grid, levelRng);
    if (!ME.hasAvailableMoves(G.grid)) {
      if (meltAll()) return 'shuffled'; // event soft-lock guard: thaw/wash everything
      return 'deadlock';
    }
    return 'shuffled';
  }

  // expand a removal list by chain-activating any special gems inside it
  function expandChains(list) {
    var seen = {};
    var out = [];
    var queue = [];
    for (var i = 0; i < list.length; i++) {
      var rc = list[i];
      if (!ME.inb(rc[0], rc[1])) continue;
      var k = ME.key(rc[0], rc[1]);
      if (seen[k]) continue;
      seen[k] = 1; out.push(rc); queue.push(rc);
    }
    while (queue.length) {
      var cur = queue.shift();
      var cell = G.grid[cur[0]][cur[1]];
      if (!cell || cell.t !== T.GEM || cell.sp === SP.NONE) continue;
      registerSpecialTrigger(cell.sp);
      Sound.special(cell.sp === SP.BOMB ? 'bomb' : (cell.sp === SP.LIGHTNING ? 'lightning' : 'rainbow'));
      doShake(cell.sp === SP.BOMB ? 5 : 3);
      var target = cell.sp === SP.BOMB ? undefined : (cell.c >= 0 ? cell.c : ME.mostCommonColor(G.grid));
      var blast = ME.specialBlastCells(G.grid, cur[0], cur[1], cell.sp, target);
      if (cell.sp === SP.BOMB) damageBlocksAround(cur[0], cur[1]);
      for (var b = 0; b < blast.length; b++) {
        var br = blast[b];
        var bk = ME.key(br[0], br[1]);
        if (seen[bk]) continue;
        var bc = G.grid[br[0]][br[1]];
        if (!bc || bc.t !== T.GEM) continue;
        seen[bk] = 1; out.push(br); queue.push(br);
      }
    }
    return out;
  }

  function settleBoardSilently() {
    var guard = 0;
    while (ME.hasMatch(G.grid) && guard < 60) {
      var an = ME.analyzeMatches(G.grid, null);
      for (var i = 0; i < an.removeList.length; i++) G.grid[an.removeList[i][0]][an.removeList[i][1]] = null;
      for (var s = 0; s < an.spawns.length; s++) {
        var sp = an.spawns[s];
        var cell = G.grid[sp.r][sp.c];
        if (cell) { cell.sp = sp.sp; }
      }
      ME.applyGravity(G.grid);
      ME.refill(G.grid, G.level.colors, levelRng, !G.level.noRefill, levelBias());
      guard++;
    }
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cl = G.grid[r][c];
      if (cl) { cl.vx = c; cl.vy = r; cl.vs = 1; cl.va = 1; }
    }
  }

  function killDying(d) { var i = dying.indexOf(d); if (i >= 0) dying.splice(i, 1); }

  function deliverBottomItems() {
    var gotAny = false;
    for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[SIZE - 1][c];
      if (cell && cell.t === T.ITEM) {
        gotAny = true;
        G.delivered++;
        save.stats.delivered_total++;
        var p = cellCenter(SIZE - 1, c);
        burst(p.x, p.y, '#ffd76a', 14, 170);
        ring(p.x, p.y, '#7CFC00', cellPx * 1.3);
        floater(p.x, p.y - 10, '✓', '#7CFC00', 24);
        Sound.coin();
        G.grid[SIZE - 1][c] = null;
        dying.push({ x: p.x, y: p.y, img: 'item_0' + (cell.it || 1), alpha: 1, scale: 1 });
        (function (d) {
          tween(380, function (p2) { d.alpha = 1 - p2; d.y -= 1.4; d.scale = 1 + p2 * 0.5; }, function () { killDying(d); }, easeOutQuad);
        })(dying[dying.length - 1]);
      }
    }
    return gotAny;
  }

  // Items sink one row for each match formed anywhere below their row:
  // without this, the rows under an item freeze and deliver goals stall.
  function sinkItems() {
    if (!moveMatchedRows.length) return false;
    var items = [];
    for (var r = 0; r < SIZE; r++) {
      for (var c = 0; c < SIZE; c++) {
        if (G.grid[r][c] && G.grid[r][c].t === T.ITEM) items.push([r, c]);
      }
    }
    if (!items.length) return false;
    items.sort(function (a, b) { return b[0] - a[0]; });
    var movedAny = false;
    for (var i = 0; i < items.length; i++) {
      var ir = items[i][0], ic = items[i][1];
      var below = false;
      for (var m = 0; m < moveMatchedRows.length; m++) {
        if (moveMatchedRows[m] > ir) { below = true; break; }
      }
      if (!below) continue;
      var tr = ir + 1;
      if (tr >= SIZE) continue;
      var target = G.grid[tr][ic];
      if (!target || target.t !== T.GEM) continue;
      var itemCell = G.grid[ir][ic];
      G.grid[tr][ic] = itemCell;
      G.grid[ir][ic] = target;
      itemCell.vy = ir; target.vy = tr;
      (function (a, b, ar, br) {
        tween(220, function (p) { a.vy = ar + (br - ar) * p; b.vy = br + (ar - br) * p; }, function () { a.vy = br; b.vy = ar; }, easeOutQuad);
      })(itemCell, target, ir, tr);
      movedAny = true;
    }
    return movedAny;
  }

  function removeCells(list, mult, done) {
    var pts = 0, n = 0;
    var cx = 0, cy = 0;
    var goal = G.level.goal;
    for (var i = 0; i < list.length; i++) {
      var r = list[i][0], c = list[i][1];
      var cell = G.grid[r][c];
      if (!cell || cell.t !== T.GEM) continue;
      var p = cellCenter(r, c);
      var imgName = gemImageName(cell);
      pts += Math.round(20 * Math.max(1, mult) * (G.eventMod === 'bloom' ? 1.25 : 1));
      n++;
      cx += p.x; cy += p.y;
      if (goal.type === 'collect' && cell.c === goal.color && cell.t === T.GEM) G.collected++;
      guestProgressAdd(cell.c, 1);
      burst(p.x, p.y, GEM_COLORS[cell.c] || '#fff', 6, 130);
      ring(p.x, p.y, GEM_COLORS[cell.c] || '#fff', cellPx * 1.1);
      dying.push({ x: p.x, y: p.y, img: imgName, alpha: 1, scale: 1 });
      (function (d) {
        tween(260, function (q) { d.alpha = 1 - q; d.scale = 1 + q * 0.7; }, function () { killDying(d); }, easeOutQuad);
      })(dying[dying.length - 1]);
      G.grid[r][c] = null;
      moveMatchedRows.push(r);
      damageBlocksAround(r, c);
      thawAround(r, c);
    }
    if (n > 0) {
      vibe(12);
      save.stats.gems_removed += n;
      G.score += pts;
      floater(cx / n, cy / n - 8, '+' + pts, '#ffffff', 16 + Math.min(10, n));
      updateHud();
    }
    waitStep(240, done);
  }

  function vibe(p) {
    try { if (save.settings.vibro !== false && navigator.vibrate) navigator.vibrate(p); } catch (e) { /* noop */ }
  }
  function addCoins(v) { save.coins += v; save.stats.coins_earned += v; Sound.coin(); updateCoinsUi(); persist(); }

  function afterMoveChecks() {
    G.ghostIdx++;
    checkAchievements();
    if (G.tutActive) { tutAfterMove(); return; }
    if (isGoalComplete()) { winLevel(); return; }
    if (G.moves <= 0) { loseLevel(); return; }
    refreshHintIfNeeded();
    persist();
  }

  function isGoalComplete() {
    var goal = G.level.goal;
    switch (goal.type) {
      case 'score': return G.score >= goal.target;
      case 'collect': return G.collected >= goal.target;
      case 'blocks': return G.blocksDone >= G.blocksTotal && G.blocksTotal > 0;
      case 'deliver': return G.delivered >= G.deliveredTotal && G.deliveredTotal > 0;
      case 'choc': return countChoc() === 0;
      case 'clear': return countGems() === 0;
    }
    return false;
  }
  function goalProgress() {
    var goal = G.level.goal;
    switch (goal.type) {
      case 'score': return clamp(G.score / goal.target, 0, 1);
      case 'collect': return clamp(G.collected / goal.target, 0, 1);
      case 'blocks': return G.blocksTotal ? clamp(G.blocksDone / G.blocksTotal, 0, 1) : 1;
      case 'deliver': return G.deliveredTotal ? clamp(G.delivered / G.deliveredTotal, 0, 1) : 1;
      case 'choc': return clamp(1 - countChoc() / G.chocStart, 0, 1);
      case 'clear': return G.gemsAtStart ? clamp(1 - countGems() / G.gemsAtStart, 0, 1) : 1;
    }
    return 0;
  }
  function goalText() {
    var goal = G.level.goal;
    switch (goal.type) {
      case 'score': return t('goal_score', { a: goal.target });
      case 'collect': return t('goal_collect', { color: t('color_' + goal.color), a: G.collected, b: goal.target });
      case 'blocks': return t('goal_blocks', { a: G.blocksDone, b: G.blocksTotal });
      case 'deliver': return t('goal_deliver', { a: G.delivered, b: G.deliveredTotal });
      case 'choc': return t('goal_choc', { a: countChoc() });
      case 'clear': return t('goal_clear');
    }
    return '';
  }

  /* ---------------- pre-level briefing ---------------- */
  function requestLevel(n, opts) {
    opts = opts || {};
    if (!save.tutorial_done && n === 1 && !opts.daily) { startLevel(1, { tut: true }); return; }
    showPreLevel(n, opts);
  }
  function showPreLevel(n, opts) {
    var cfg = opts.daily ? dailyCfg() : LG.makeLevel(n);
    G.level = cfg; G.levelNum = n; G.isDaily = !!opts.daily;
    G.collected = 0; G.blocksTotal = 0; G.blocksDone = 0; G.delivered = 0;
    G.deliveredTotal = cfg.items ? cfg.items.length : 0;
    G.gemsAtStart = 81; G.score = 0; G.moves = cfg.moves;
    var box = panelBox(opts.daily ? t('pre_daily') : (t('hud_level', { n: n }) + (cfg.boss ? ' — ' + t('level_boss') : '')));
    var row = el('div', 'prerows');
    row.innerHTML =
      '<div class="prerow"><img class="goalic" src="img/' + preIcon(cfg) + '.png" alt=""><span>' + goalText() + '</span></div>' +
      '<div class="prerow"><span class="prek">' + t('pre_moves') + ':</span><b>' + cfg.moves + '</b></div>' +
      '<div class="prerow"><span class="prek">' + t('pre_reward') + ':</span><b><img class="coinmini" src="img/coin.png" alt=""> ' + cfg.reward + '</b></div>';
    box.panel.appendChild(row);
    box.panel.appendChild(btn(t('pre_start'), 'green big', function () {
      closeOverlay();
      startLevel(n, opts);
    }));
    box.panel.appendChild(btn(t('pre_bomb') + ' 🎬', 'gold', function () {
      showRewarded(function () {
        G.startBombPending = true;
        closeOverlay();
        startLevel(n, opts);
      });
    }));
    box.panel.appendChild(btn(t('pre_back'), '', function () { closeOverlay(); showScreen(opts.from || 'menu'); }));
    openOverlay(box.ov);
  }
  function preIcon(cfg) {
    var g = cfg.goal;
    if (g.type === 'collect') return GEM_KEYS[g.color] || GEM_KEYS[0];
    if (g.type === 'blocks') return 'block_wood';
    if (g.type === 'deliver') return 'item_01';
    if (g.type === 'score') return 'coin';
    if (g.type === 'choc') return 'block_wood';
    return 'special_rainbow';
  }

  /* ---------------- daily quests ---------------- */
  var QUEST_DEFS = [
    { id: 'casc', stat: 'cascade_events', targets: [3, 5, 8], reward: 80 },
    { id: 'spec', stat: 'total_specials', targets: [5, 8, 12], reward: 80 },
    { id: 'win', stat: 'total_levels', targets: [2, 3, 5], reward: 100 },
    { id: 'gems', stat: 'gems_removed', targets: [150, 250, 400], reward: 70 },
    { id: 'bomb', stat: 'bombs', targets: [2, 3, 5], reward: 80 },
    { id: 'deliv', stat: 'delivered_total', targets: [2, 4, 6], reward: 90 }
  ];
  function ensureQuests() {
    if (!save.daily_quests || save.daily_quests.date !== todayStr()) {
      var rng = ME.makeRng(daysSinceEpoch() ^ 0x51ed);
      var pool = QUEST_DEFS.slice();
      var list = [];
      for (var i = 0; i < 3 && pool.length; i++) {
        var idx = Math.floor(rng() * pool.length);
        var d = pool.splice(idx, 1)[0];
        var tg = d.targets[rng() < 0.55 ? 0 : 1];
        list.push({ id: d.id, stat: d.stat, base: save.stats[d.stat] || 0, target: tg, reward: d.reward, claimed: false });
      }
      save.daily_quests = { date: todayStr(), list: list };
      persist();
    }
    return save.daily_quests;
  }
  function questProgress(q) { return clamp((save.stats[q.stat] || 0) - q.base, 0, q.target); }
  function questsClaimable() {
    var dq = ensureQuests(), n = 0;
    for (var i = 0; i < dq.list.length; i++) if (!dq.list[i].claimed && questProgress(dq.list[i]) >= dq.list[i].target) n++;
    return n;
  }
  function renderQuests() {
    var sEl = $('#screen-quests');
    sEl.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('menu'); }));
    head.appendChild(el('div', 'pageheadtitle', t('quests_title')));
    head.appendChild(el('div', 'chip', '<img class="coinmini" src="img/coin.png" alt=""> ' + save.coins));
    sEl.appendChild(head);
    var dq = ensureQuests();
    var body = el('div', 'achbody');
    dq.list.forEach(function (q) {
      var prog = questProgress(q);
      var row = el('div', 'achrow');
      row.innerHTML = '<div class="achmedal">📜</div><div class="achtext"><b>' + t('q_' + q.id + '_n', { a: prog, b: q.target }) + '</b>' +
        '<div class="progressbar" style="margin-top:5px"><div style="width:' + Math.round(prog / q.target * 100) + '%"></div></div></div>';
      if (q.claimed) row.appendChild(el('div', 'chip small green', t('quest_done')));
      else if (prog >= q.target) row.appendChild(btn(t('quest_claim') + ' +' + q.reward, 'small gold', function () {
        q.claimed = true;
        save.coins += q.reward; save.stats.coins_earned += q.reward;
        persist(); Sound.coin(); renderQuests();
      }));
      else row.appendChild(el('div', 'chip small', '+' + q.reward + ' 🪙'));
      body.appendChild(row);
    });
    body.appendChild(el('div', 'sub', t('quest_wait')));
    sEl.appendChild(body);
  }

  /* ---------------- 4h chest ---------------- */
  var CHEST_MS = 4 * 3600 * 1000;
  function chestReady() { return Date.now() - (save.last_chest || 0) >= CHEST_MS; }
  function chestRemain() { return Math.max(0, CHEST_MS - (Date.now() - (save.last_chest || 0))); }
  function openChest() {
    if (!chestReady()) {
      var ms = chestRemain();
      toast(t('chest_wait', { h: Math.floor(ms / 3600000), m: Math.floor(ms % 3600000 / 60000) }));
      return;
    }
    var amount = 60 + ((daysSinceEpoch() * 7) % 4) * 20 + (save.daily.streak || 0) * 2;
    save.last_chest = Date.now();
    save.coins += amount; save.stats.coins_earned += amount;
    persist(); Sound.coin();
    var box = panelBox(t('chest_title'));
    box.panel.appendChild(el('div', 'coinline', '<img class="coinmini" src="img/coin.png" alt=""> ' + t('chest_got', { n: amount })));
    box.panel.appendChild(btn(t('ok'), 'green', function () { closeOverlay(); renderMenu(); }));
    openOverlay(box.ov);
  }

  /* ---------------- win / lose ---------------- */
  function calcStars() {
    var total = G.level.moves, used = G.movesUsed;
    var stars = 1;
    if (used <= Math.max(15, Math.ceil(total * 0.62))) stars = 2;
    if (used <= Math.max(10, Math.ceil(total * 0.42))) stars = 3;
    return stars;
  }

  function winLevel() {
    if (G.winShown || G.screen !== 'game') return;
    G.winShown = true;
    Sound.win();
    vibe([40, 60, 40]);
    saveGhost();
    doShake(4);
    try { P.gameplayStop && P.gameplayStop(); } catch (e) { /* noop */ }
    var stars = calcStars();
    var coins = Math.round(((G.level.reward || 50) + stars * 10) * (1 + 0.1 * equipLvl('hive') + (bless(1) ? 0.1 : 0)));
    save.stats.total_levels++;
    save.stats.stars += stars;
    if (G.movesUsed <= 10) save.stats.perfect_levels++;
    if (G.maxCascade > save.stats.best_cascade) save.stats.best_cascade = G.maxCascade;
    if (G.maxCascade > save.best_cascades) save.best_cascades = G.maxCascade;
    var n = G.levelNum;
    if (G.isEndless) {
      G.endlessDepth++;
      G.endlessRunScore += G.score;
      save.best_run = Math.max(save.best_run || 0, G.endlessDepth);
    } else if (!G.isDaily && n > 0) {
      var prev = save.campaign_stars[n] || 0;
      if (stars > prev) save.campaign_stars[n] = stars;
      var best = save.campaign_best[n] || 0;
      if (G.score > best) save.campaign_best[n] = G.score;
      if (G.level.boss) save.stats.bosses++;
      if (n + 1 > save.campaign_progress) save.campaign_progress = Math.min(201, n + 1);
      if (!save.stats.first_win) save.stats.first_win = 1;
    } else if (G.isDaily) {
      save.daily.last_date = todayStr();
      save.daily.streak = (save.daily.streak || 0) + 1;
      if (!save.daily.done_dates) save.daily.done_dates = [];
      save.daily.done_dates.push(todayStr());
      if (save.daily.done_dates.length > 40) save.daily.done_dates.shift();
    }
    save.coins += coins;
    save.stats.coins_earned += coins;
    addWeekScore(G.score);
    save.tutorial_done = true;
    if (save.stats.total_levels % 5 === 0) guestSpawn();
    persist();
    checkAchievements();
    if (G.isEndless) { showEndlessWinOverlay(stars, coins); return; }
    var bs = (G.level && G.level.boss) ? window.Story.bossScene(n) : null;
    maybeShowStory(bs, function () { showWinOverlay(stars, coins); });
    if (!bs) showWinOverlay(stars, coins);
  }

  function loseLevel() {
    if (G.loseShown) return;
    G.loseShown = true;
    Sound.lose();
    if (G.isEndless) { showRunOverOverlay(); return; }
    try { P.gameplayStop && P.gameplayStop(); } catch (e) { /* noop */ }
    save.tutorial_done = true;
    persist();
    showLoseOverlay();
  }

  function weekKey() {
    var d = new Date();
    var onejan = new Date(d.getFullYear(), 0, 1);
    var wk = Math.ceil((((d - onejan) / 86400000) + onejan.getDay() + 1) / 7);
    return d.getFullYear() + '-W' + wk;
  }
  function addWeekScore(pts) {
    var wk = weekKey();
    if (save.week_key !== wk) {
      if (!save.weeks) save.weeks = [];
      if (save.week_key && save.week_score > 0) save.weeks.push({ wk: save.week_key, score: save.week_score });
      save.weeks.sort(function (a, b) { return b.score - a.score; });
      save.weeks = save.weeks.slice(0, 5);
      save.week_key = wk; save.week_score = 0;
    }
    save.week_score += pts;
    try { if (P && P.submitScore) P.submitScore(save.week_score); } catch (e) { /* noop */ }
    persist();
  }

  function saveGhost() {
    if (G.isDaily || G.isEndless || G.levelNum <= 0) return;
    if (!save.campaign_ghost) save.campaign_ghost = {};
    var prev = save.campaign_ghost[G.levelNum];
    if (!prev || G.score > prev.score) {
      save.campaign_ghost[G.levelNum] = { score: G.score, moves: G.runMoves.slice(0, 120) };
      persist();
    }
  }
  function ghostNext() {
    if (!save.settings.ghost) return null;
    if (G.isDaily || G.isEndless) return null;
    var gh = save.campaign_ghost && save.campaign_ghost[G.levelNum];
    if (!gh || !save.campaign_stars[G.levelNum]) return null; // replays only
    for (var i = G.ghostIdx; i < gh.moves.length; i++) {
      var mv = gh.moves[i];
      var a = mv[0], b = mv[1];
      if (!ME.inb(a[0], a[1]) || !ME.inb(b[0], b[1])) continue;
      if (!ME.isSwappable(G.grid[a[0]][a[1]]) || !ME.isSwappable(G.grid[b[0]][b[1]])) continue;
      if (ME.areAdjacent(a, b) || isPortalPair(a, b)) {
        ME.swapInGrid(G.grid, a, b);
        var ok = ME.hasMatch(G.grid) || G.grid[a[0]][a[1]].sp !== SP.NONE || G.grid[b[0]][b[1]].sp !== SP.NONE;
        ME.swapInGrid(G.grid, a, b);
        if (ok) return [a, b];
      }
    }
    return null;
  }

  /* ---------------- ads wrappers (pause game + audio) ---------------- */
  function adsInterstitialAllowed() {
    var now = Date.now();
    return (now - G.sessionStart > 60000) && (now - G.lastInterstitial > 180000);
  }
  function withAdPause(fn) {
    var wasPaused = paused;
    setPaused(true, true);
    var safety = setTimeout(function () { setPaused(wasPaused, true); }, 45000);
    fn(function () { clearTimeout(safety); setPaused(false, true); });
  }
  function maybeInterstitial() {
    if (!adsInterstitialAllowed()) return;
    G.lastInterstitial = Date.now();
    withAdPause(function (restore) {
      P.interstitial(function () { restore(); }, function () { restore(); });
    });
  }
  function showRewarded(onReward, onFail) {
    withAdPause(function (restore) {
      var rewarded = false;
      P.rewarded(function () {
        rewarded = true;
        if (onReward) onReward();
      }, function () {
        restore();
      }, function () {
        restore();
        if (!rewarded) toast(t('msg_ad_not_ready'));
        if (onFail) onFail();
      });
    });
  }

  /* ---------------- pause ---------------- */
  function setPaused(v, fromAd) {
    paused = v;
    if (v) {
      Sound.suspend();
    } else {
      if (!fromAd) Sound.resume(); else { Sound.externalMute = false; try { if (Sound.ctx && Sound.ctx.state === 'suspended') Sound.ctx.resume(); } catch (e) { /* noop */ } Sound.refreshMusic(); }
    }
    if (v && G.screen === 'game' && !fromAd && !overlayOpen()) showPauseOverlay();
  }

  /* ---------------- boosters ---------------- */
  function doHammer(r, c) {
    G.boosterMode = null;
    updateBoosterBar();
    var cell = G.grid[r][c];
    if (!cell || cell.t !== T.GEM) return;
    Sound.special('bomb');
    burst(cellCenter(r, c).x, cellCenter(r, c).y, GEM_COLORS[cell.c] || '#fff', 14, 180);
    doShake(3);
    resolveBoard(null, { initialBlast: [[r, c]] });
  }
  function doShuffleBooster() {
    Sound.shuffle();
    ME.shuffleGrid(G.grid, levelRng);
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = G.grid[r][c];
      if (cell && cell.t === T.GEM) {
        cell.vx = c; cell.vy = r; cell.vs = 0.3;
        (function (cl) { tween(320, function (p) { cl.vs = 0.3 + 0.7 * easeOutBack(p); }, function () { cl.vs = 1; }); })(cell);
      }
    }
    toast(t('msg_shuffle_boost'));
    refreshHintIfNeeded();
  }
  function grantStartBomb() {
    var placed = false;
    var spots = [[4, 4], [4, 3], [4, 5], [3, 4], [5, 4]];
    for (var i = 0; i < spots.length && !placed; i++) {
      var cell = G.grid[spots[i][0]][spots[i][1]];
      if (cell && cell.t === T.GEM && cell.sp === SP.NONE) {
        cell.sp = SP.BOMB; cell.vs = 0.3; placed = true;
        tween(350, function (p) { cell.vs = 0.3 + 0.7 * easeOutBack(p); }, function () { cell.vs = 1; });
        Sound.spawn();
      }
    }
    if (!placed) toast(t('msg_ad_not_ready'));
  }

  function requestBooster(kind) {
    if (G.phase !== 'idle' || paused || overlayOpen()) return;
    var inv = kind === 'hammer' ? save.boosters.hammer : (kind === 'shuffle' ? save.boosters.shuffle : 0);
    if (inv > 0) {
      if (kind === 'hammer') { save.boosters.hammer--; G.boosterMode = 'hammer'; toast(t('msg_hammer_pick')); updateBoosterBar(); persist(); }
      else if (kind === 'shuffle') { save.boosters.shuffle--; doShuffleBooster(); updateBoosterBar(); persist(); }
      return;
    }
    var price = boosterPrice(kind);
    showBoosterSheet(kind, price);
  }

  function buyBooster(kind, price) {
    if (save.coins >= price) {
      save.coins -= price;
      persist(); updateCoinsUi();
      if (kind === 'hammer') { G.boosterMode = 'hammer'; toast(t('msg_hammer_pick')); updateBoosterBar(); }
      else doShuffleBooster();
      closeOverlay();
    } else {
      toast(t('not_enough_coins'));
    }
  }
  function adBooster(kind) {
    closeOverlay();
    showRewarded(function () {
      if (kind === 'hammer') { G.boosterMode = 'hammer'; toast(t('msg_hammer_pick')); updateBoosterBar(); }
      else if (kind === 'shuffle') doShuffleBooster();
      else if (kind === 'bomb') grantStartBomb();
    });
  }

  /* ================= DOM UI ================= */
  var uiBuilt = false;
  var levelsPage = 0;

  function buildShell() {
    if (uiBuilt) return;
    uiBuilt = true;
    document.body.innerHTML =
      '<div id="bg"></div>' +
      '<div id="ambient"></div>' +
      '<div id="ui">' +
        '<div class="screen" id="screen-loading"><div class="panel"><div class="title-small" id="loadTitle">Garden Gems</div><div class="loadbar"><div id="loadFill"></div></div><div id="loadPct">0%</div></div></div>' +
        '<div class="screen" id="screen-menu"></div>' +
        '<div class="screen" id="screen-levels"></div>' +
        '<div class="screen" id="screen-game">' +
          '<div id="hud">' +
            '<div class="hudrow"><div class="chip" id="hudLevel"></div><div class="chip" id="hudCoins"></div><div class="hudbtns"><button class="iconbtn" id="btnSound"></button><button class="iconbtn" id="btnPause">II</button></div></div>' +
            '<div class="hudrow2"><div class="chip big" id="hudMoves"></div><div id="goalBox"><div id="goalText"><img id="goalIcon" class="goalic" alt="" style="display:none"><span id="goalStr"></span></div><div class="progressbar"><div id="goalFill"></div></div></div><div class="chip big" id="hudScore"></div></div>' +
          '</div>' +
          '<div id="boardWrap"><div id="boardFrame"><canvas id="board"></canvas></div></div>' +
          '<div id="boosterBar"></div>' +
        '</div>' +
        '<div class="screen" id="screen-garden"></div>' +
        '<div class="screen" id="screen-gardens"></div>' +
        '<div class="screen" id="screen-quests"></div>' +
        '<div class="screen" id="screen-leaders"></div>' +
        '<div class="screen" id="screen-shop"></div>' +
        '<div class="screen" id="screen-achieve"></div>' +
        '<div class="screen" id="screen-settings"></div>' +
      '</div>' +
      '<div id="overlayRoot"></div>' +
      '<div id="toast"></div>';
    canvas = $('#board');
    ctx = canvas.getContext('2d');
    canvas.addEventListener('pointerdown', onPointerDown);
    canvas.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);
    $('#btnPause').addEventListener('click', function () { Sound.click(); showPauseOverlay(); });
    $('#btnSound').addEventListener('click', function () {
      save.settings.sound = !save.settings.sound;
      Sound.enabled = save.settings.sound;
      persist(); refreshSoundBtn(); Sound.click();
    });
    buildAmbient();
  }

  /* ambient layer: drifting petals & fireflies (menu + game) */
  var ambientBuilt = false;
  function buildAmbient() {
    if (ambientBuilt) return;
    ambientBuilt = true;
    var box = $('#ambient');
    if (!box) return;
    var petals = ['🌸', '', '', '✿'];
    for (var i = 0; i < 10; i++) {
      var s = el('span', 'petal', i % 4 === 3 ? '✦' : petals[i % 3]);
      s.style.left = (Math.random() * 100) + '%';
      s.style.animationDuration = (9 + Math.random() * 10) + 's';
      s.style.animationDelay = (-Math.random() * 12) + 's';
      s.style.fontSize = (10 + Math.random() * 14) + 'px';
      s.style.opacity = String(0.25 + Math.random() * 0.4);
      box.appendChild(s);
    }
    for (var f = 0; f < 7; f++) {
      var fl = el('span', 'firefly');
      fl.style.left = (Math.random() * 100) + '%';
      fl.style.top = (20 + Math.random() * 70) + '%';
      fl.style.animationDuration = (5 + Math.random() * 6) + 's';
      fl.style.animationDelay = (-Math.random() * 8) + 's';
      box.appendChild(fl);
    }
  }

  function showScreen(name) {
    var prev = G.screen;
    G.screen = name;
    var ids = ['loading', 'menu', 'levels', 'game', 'garden', 'gardens', 'quests', 'leaders', 'shop', 'achieve', 'settings'];
    for (var i = 0; i < ids.length; i++) {
      var s = $('#screen-' + ids[i]);
      if (s) s.classList.toggle('active', ids[i] === name);
    }
    var bgName = (name === 'game') ? 'bg_game' : (name === 'shop' ? 'bg_shop' : 'bg_menu');
    var bg = $('#bg');
    if (name !== 'loading') {
      if (bg.dataset.img !== bgName) {
        bg.dataset.img = bgName;
        bg.style.backgroundImage = imgReady(bgName) ? ('url("img/' + bgName + '.png")') : '';
      } else if (!bg.style.backgroundImage && imgReady(bgName)) {
        bg.style.backgroundImage = 'url("img/' + bgName + '.png")';
      }
    }
    if (name === 'menu') { ensureQuests(); renderMenu(); }
    if (name === 'levels') renderLevels();
    if (name === 'garden') renderGarden();
    if (name === 'gardens') renderGardensMap();
    if (name === 'quests') renderQuests();
    if (name === 'leaders') renderLeaders();
    if (name === 'shop') renderShop();
    if (name === 'achieve') renderAchievements();
    if (name === 'settings') renderSettings();
    if (name === 'game') { layout(); updateHud(); updateBoosterBar(); }
    if (prev === 'game' && name !== 'game') {
      try { P.gameplayStop && P.gameplayStop(); } catch (e) { /* noop */ }
      var played = Date.now() - G.playSegmentStart;
      if (played > 5 * 60000) maybeInterstitial();
    }
    if (name === 'game') layout();
  }

  function btn(label, cls, fn, icon) {
    label = String(label).split('🪙').join('<img class="coinmini" src="img/coin.png" alt="">');
    var b = el('button', 'btn ' + (cls || ''), (icon ? '<img class="btnicon" src="img/' + icon + '.png" alt="">' : '') + '<span>' + label + '</span>');
    b.addEventListener('click', function (e) { e.preventDefault(); Sound.init(); Sound.click(); fn(); });
    return b;
  }

  /* -------- menu -------- */
  function renderMenu() {
    var s = $('#screen-menu');
    s.innerHTML = '';
    var top = el('div', 'menutop');
    top.innerHTML = '<div class="coinschip"><img src="img/coin.png" alt=""><span id="menuCoins">' + save.coins + '</span></div>';
    var chest = el('button', 'chestbtn' + (chestReady() ? ' ready' : ''), '<img src="img/coin.png" alt="">');
    chest.title = t('chest_title');
    chest.addEventListener('click', function () { Sound.click(); openChest(); });
    top.appendChild(chest);
    s.appendChild(top);
    var title = el('div', 'gametitle', t('app_title'));
    s.appendChild(title);
    var ev = currentEvent();
    if (ev) s.appendChild(el('div', 'eventbanner', '🎪 ' + t('ev_' + ev + '_n') + ' — ' + t('ev_' + ev + '_d')));
    var figs = el('div', 'garden');
    for (var i = 1; i <= 10; i++) {
      var owned = save.garden_figures.indexOf(i) >= 0;
      var f = el('div', 'figslot' + (owned ? ' owned' : ''));
      f.innerHTML = owned ? '<img src="img/' + figName(i) + '.png" alt="">' : '<span>?</span>';
      (function (id, isOwned) {
        f.addEventListener('click', function () {
          if (!isOwned) showScreen('shop');
        });
      })(i, owned);
      figs.appendChild(f);
    }
    s.appendChild(figs);
    var col = el('div', 'menucol');
    var nextLvl = clamp(save.campaign_progress, 1, 200);
    col.appendChild(btn(save.tutorial_done || nextLvl > 1 ? t('menu_continue') + ' — ' + nextLvl : t('menu_play'), 'big green', function () {
      if (!save.tutorial_done) startLevel(1, { tut: true });
      else requestLevel(nextLvl, { from: 'menu' });
    }, 'ui_play'));
    var dailyBtn = btn(dailyAvailable() ? t('menu_daily') : t('menu_daily_done'), 'gold' + (dailyAvailable() ? ' pulse' : ' disabled'), function () {
      if (!dailyAvailable()) { toast(t('msg_daily_done')); return; }
      requestLevel(0, { daily: true, from: 'menu' });
    });
    dailyBtn.id = 'btnDaily';
    col.appendChild(dailyBtn);
    if (endlessUnlocked()) {
      col.appendChild(btn('∞ ' + t('menu_endless') + (save.best_run ? ' — ' + save.best_run : ''), '', function () { startEndless(); }));
    }
    if (save.daily.streak > 0) col.appendChild(el('div', 'sub', t('daily_streak', { n: save.daily.streak })));
    var row1 = el('div', 'menurow');
    row1.appendChild(btn(t('menu_levels'), '', function () { showScreen('levels'); }, 'ui_levels'));
    row1.appendChild(btn(t('menu_shop'), '', function () { showScreen('shop'); }, 'ui_shop'));
    col.appendChild(row1);
    var row2 = el('div', 'menurow');
    row2.appendChild(btn(t('menu_garden'), '', function () { showScreen('gardens'); }, 'eq_water'));
    row2.appendChild(btn(t('menu_achieve'), '', function () { showScreen('achieve'); }, 'ui_achieve'));
    col.appendChild(row2);
    var row3 = el('div', 'menurow');
    var qb = btn(t('quests_title'), '', function () { showScreen('quests'); }, 'ui_achieve');
    var qc = questsClaimable();
    if (qc > 0) qb.appendChild(el('span', 'bcount', String(qc)));
    row3.appendChild(qb);
    row3.appendChild(btn(t('menu_settings'), '', function () { showScreen('settings'); }, 'ui_settings'));
    col.appendChild(row3);
    var row4 = el('div', 'menurow');
    row4.appendChild(btn(t('journal'), '', function () { openJournal(); }, 'gnome_10'));
    row4.appendChild(btn(t('cup_title'), '', function () { showScreen('leaders'); }, 'ui_achieve'));
    col.appendChild(row4);
    s.appendChild(col);
    var stars = totalStars();
    s.appendChild(el('div', 'sub starsline', '★ ' + stars + ' / 600'));
  }
  function figName(i) { return 'gnome_' + (i < 10 ? '0' + i : i); }
  function totalStars() {
    var sum = 0;
    for (var k in save.campaign_stars) sum += save.campaign_stars[k] || 0;
    return sum;
  }
  function updateCoinsUi() {
    var m = $('#menuCoins'); if (m) m.textContent = save.coins;
    var h = $('#hudCoins'); if (h) h.innerHTML = '<img src="img/coin.png" alt=""> ' + save.coins;
    var sh = $('#shopCoins'); if (sh) sh.textContent = save.coins;
  }

  /* -------- level select -------- */
  function renderLevels() {
    var s = $('#screen-levels');
    s.innerHTML = '';
    var head = el('div', 'pagehead');
    var backB = btn(t('back'), 'small', function () { showScreen('menu'); });
    head.appendChild(backB);
    head.appendChild(el('div', 'pageheadtitle', t('levels_title')));
    head.appendChild(el('div', 'chip', '★ ' + totalStars() + '/600'));
    s.appendChild(head);
    var nav = el('div', 'pagenav');
    nav.appendChild(btn('◀', 'small', function () { if (levelsPage > 0) { levelsPage--; renderLevels(); } }));
    nav.appendChild(el('div', 'pagechip', (levelsPage * 20 + 1) + '–' + Math.min(200, levelsPage * 20 + 20)));
    nav.appendChild(btn('▶', 'small', function () { if (levelsPage < 9) { levelsPage++; renderLevels(); } }));
    s.appendChild(nav);
    var grid = el('div', 'lvlgrid');
    for (var i = 0; i < 20; i++) {
      var n = levelsPage * 20 + i + 1;
      var locked = n > save.campaign_progress;
      var stars = save.campaign_stars[n] || 0;
      var b = el('button', 'lvlbtn' + (locked ? ' locked' : '') + (n % 20 === 0 ? ' boss' : ''));
      b.innerHTML = '<span class="lvlnum">' + n + '</span>' +
        (locked ? '<span class="lock">🔒</span>' : '<span class="lvlstars">' + starStr(stars) + '</span>') +
        (n % 20 === 0 && !locked ? '<span class="bossflag">' + t('level_boss') + '</span>' : '');
      if (!locked) (function (nn) {
        b.addEventListener('click', function () { Sound.click(); requestLevel(nn, { from: 'levels' }); });
      })(n);
      grid.appendChild(b);
    }
    s.appendChild(grid);
  }
  function starStr(n) { var s = ''; for (var i = 0; i < 3; i++) s += i < n ? '★' : '☆'; return s; }

  /* -------- shop -------- */
  function renderShop() {
    var s = $('#screen-shop');
    s.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('menu'); }));
    head.appendChild(el('div', 'pageheadtitle', t('shop_title')));
    head.appendChild(el('div', 'chip', '<img class="coinmini" src="img/coin.png" alt=""> <span id="shopCoins">' + save.coins + '</span>'));
    s.appendChild(head);
    var body = el('div', 'shopbody');
    body.appendChild(el('div', 'sechead', t('shop_boosters')));
    var packs = [
      { id: 'hammer', name: t('shop_hammer_pack'), img: 'special_bomb', price: 250, q: 3, kind: 'hammer' },
      { id: 'shuffle', name: t('shop_shuffle_pack'), img: 'special_rainbow', price: 120, q: 3, kind: 'shuffle' }
    ];
    packs.forEach(function (pk) {
      var row = el('div', 'shoprow');
      row.innerHTML = '<img src="img/' + pk.img + '.png" alt=""><div class="shopname">' + pk.name + '</div>';
      var b = btn(pk.price + ' 🪙', 'small gold', function () {
        if (save.coins >= pk.price) {
          save.coins -= pk.price;
          save.boosters[pk.kind] += pk.q;
          persist(); renderShop(); Sound.coin();
        } else toast(t('not_enough_coins'));
      });
      row.appendChild(b);
      body.appendChild(row);
    });
    body.appendChild(el('div', 'sechead', t('shop_figures')));
    body.appendChild(el('div', 'sub', t('garden_hint')));
    for (var i = 1; i <= 10; i++) {
      (function (id) {
        var owned = save.garden_figures.indexOf(id) >= 0;
        var row = el('div', 'shoprow');
        row.innerHTML = '<img src="img/' + figName(id) + '.png" alt=""><div class="shopname">' + t('fig_' + id) + '</div>';
        if (owned) row.appendChild(el('div', 'chip small green', t('shop_owned')));
        else row.appendChild(btn('200 🪙', 'small gold', function () {
          if (save.coins >= 200) {
            save.coins -= 200;
            save.garden_figures.push(id);
            persist(); checkAchievements(); renderShop(); Sound.coin();
            toast('🌸 ' + t('fig_' + id));
          } else toast(t('not_enough_coins'));
        }));
        body.appendChild(row);
      })(i);
    }
    s.appendChild(body);
  }

  /* -------- achievements -------- */
  var ACHS = [
    { id: 1, reward: 50, chk: function (s) { return s.stats.total_levels >= 1; } },
    { id: 2, reward: 50, chk: function (s) { return s.stats.total_levels >= 5; } },
    { id: 3, reward: 100, chk: function (s) { return s.stats.total_levels >= 20; } },
    { id: 4, reward: 150, chk: function (s) { return s.stats.total_levels >= 50; } },
    { id: 5, reward: 250, chk: function (s) { return s.stats.total_levels >= 100; } },
    { id: 6, reward: 500, chk: function (s) { return s.stats.total_levels >= 200; } },
    { id: 7, reward: 20, chk: function (s) { return s.stats.total_matches >= 1; } },
    { id: 8, reward: 100, chk: function (s) { return s.stats.total_matches >= 100; } },
    { id: 9, reward: 300, chk: function (s) { return s.stats.total_matches >= 1000; } },
    { id: 10, reward: 50, chk: function (s) { return s.stats.best_cascade >= 3; } },
    { id: 11, reward: 100, chk: function (s) { return s.stats.best_cascade >= 5; } },
    { id: 12, reward: 200, chk: function (s) { return s.stats.best_cascade >= 8; } },
    { id: 13, reward: 100, chk: function (s) { return s.stats.bombs >= 10; } },
    { id: 14, reward: 100, chk: function (s) { return s.stats.lightnings >= 10; } },
    { id: 15, reward: 150, chk: function (s) { return s.stats.rainbows >= 5; } },
    { id: 16, reward: 200, chk: function (s) { return s.stats.total_specials >= 50; } },
    { id: 17, reward: 100, chk: function (s) { return s.stats.stars >= 30; } },
    { id: 18, reward: 250, chk: function (s) { return s.stats.stars >= 150; } },
    { id: 19, reward: 500, chk: function (s) { return s.stats.stars >= 400; } },
    { id: 20, reward: 100, chk: function (s) { return s.stats.bosses >= 1; } },
    { id: 21, reward: 500, chk: function (s) { return s.stats.bosses >= 10; } },
    { id: 22, reward: 100, chk: function (s) { return s.stats.perfect_levels >= 1; } },
    { id: 23, reward: 150, chk: function (s) { return s.daily.streak >= 3; } },
    { id: 24, reward: 200, chk: function (s) { return s.stats.coins_earned >= 2000; } },
    { id: 25, reward: 500, chk: function (s) { return s.garden_figures.length >= 10; } }
  ];
  function checkAchievements() {
    var changed = false;
    for (var i = 0; i < ACHS.length; i++) {
      var a = ACHS[i];
      if (!save.achievements[a.id] && a.chk(save)) {
        save.achievements[a.id] = 1;
        changed = true;
        toast('🏆 ' + t('ach_' + a.id + '_n'));
      }
    }
    if (changed) persist();
  }
  function renderAchievements() {
    var s = $('#screen-achieve');
    s.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('menu'); }));
    head.appendChild(el('div', 'pageheadtitle', t('ach_title')));
    head.appendChild(el('div', 'chip', '<img class="coinmini" src="img/coin.png" alt=""> ' + save.coins));
    s.appendChild(head);
    var body = el('div', 'achbody');
    ACHS.forEach(function (a) {
      var st = save.achievements[a.id] || 0;
      var row = el('div', 'achrow' + (st === 2 ? ' done' : ''));
      row.innerHTML = '<div class="achmedal">' + (st === 2 ? '🏆' : (st === 1 ? '🎖' : '🔒')) + '</div>' +
        '<div class="achtext"><b>' + t('ach_' + a.id + '_n') + '</b><div class="sub">' + t('ach_' + a.id + '_d') + '</div></div>';
      if (st === 1) {
        row.appendChild(btn(t('ach_claim', { n: a.reward }), 'small gold', function () {
          save.achievements[a.id] = 2;
          save.coins += a.reward;
          save.stats.coins_earned += a.reward;
          persist(); Sound.coin(); renderAchievements();
        }));
      } else if (st === 2) row.appendChild(el('div', 'chip small green', t('ach_done')));
      body.appendChild(row);
    });
    s.appendChild(body);
  }

  /* -------- settings -------- */
  function renderSettings() {
    var s = $('#screen-settings');
    s.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('menu'); }));
    head.appendChild(el('div', 'pageheadtitle', t('settings_title')));
    head.appendChild(el('div', 'chip', ''));
    s.appendChild(head);
    var body = el('div', 'setbody panel');
    var r1 = el('div', 'setrow');
    r1.innerHTML = '<span>' + t('settings_sound') + '</span>';
    r1.appendChild(btn(save.settings.sound ? t('on') : t('off'), 'small ' + (save.settings.sound ? 'green' : ''), function () {
      save.settings.sound = !save.settings.sound;
      Sound.enabled = save.settings.sound;
      persist(); renderSettings();
    }));
    body.appendChild(r1);
    var r2 = el('div', 'setrow');
    r2.innerHTML = '<span>' + t('settings_music') + '</span>';
    r2.appendChild(btn(save.settings.music ? t('on') : t('off'), 'small ' + (save.settings.music ? 'green' : ''), function () {
      save.settings.music = !save.settings.music;
      Sound.musicEnabled = save.settings.music;
      Sound.refreshMusic();
      persist(); renderSettings();
    }));
    body.appendChild(r2);
    var r3 = el('div', 'setrow');
    r3.innerHTML = '<span>' + t('settings_lang') + '</span>';
    var langBox = el('div', 'langbox');
    ['ru', 'en'].forEach(function (l) {
      langBox.appendChild(btn(l.toUpperCase(), 'small' + (LANG === l ? ' green' : ''), function () {
        setLang(l);
        save.settings.lang = l;
        persist();
        showScreen(G.screen === 'settings' ? 'settings' : G.screen);
        renderSettings();
      }));
    });
    r3.appendChild(langBox);
    body.appendChild(r3);
    [['colorblind', 'set_cb'], ['largetext', 'set_lg'], ['motionreduce', 'set_mr'], ['vibro', 'set_vib'], ['ghost', 'set_ghost']].forEach(function (pr) {
      var on = prefOn(pr[0]);
      var rr = el('div', 'setrow');
      rr.innerHTML = '<span>' + t(pr[1]) + '</span>';
      rr.appendChild(btn(on ? t('on') : t('off'), 'small ' + (on ? 'green' : ''), function () {
        save.settings[pr[0]] = !on;
        persist(); applyPrefs(); renderSettings();
      }));
      body.appendChild(rr);
    });
    var r4 = el('div', 'setrow');
    r4.innerHTML = '<span>' + t('settings_reset') + '</span>';
    r4.appendChild(btn('🗑', 'small red', function () {
      showConfirm(t('reset_confirm_title'), t('settings_reset_q'), function () {
        save = newSave();
        persist();
        closeOverlay();
        showScreen('menu');
      });
    }));
    body.appendChild(r4);
    s.appendChild(body);
  }

  function renderLeaders() {
    var sEl = $('#screen-leaders');
    sEl.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('menu'); }));
    head.appendChild(el('div', 'pageheadtitle', t('cup_title')));
    head.appendChild(el('div', 'chip', '🏆'));
    sEl.appendChild(head);
    var body = el('div', 'achbody');
    body.appendChild(el('div', 'sechead', t('cup_week') + ' (' + weekKey() + ')'));
    body.appendChild(el('div', 'cuprow big', t('cup_pts', { n: save.week_score || 0 })));
    body.appendChild(el('div', 'sechead', t('cup_best')));
    var weeks = save.weeks || [];
    if (!weeks.length) body.appendChild(el('div', 'sub', '—'));
    weeks.forEach(function (w, i) {
      body.appendChild(el('div', 'cuprow', (i + 1) + '. ' + w.wk + ' — ' + t('cup_pts', { n: w.score })));
    });
    body.appendChild(el('div', 'sub', t('cup_note')));
    sEl.appendChild(body);
  }
  function photoGarden() {
    var cv = $('#gardenCanvas');
    if (!cv) return 0;
    try {
      var url = cv.toDataURL('image/png');
      var a = document.createElement('a');
      a.href = url; a.download = 'garden-gems-' + Date.now() + '.png';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      toast(t('photo_done'));
      return url.length;
    } catch (e) { return 0; }
  }
  function prefOn(key) {
    if (key === 'vibro') return save.settings.vibro !== false;
    return !!save.settings[key];
  }
  function applyPrefs() {
    var st = save.settings || {};
    document.body.classList.toggle('bigtext', !!st.largetext);
    document.body.classList.toggle('motionreduce', !!st.motionreduce);
  }
  function fallEase() { return (save.settings && save.settings.motionreduce) ? easeOutQuad : easeOutBounce; }

  /* -------- HUD -------- */
  function updateHud() {
    if (!G.level) return;
    var lv = $('#hudLevel'); if (lv) lv.textContent = G.isEndless ? ('∞ ' + t('run_depth', { n: G.endlessDepth + 1 })) : (G.isDaily ? t('menu_daily') : t('hud_level', { n: G.levelNum }));
    var mv = $('#hudMoves'); if (mv) mv.innerHTML = '<b>' + Math.max(0, G.moves) + '</b><span>' + t('hud_moves') + '</span>';
    var sc = $('#hudScore'); if (sc) sc.innerHTML = '<b>' + G.score + '</b><span>' + t('hud_score') + '</span>';
    var gs = $('#goalStr'); if (gs) gs.textContent = goalText();
    var gi = $('#goalIcon');
    if (gi) {
      var g = G.level.goal, ic = '';
      if (g.type === 'collect') ic = GEM_KEYS[g.color] || GEM_KEYS[0];
      else if (g.type === 'blocks') ic = 'block_wood';
      else if (g.type === 'deliver') ic = 'item_01';
      else if (g.type === 'score') ic = 'coin';
      else if (g.type === 'choc') ic = 'block_wood';
      else ic = 'special_rainbow';
      gi.src = 'img/' + ic + '.png';
      gi.style.display = 'inline-block';
    }
    refreshSoundBtn();
    var gf = $('#goalFill'); if (gf) gf.style.width = Math.round(goalProgress() * 100) + '%';
    updateCoinsUi();
  }
  function refreshSoundBtn() {
    var b = $('#btnSound');
    if (b) b.innerHTML = '<img src="img/' + (save.settings.sound ? 'ui_sound_on' : 'ui_sound_off') + '.png" alt="" style="width:20px;height:20px">';
  }
  function updateBoosterBar() {
    var bar = $('#boosterBar');
    if (!bar) return;
    bar.innerHTML = '';
    bar.appendChild(boosterBtn('ui_hammer', t('booster_hammer'), save.boosters.hammer, function () { requestBooster('hammer'); }, G.boosterMode === 'hammer'));
    bar.appendChild(boosterBtn('ui_shuffle', t('booster_shuffle'), save.boosters.shuffle, function () { requestBooster('shuffle'); }, false));
  }
  function boosterBtn(icon, label, count, fn, active) {
    var b = el('button', 'boosterbtn' + (active ? ' active' : ''));
    b.innerHTML = '<img class="biconimg" src="img/' + icon + '.png" alt=""><span class="blabel">' + label + '</span>' + (count > 0 ? '<span class="bcount">' + count + '</span>' : '');
    b.addEventListener('click', function (e) { e.preventDefault(); Sound.init(); Sound.click(); fn(); });
    return b;
  }

  /* -------- overlays -------- */
  function overlayOpen() { var r = $('#overlayRoot'); return !!r && r.classList.contains('open'); }
  function closeOverlay() { var r = $('#overlayRoot'); if (r) { r.classList.remove('open'); r.innerHTML = ''; } }
  function openOverlay(node, cls) {
    var r = $('#overlayRoot');
    r.innerHTML = '';
    r.appendChild(node);
    r.classList.add('open');
    if (cls) node.classList.add(cls);
  }
  function panelBox(title) {
    var ov = el('div', 'overlay');
    var p = el('div', 'panel big');
    if (title) p.appendChild(el('div', 'paneltitle', title));
    ov.appendChild(p);
    return { ov: ov, panel: p };
  }

  function showWinOverlay(stars, coins) {
    var box = panelBox(t('win_title'));
    // confetti juice
    var conf = el('div', 'confetti');
    for (var ci = 0; ci < 26; ci++) {
      var cf = el('i');
      cf.style.left = (Math.random() * 100) + '%';
      cf.style.background = ['#ffd76a', '#8ede5a', '#ef6fae', '#7ec8ff', '#c99cff'][ci % 5];
      cf.style.animationDelay = (Math.random() * 0.7) + 's';
      cf.style.animationDuration = (1.2 + Math.random() * 1.2) + 's';
      conf.appendChild(cf);
    }
    box.panel.appendChild(conf);
    var st = el('div', 'starsrow');
    for (var i = 0; i < 3; i++) {
      var sp2 = el('span', 'bigstar' + (i < stars ? ' on' : ''), i < stars ? '★' : '☆');
      st.appendChild(sp2);
      if (i < stars) (function (node, idx) {
        node.style.opacity = 0;
        setTimeout(function () { node.style.opacity = 1; node.style.transform = 'scale(1.25)'; setTimeout(function () { node.style.transform = 'scale(1)'; }, 150); }, 250 + idx * 300);
      })(sp2, i);
    }
    box.panel.appendChild(st);
    box.panel.appendChild(el('div', 'scoreline', t('hud_score') + ': ' + G.score));
    var coinLine = el('div', 'coinline', '<img class="coinmini" src="img/coin.png" alt=""> +' + coins);
    box.panel.appendChild(coinLine);
    var x2used = false;
    var x2 = btn(t('win_x2'), 'gold', function () {
      if (x2used) return;
      x2used = true;
      showRewarded(function () {
        save.coins += coins; save.stats.coins_earned += coins;
        persist(); updateCoinsUi();
        coinLine.innerHTML = '<img class="coinmini" src="img/coin.png" alt=""> +' + (coins * 2) + ' ×2!';
        Sound.coin();
      }, function () { x2used = false; });
    });
    box.panel.appendChild(x2);
    var rowB = el('div', 'btnrow');
    rowB.appendChild(btn(t('win_menu'), '', function () { closeOverlay(); showScreen('menu'); }));
    if (!G.isDaily && G.levelNum < 200) {
      rowB.appendChild(btn(t('win_next'), 'green big', function () {
        closeOverlay();
        maybeInterstitial();
        startLevel(G.levelNum + 1);
      }));
    } else if (G.isDaily) {
      rowB.appendChild(btn(t('win_menu'), 'green', function () { closeOverlay(); showScreen('menu'); }));
    }
    box.panel.appendChild(rowB);
    openOverlay(box.ov);
  }

  function showLoseOverlay() {
    var box = panelBox(t('lose_title'));
    box.panel.appendChild(el('div', 'sub', goalText()));
    var used5 = false;
    box.panel.appendChild(btn(t('lose_moves5'), 'gold', function () {
      if (used5) return;
      used5 = true;
      showRewarded(function () {
        used5 = false;
        closeOverlay();
        G.moves += 5;
        G.loseShown = false;
        G.phase = 'idle';
        updateHud();
        try { P.gameplayStart && P.gameplayStart(); } catch (e) { /* noop */ }
      }, function () { used5 = false; });
    }));
    if (G.scareLeft > 0) {
      box.panel.appendChild(btn('🎃 ' + t('scare_btn'), 'gold', function () {
        G.scareLeft--;
        closeOverlay();
        G.moves += 3;
        G.loseShown = false;
        G.phase = 'idle';
        updateHud();
        toast(t('scare_used'));
        try { P.gameplayStart && P.gameplayStart(); } catch (e) { /* noop */ }
      }));
    }
    box.panel.appendChild(btn(t('lose_retry'), 'green', function () {
      closeOverlay();
      if (G.isDaily) startLevel(0, { daily: true });
      else startLevel(G.levelNum);
    }));
    box.panel.appendChild(btn(t('lose_menu'), '', function () { closeOverlay(); showScreen('menu'); }));
    openOverlay(box.ov);
  }

  function showEndlessWinOverlay(stars, coins) {
    var box = panelBox(t('run_depth', { n: G.endlessDepth }));
    var st = el('div', 'starsrow');
    for (var i = 0; i < 3; i++) st.appendChild(el('span', 'bigstar' + (i < stars ? ' on' : ''), i < stars ? '★' : '☆'));
    box.panel.appendChild(st);
    box.panel.appendChild(el('div', 'scoreline', t('run_score', { n: G.endlessRunScore })));
    box.panel.appendChild(el('div', 'coinline', '<img class="coinmini" src="img/coin.png" alt=""> +' + coins));
    var row = el('div', 'btnrow');
    row.appendChild(btn(t('win_menu'), '', function () { closeOverlay(); G.isEndless = false; showScreen('menu'); }));
    row.appendChild(btn(t('win_next'), 'green big', function () {
      closeOverlay();
      startLevel(0, { cfg: endlessCfg(G.endlessDepth) });
    }));
    box.panel.appendChild(row);
    openOverlay(box.ov);
  }
  function showRunOverOverlay() {
    addWeekScore(G.endlessRunScore);
    var box = panelBox(t('run_over'));
    box.panel.appendChild(el('div', 'scoreline', t('run_depth', { n: G.endlessDepth })));
    box.panel.appendChild(el('div', 'scoreline', t('run_score', { n: G.endlessRunScore })));
    box.panel.appendChild(el('div', 'sub', t('cup_week') + ': ' + t('cup_pts', { n: save.week_score || 0 })));
    var row = el('div', 'btnrow');
    row.appendChild(btn(t('win_menu'), '', function () { closeOverlay(); G.isEndless = false; showScreen('menu'); }));
    row.appendChild(btn(t('lose_retry'), 'green big', function () { closeOverlay(); startEndless(); }));
    box.panel.appendChild(row);
    openOverlay(box.ov);
  }
  function showPauseOverlay() {
    if (overlayOpen()) return;
    setPausedRaw(true);
    var box = panelBox(t('pause_title'));
    box.panel.appendChild(btn(t('pause_resume'), 'green', function () {
      closeOverlay();
      autoPauseOverlay = false;
      setPausedRaw(false);
      Sound.resume();
    }));
    box.panel.appendChild(btn(t('set_fast') + ': ' + (save.settings.fast ? t('x2') : t('x1')), '', function () {
      save.settings.fast = !save.settings.fast;
      persist();
      closeOverlay();
      showPauseOverlay();
    }));
    box.panel.appendChild(btn(t('pause_restart'), '', function () {
      closeOverlay(); setPausedRaw(false); Sound.resume();
      if (G.isDaily) startLevel(0, { daily: true }); else startLevel(G.levelNum);
    }));
    box.panel.appendChild(btn(t('pause_exit'), '', function () {
      closeOverlay(); setPausedRaw(false); Sound.resume();
      showScreen('menu');
    }));
    openOverlay(box.ov);
  }
  function setPausedRaw(v) {
    paused = v;
    if (v) Sound.suspend();
  }

  function showConfirm(title, text, onYes) {
    var box = panelBox(title);
    box.panel.appendChild(el('div', 'sub', text));
    var row = el('div', 'btnrow');
    row.appendChild(btn(t('no'), '', function () { closeOverlay(); }));
    row.appendChild(btn(t('yes'), 'red', function () { onYes(); }));
    box.panel.appendChild(row);
    openOverlay(box.ov);
  }

  function showBoosterSheet(kind, price) {
    var box = panelBox(kind === 'hammer' ? t('booster_hammer') : t('booster_shuffle'));
    box.panel.appendChild(el('div', 'sub', kind === 'hammer' ? t('booster_hint_hammer') : t('booster_hint_shuffle')));
    box.panel.appendChild(btn(price + ' 🪙', 'gold', function () { buyBooster(kind, price); }));
    box.panel.appendChild(btn(t('watch_ad_free'), 'green', function () { adBooster(kind); }));
    box.panel.appendChild(btn(t('cancel'), '', function () { closeOverlay(); }));
    openOverlay(box.ov);
  }
  function showRewardedConfirm(rewardText, onReward) {
    var box = panelBox(t('watch_ad_free'));
    box.panel.appendChild(el('div', 'sub', rewardText));
    box.panel.appendChild(btn(t('ok'), 'green', function () { closeOverlay(); onReward(); }));
    box.panel.appendChild(btn(t('cancel'), '', function () { closeOverlay(); }));
    openOverlay(box.ov);
  }

  function showRainbowPicker(onPick, onCancel) {
    var box = panelBox(t('msg_rainbow_pick'));
    var row = el('div', 'colorrow');
    var colors = G.level ? G.level.colors : 6;
    for (var i = 0; i < colors; i++) {
      (function (ci) {
        var b = el('button', 'colorbtn');
        b.style.background = GEM_COLORS[ci];
        b.addEventListener('click', function () { closeOverlay(); Sound.click(); onPick(ci); });
        row.appendChild(b);
      })(i);
    }
    box.panel.appendChild(row);
    box.panel.appendChild(btn(t('cancel'), '', function () { closeOverlay(); if (onCancel) onCancel(); }));
    openOverlay(box.ov);
  }

  var toastTimer = null;
  function showConflictDialog(info) {
    var box = panelBox(t('conflict_title'));
    box.panel.appendChild(el('div', 'sub', t('conflict_text')));
    box.panel.appendChild(el('div', 'sub', '☁ ' + (info.cloud.campaign_progress || 1) + ' / ★' + starsOf(info.cloud) +
      '   •   💾 ' + (info.local.campaign_progress || 1) + ' / ★' + starsOf(info.local)));
    var row = el('div', 'btnrow');
    row.appendChild(btn(t('conflict_local'), '', function () {
      installSave(info.local, null); persist(); closeOverlay(); showScreen(G.screen);
    }));
    row.appendChild(btn(t('conflict_cloud'), 'green', function () {
      installSave(info.cloud, null); persist(); closeOverlay(); showScreen(G.screen);
    }));
    box.panel.appendChild(row);
    pendingConflict = null;
    openOverlay(box.ov);
  }
  function toast(msg) {
    var tt = $('#toast');
    if (!tt) return;
    tt.textContent = msg;
    tt.classList.add('show');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { tt.classList.remove('show'); toastTimer = null; }, 2400);
  }

  /* ================= STORY ================= */
  var storyState = null; // {scene, idx}
  function storySeen(id) { return !!(save.story_seen && save.story_seen.indexOf(id) >= 0); }
  function markStorySeen(id) {
    if (!save.story_seen) save.story_seen = [];
    if (save.story_seen.indexOf(id) < 0) save.story_seen.push(id);
    persist();
  }
  function maybeShowStory(scene, onDone) {
    if (!scene || G.storyOff || storySeen(scene.id)) { if (onDone) onDone(); return; }
    storyState = { scene: scene, idx: 0, onDone: onDone };
    renderStoryLine();
  }
  function renderStoryLine() {
    var st = storyState;
    if (!st) return;
    var line = st.scene.lines[st.idx];
    var ch = window.Story.CHARS[line[0]];
    closeOverlay();
    var ov = el('div', 'overlay');
    var box = el('div', 'storybox');
    var portrait = el('div', 'storyport');
    portrait.innerHTML = '<img src="' + assetOrPath(ch.img) + '" alt="">';
    box.appendChild(portrait);
    var body = el('div', 'storybody');
    body.appendChild(el('div', 'storyname', t(ch.name)));
    body.appendChild(el('div', 'storytext', t(line[1])));
    var dots = el('div', 'storydots');
    for (var i = 0; i < st.scene.lines.length; i++) dots.appendChild(el('i', i <= st.idx ? 'on' : ''));
    body.appendChild(dots);
    var row = el('div', 'btnrow');
    var last = st.idx === st.scene.lines.length - 1;
    row.appendChild(btn(t('story_skip'), '', function () { endStory(); }));
    row.appendChild(btn(last ? t('story_end') : t('story_next'), 'green', function () {
      if (last) endStory();
      else { st.idx++; renderStoryLine(); }
    }));
    body.appendChild(row);
    box.appendChild(body);
    ov.appendChild(box);
    openOverlay(ov);
  }
  function assetOrPath(name) { return imgReady(name) ? ('img/' + name + '.png') : ('img/' + name + '.png'); }
  function endStory() {
    var st = storyState;
    storyState = null;
    closeOverlay();
    if (st) { markStorySeen(st.scene.id); if (st.onDone) st.onDone(); }
  }
  function openJournal() {
    var box = panelBox(t('journal'));
    var body = el('div', 'journalbody');
    var any = false;
    window.Story.SCENES.forEach(function (sc) {
      if (!storySeen(sc.id)) return;
      any = true;
      var sec = el('div', 'jscene');
      sc.lines.forEach(function (ln) {
        var ch = window.Story.CHARS[ln[0]];
        sec.appendChild(el('div', 'jline', '<b>' + t(ch.name) + ':</b> ' + t(ln[1])));
      });
      body.appendChild(sec);
    });
    if (!any) body.appendChild(el('div', 'sub', '—'));
    box.panel.appendChild(body);
    box.panel.appendChild(btn(t('back'), '', function () { closeOverlay(); }));
    openOverlay(box.ov);
  }

  /* ================= GARDEN (equipment meta) ================= */
  function activeGarden() { return clamp(save.active_garden || 0, 0, 5); }
  function gardenUnlocked(g) { return totalStars() >= window.Gardens.get(g).unlockStars; }

  function renderGardensMap() {
    var sEl = $('#screen-gardens');
    sEl.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('menu'); }));
    head.appendChild(el('div', 'pageheadtitle', t('gardens_map')));
    head.appendChild(el('div', 'chip', '★ ' + totalStars() + '/600'));
    sEl.appendChild(head);
    var body = el('div', 'mapbody');
    window.Gardens.GARDENS.forEach(function (g) {
      var un = gardenUnlocked(g.id);
      var card = el('div', 'mapcard' + (un ? '' : ' locked') + (activeGarden() === g.id ? ' here' : ''));
      card.style.background = 'linear-gradient(160deg,' + g.sky[0] + ',' + g.ground[1] + ')';
      var inn = el('div', 'mapinfo');
      inn.innerHTML = '<b>' + t(g.key + '_n') + '</b><div class="sub">' + t(g.key + '_d') + '</div>' +
        '<div class="bloombar small"><div style="width:' + bloomOf(g.id) + '%"></div><span>' + bloomOf(g.id) + '%</span></div>';
      card.appendChild(inn);
      if (!un) card.appendChild(el('div', 'chip small', t('need_stars', { n: g.unlockStars })));
      else card.appendChild(btn(activeGarden() === g.id ? t('current') : t('visit'), 'small ' + (activeGarden() === g.id ? 'green' : 'gold'), function () {
        save.active_garden = g.id; persist();
        showScreen('garden');
      }));
      body.appendChild(card);
    });
    sEl.appendChild(body);
  }

  function renderGarden() {
    var gId = activeGarden();
    var g = window.Gardens.get(gId);
    var sEl = $('#screen-garden');
    sEl.innerHTML = '';
    var head = el('div', 'pagehead');
    head.appendChild(btn(t('back'), 'small', function () { showScreen('gardens'); }));
    head.appendChild(el('div', 'pageheadtitle', t(g.key + '_n')));
    head.appendChild(el('div', 'chip', '<img class="coinmini" src="img/coin.png" alt=""> ' + save.coins));
    sEl.appendChild(head);
    var nav = el('div', 'pagenav');
    nav.appendChild(btn('◀', 'small', function () { switchGarden(-1); }));
    nav.appendChild(el('div', 'pagechip', (gId + 1) + ' / 6'));
    nav.appendChild(btn('▶', 'small', function () { switchGarden(1); }));
    nav.appendChild(btn('📷', 'small', function () { photoGarden(); }));
    sEl.appendChild(nav);
    var wrap = el('div', 'gardenview');
    wrap.innerHTML = '<canvas id="gardenCanvas"></canvas>' +
      '<div class="bloombar"><div id="bloomFill"></div><span id="bloomLabel"></span></div>';
    sEl.appendChild(wrap);
    var bl = el('div', 'blessline ' + (bless(gId) ? 'on' : ''),
      (bless(gId) ? '✨ ' + t('blessing_on') + ' ' : t('blessing_off') + ': ') + t(g.bless + '_d'));
    sEl.appendChild(bl);
    var body = el('div', 'gardenbody');
    if (save.guest && !save.guest.claimed) {
      var gu = save.guest;
      var gcard = el('div', 'guestcard');
      gcard.innerHTML = '<img src="img/' + (window.Story.CHARS[gu.char].img) + '.png" alt="">' +
        '<div class="eqinfo"><b>' + t('char_' + gu.char) + '</b><div class="sub">' +
        t('guest_order', { color: t('color_' + gu.color), a: gu.progress, b: gu.target }) + '</div>' +
        '<div class="progressbar" style="margin-top:5px"><div style="width:' + Math.round(gu.progress / gu.target * 100) + '%"></div></div></div>';
      if (gu.done) gcard.appendChild(btn(t('guest_claim'), 'small gold', function () { guestClaim(); }));
      body.appendChild(gcard);
    }
    g.objs.forEach(function (eq) {
      var lvl = equipLvlG(gId, eq.id);
      var card = el('div', 'eqcard');
      var art = el('div', 'eqart');
      art.innerHTML = '<img src="img/' + eq.img + '.png" alt="">';
      card.appendChild(art);
      var info = el('div', 'eqinfo');
      var nm = t('obj_' + eq.id + '_n');
      info.appendChild(el('div', 'eqname', nm + ' <span class="eqpips">' + pips(lvl) + '</span>'));
      info.appendChild(el('div', 'sub', t('obj_' + eq.id + '_d')));
      card.appendChild(info);
      if (lvl >= 2) {
        card.appendChild(el('div', 'chip small green', t('eq_max')));
      } else {
        var cost = eq.cost[lvl];
        card.appendChild(btn((lvl === 0 ? t('eq_buy') : t('eq_upgrade')) + ' — ' + cost + ' 🪙', 'small gold', function () {
          if (save.coins >= cost) {
            save.coins -= cost;
            if (!save.garden_equip[String(gId)]) save.garden_equip[String(gId)] = {};
            save.garden_equip[String(gId)][eq.id] = lvl + 1;
            persist(); checkAchievements(); Sound.coin();
            gardenPop[eq.id] = performance.now();
            renderGarden();
          } else toast(t('not_enough_coins'));
        }));
      }
      body.appendChild(card);
    });
    sEl.appendChild(body);
    layoutGarden();
    updateBloomBar();
  }
  function switchGarden(dir) {
    var cur = activeGarden();
    var next = (cur + dir + 6) % 6;
    var guard = 0;
    while (!gardenUnlocked(next) && guard < 6) { next = (next + dir + 6) % 6; guard++; }
    if (gardenUnlocked(next)) { save.active_garden = next; persist(); renderGarden(); }
    else toast(t('need_stars', { n: window.Gardens.get(next).unlockStars }));
  }
  function updateBloomBar() {
    var f = $('#bloomFill'), l = $('#bloomLabel');
    var b = bloomOf(activeGarden());
    if (f) f.style.width = b + '%';
    if (l) l.textContent = t('bloom_label') + ': ' + b + '%';
  }
  function layoutGarden() {
    var cv = $('#gardenCanvas');
    if (!cv) return;
    var w = cv.parentNode.clientWidth;
    var h = Math.round(w * 0.62);
    var d = Math.min(2, window.devicePixelRatio || 1);
    cv.width = Math.floor(w * d); cv.height = Math.floor(h * d);
    cv.style.width = w + 'px'; cv.style.height = h + 'px';
  }

  /* ---------------- living garden scene (themed per garden) ---------------- */
  var grng = ME.makeRng(777);
  var FLOWER_COLS = ['#ef6fae', '#f2c530', '#e74c3c', '#c99cff', '#ffffff', '#f08a2e'];
  var GFLOWERS = [];
  (function () {
    for (var i = 0; i < 70; i++) {
      GFLOWERS.push({ x: grng(), y: grng(), c: Math.floor(grng() * 6), s: 0.6 + grng() * 0.8, bed: grng() < 0.5 ? 0 : 1 });
    }
  })();
  function lerpColor(a, b, t) {
    function hx(cc) { return [parseInt(cc.slice(1, 3), 16), parseInt(cc.slice(3, 5), 16), parseInt(cc.slice(5, 7), 16)]; }
    var A = hx(a), B = hx(b);
    return 'rgb(' + Math.round(A[0] + (B[0] - A[0]) * t) + ',' + Math.round(A[1] + (B[1] - A[1]) * t) + ',' + Math.round(A[2] + (B[2] - A[2]) * t) + ')';
  }
  function renderGardenScene(dt) {
    var cv = $('#gardenCanvas');
    if (!cv || !cv.width) return;
    var c = cv.getContext('2d');
    var d = Math.min(2, window.devicePixelRatio || 1);
    var W = cv.width / d, H = cv.height / d;
    c.setTransform(d, 0, 0, d, 0, 0);
    var gId = activeGarden();
    var th = window.Gardens.get(gId);
    var bl = bloomOf(gId) / 100;
    var mist = clamp(0.62 - bl * 0.72, 0, 0.62);
    var night = gId === 5;
    var t = gardenT;

    var sky = c.createLinearGradient(0, 0, 0, H * 0.62);
    sky.addColorStop(0, mist > 0.3 ? th.skyGray[0] : th.sky[0]);
    sky.addColorStop(1, mist > 0.3 ? th.skyGray[1] : th.sky[1]);
    c.fillStyle = sky; c.fillRect(0, 0, W, H * 0.62);
    if (night && mist < 0.3) { // stars + moon
      c.fillStyle = '#fff';
      for (var si = 0; si < 24; si++) {
        var sx = ((si * 137) % 100) / 100 * W, sy = ((si * 61) % 55) / 100 * H;
        c.globalAlpha = 0.4 + 0.5 * Math.abs(Math.sin(t * 1.5 + si));
        c.fillRect(sx, sy, 2, 2);
      }
      c.globalAlpha = 1;
      c.fillStyle = '#fff6c8';
      c.beginPath(); c.arc(W * 0.82, H * 0.12, W * 0.045, 0, 6.29); c.fill();
    } else {
      var sunA = 0.25 + bl * 0.6;
      var sg = c.createRadialGradient(W * 0.5, H * 0.06, 4, W * 0.5, H * 0.06, W * 0.42);
      sg.addColorStop(0, 'rgba(255,246,180,' + sunA + ')');
      sg.addColorStop(1, 'rgba(255,246,180,0)');
      c.fillStyle = sg; c.fillRect(0, 0, W, H * 0.7);
    }

    c.fillStyle = lerpColor(th.hillA[1], th.hillA[0], bl);
    c.beginPath(); c.ellipse(W * 0.22, H * 0.60, W * 0.5, H * 0.22, 0, Math.PI, 0); c.fill();
    c.fillStyle = lerpColor(th.hillB[1], th.hillB[0], bl);
    c.beginPath(); c.ellipse(W * 0.82, H * 0.62, W * 0.55, H * 0.26, 0, Math.PI, 0); c.fill();

    var gr = c.createLinearGradient(0, H * 0.58, 0, H);
    gr.addColorStop(0, lerpColor(th.groundGray[0], th.ground[0], bl));
    gr.addColorStop(1, lerpColor(th.groundGray[1], th.ground[1], bl));
    c.fillStyle = gr; c.fillRect(0, H * 0.58, W, H * 0.42);

    c.fillStyle = lerpColor(th.path[1], th.path[0], bl);
    c.beginPath();
    c.moveTo(W * 0.42, H); c.lineTo(W * 0.58, H); c.lineTo(W * 0.53, H * 0.62); c.lineTo(W * 0.47, H * 0.62);
    c.closePath(); c.fill();

    c.fillStyle = lerpColor(th.fence[1], th.fence[0], bl);
    for (var fx = 0.04; fx < 1; fx += 0.075) {
      c.fillRect(W * fx, H * 0.52, W * 0.028, H * 0.12);
      c.beginPath(); c.arc(W * fx + W * 0.014, H * 0.52, W * 0.014, Math.PI, 0); c.fill();
    }
    c.fillRect(0, H * 0.56, W, H * 0.018);

    var nFl = Math.round(GFLOWERS.length * bl);
    for (var i = 0; i < nFl; i++) {
      var fl = GFLOWERS[i];
      var bx = fl.bed === 0 ? (0.06 + fl.x * 0.30) : (0.64 + fl.x * 0.30);
      var by = 0.66 + fl.y * 0.30;
      var sway = Math.sin(t * 1.6 + i) * 0.008;
      if (gId === 4) drawSnowflake(c, (bx + sway) * W, by * H, (4 + fl.s * 5) * (W / 900));
      else drawFlower(c, (bx + sway) * W, by * H, (6 + fl.s * 7) * (W / 900), th.flowers[fl.c], bl, night);
    }

    // garden-0 story specials
    if (gId === 0) {
      var seenB200 = save.story_seen && save.story_seen.indexOf('b200') >= 0;
      if (equipLvl('fountain') > 0) {
        drawEq(c, 'fountain', W * 0.5, H * 0.66, W * 0.16, t, 1);
        if (!seenB200) drawStatue(c, W * 0.60, H * 0.63, W * 0.07);
      } else {
        drawStatue(c, W * 0.5, H * 0.64, W * 0.085);
      }
      if (seenB200) drawEq(c, 'gold_gnome', W * 0.585, H * 0.66, W * 0.075, t, 1);
      if (storySeen('pro')) drawEq(c, 'char_buto', W * 0.40, H * 0.86, W * 0.085, t, 1);
      if (storySeen('c41')) drawEq(c, 'char_busya', W * 0.33, H * 0.93, W * 0.035, t, 1);
      if (storySeen('c21')) drawBird(c, t, W, H);
    }

    // objects of the active garden
    var objs = gardenObjs(gId);
    for (var oi = 0; oi < objs.length; oi++) {
      var ob = objs[oi];
      var lvl = equipLvlG(gId, ob.id);
      if (lvl < 1) continue;
      var wScale = lvl >= 2 ? 1.12 : 1;
      drawEq(c, ob.img, ob.x * W, ob.y * H, ob.w * W * wScale, t, lvl);
      if (lvl >= 2 && ob.second) drawEq(c, ob.img, ob.second.x * W, ob.second.y * H, ob.w * W * 0.85, t, lvl);
    }

    // owned collection figures wander in every garden
    for (var fi = 0; fi < save.garden_figures.length && fi < 10; fi++) {
      var fid = save.garden_figures[fi];
      var fxp = 0.08 + 0.085 * fi + 0.012 * Math.sin(t * 0.8 + fi * 2);
      drawEq(c, 'fig_' + fid, fxp * W, H * 0.95, W * 0.055, t, 1);
    }

    updateGardenParts(dt, W, H, bl, th.ambient);
    drawGardenParts(c, t, W, H, th);

    if (mist > 0.01) {
      c.fillStyle = 'rgba(150,158,160,' + (mist * 0.75) + ')';
      c.fillRect(0, 0, W, H);
      for (var mI = 0; mI < 3; mI++) {
        var mx = ((t * 0.02 + mI * 0.37) % 1.3 - 0.15) * W;
        var my = (0.25 + mI * 0.2) * H;
        var mg = c.createRadialGradient(mx, my, 10, mx, my, W * 0.35);
        mg.addColorStop(0, 'rgba(140,148,152,' + mist * 0.5 + ')');
        mg.addColorStop(1, 'rgba(140,148,152,0)');
        c.fillStyle = mg; c.fillRect(0, 0, W, H);
      }
    }
    var vg = c.createRadialGradient(W / 2, H / 2, H * 0.35, W / 2, H / 2, H * 0.85);
    vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, night ? 'rgba(0,0,10,0.45)' : 'rgba(0,0,0,0.28)');
    c.fillStyle = vg; c.fillRect(0, 0, W, H);
  }

  function drawFlower(c, x, y, r, col, bl, night) {
    c.strokeStyle = night ? 'rgba(90,140,120,0.8)' : 'rgba(40,110,40,' + (0.4 + bl * 0.6) + ')';
    c.lineWidth = Math.max(1, r * 0.25);
    c.beginPath(); c.moveTo(x, y + r * 2.2); c.lineTo(x, y); c.stroke();
    if (night) { c.shadowColor = col; c.shadowBlur = r * 1.6; }
    c.fillStyle = col;
    for (var a = 0; a < 5; a++) {
      var ang = a * 1.2566;
      c.beginPath(); c.arc(x + Math.cos(ang) * r * 0.75, y + Math.sin(ang) * r * 0.75, r * 0.55, 0, 6.29); c.fill();
    }
    c.shadowBlur = 0;
    c.fillStyle = night ? '#fff6b0' : '#ffe08a';
    c.beginPath(); c.arc(x, y, r * 0.4, 0, 6.29); c.fill();
  }
  function drawSnowflake(c, x, y, r) {
    c.strokeStyle = 'rgba(255,255,255,0.9)'; c.lineWidth = Math.max(1, r * 0.22);
    for (var a = 0; a < 3; a++) {
      var ang = a * 1.0472;
      c.beginPath();
      c.moveTo(x - Math.cos(ang) * r, y - Math.sin(ang) * r);
      c.lineTo(x + Math.cos(ang) * r, y + Math.sin(ang) * r);
      c.stroke();
    }
  }
  var EQ_IMG = { water: 'eq_water', hive: 'eq_hive', greenhouse: 'eq_greenhouse', lantern: 'eq_lantern',
    fountain: 'eq_fountain', scarecrow: 'eq_scarecrow', char_buto: 'gnome_01', char_busya: 'gnome_08',
    gold_gnome: 'gnome_10' };
  function drawEq(c, id, x, y, w, t, lvl) {
    var name = EQ_IMG[id] || id;
    if (id.indexOf('fig_') === 0) name = 'gnome_' + (parseInt(id.slice(4), 10) < 10 ? '0' + id.slice(4) : id.slice(4));
    var im = images[name];
    if (!im || !im.complete || !im.naturalWidth) return;
    var pop = gardenPop[id] ? clamp((performance.now() - gardenPop[id]) / 450, 0, 1) : 1;
    var sc = pop < 1 ? easeOutBack(pop) : 1;
    var bob = (id === 'char_buto' || id === 'gold_gnome' || id.indexOf('fig_') === 0) ? Math.sin(t * 2 + x) * 0.012 : 0;
    var h = w * (im.naturalHeight / im.naturalWidth);
    c.save();
    c.translate(x, y + bob * w);
    c.scale(sc, sc);
    c.globalAlpha = 0.28; c.fillStyle = '#08130a';
    c.beginPath(); c.ellipse(0, h * 0.06, w * 0.42, w * 0.10, 0, 0, 6.29); c.fill();
    c.globalAlpha = 1;
    if (id === 'lantern' || id === 'jlantern') {
      var gl = c.createRadialGradient(0, -h * 0.55, 2, 0, -h * 0.55, w * 0.9);
      gl.addColorStop(0, 'rgba(255,220,120,0.55)'); gl.addColorStop(1, 'rgba(255,220,120,0)');
      c.fillStyle = gl; c.beginPath(); c.arc(0, -h * 0.55, w * 0.9, 0, 6.29); c.fill();
    }
    if (id === 'fountain' || id === 'icefount') {
      c.fillStyle = id === 'icefount' ? 'rgba(190,235,255,0.9)' : 'rgba(140,220,255,0.8)';
      for (var i = 0; i < 7; i++) {
        var ph = (t * 1.4 + i * 0.4) % 1;
        var dx = Math.sin(i * 2.1) * w * 0.30 * ph;
        var dy = -h * 0.75 + ph * ph * h * 0.55;
        c.globalAlpha = 0.85 * (1 - ph);
        c.beginPath(); c.arc(dx, dy, 2.4, 0, 6.29); c.fill();
      }
      c.globalAlpha = 1;
    }
    if (id === 'crystal' || id === 'mushroom' || id === 'jar') {
      c.shadowColor = '#9cf'; c.shadowBlur = 12;
    }
    c.drawImage(im, -w / 2, -h, w, h);
    c.shadowBlur = 0;
    c.restore();
  }
  function drawStatue(c, x, y, w) {
    var im = images['gnome_10'];
    var h = w * 1.0;
    c.save(); c.translate(x, y);
    c.globalAlpha = 0.3; c.fillStyle = '#08130a';
    c.beginPath(); c.ellipse(0, 2, w * 0.45, w * 0.1, 0, 0, 6.29); c.fill();
    c.globalAlpha = 1;
    if (im && im.complete && im.naturalWidth) {
      c.filter = 'grayscale(1) brightness(0.75)';
      c.drawImage(im, -w / 2, -h, w, h);
      c.filter = 'none';
    }
    c.globalAlpha = 0.35; c.fillStyle = '#9aa4a8';
    c.beginPath(); c.ellipse(0, -h * 0.5, w * 0.5, h * 0.55, 0, 0, 6.29); c.fill();
    c.globalAlpha = 1;
    c.restore();
  }
  function drawBird(c, t, W, H) {
    var im = images['gnome_05'];
    if (!im || !im.complete || !im.naturalWidth) return;
    var bx = (0.5 + 0.30 * Math.sin(t * 0.7)) * W;
    var by = (0.24 + 0.06 * Math.sin(t * 1.9)) * H;
    var w = W * 0.055;
    c.save(); c.translate(bx, by);
    c.scale(Math.cos(t * 0.7) > 0 ? 1 : -1, 1);
    c.drawImage(im, -w / 2, -w / 2, w, w);
    c.restore();
  }
  function updateGardenParts(dt, W, H, bl, ambient) {
    var wantPetals = ambient === 'petals' || ambient === 'sakura' ? 4 + Math.round(bl * 8) : (ambient === 'leaves' ? 3 + Math.round(bl * 5) : 0);
    var wantFly = (ambient === 'fireflies' ? 10 : (bl > 0.45 ? 6 : 0));
    var wantBee = equipLvl('hive') > 0 && activeGarden() === 0 ? 2 + equipLvl('hive') * 2 : 0;
    var wantBf = ambient === 'butterflies' ? 2 + Math.round(bl * 3) : 0;
    var wantSnow = ambient === 'snow' ? 26 : 0;
    var count = { petal: 0, fly: 0, bee: 0, bf: 0, snow: 0 };
    for (var i = 0; i < gparts.length; i++) count[gparts[i].k]++;
    function push(k) {
      if (gparts.length > 70) return;
      if (k === 'petal') gparts.push({ k: k, x: Math.random(), y: -0.05, vx: 0.02 + Math.random() * 0.03, vy: 0.05 + Math.random() * 0.06, r: Math.random() * 6.28, s: 2 + Math.random() * 3, col: ambient === 'sakura' ? '#ffb7ce' : FLOWER_COLS[Math.floor(Math.random() * 6)] });
      if (k === 'leaves') gparts.push({ k: 'petal', x: Math.random(), y: -0.05, vx: 0.03 + Math.random() * 0.03, vy: 0.07 + Math.random() * 0.05, r: Math.random() * 6.28, s: 2.5 + Math.random() * 3, col: Math.random() < 0.5 ? '#8aab4f' : '#d9a43c' });
      if (k === 'fly') gparts.push({ k: k, x: Math.random(), y: 0.3 + Math.random() * 0.6, vx: (Math.random() - 0.5) * 0.04, vy: (Math.random() - 0.5) * 0.03, r: Math.random() * 6.28 });
      if (k === 'bee') gparts.push({ k: k, x: 0.86, y: 0.5, a: Math.random() * 6.28, sp: 1 + Math.random() });
      if (k === 'bf') gparts.push({ k: k, x: Math.random(), y: 0.4 + Math.random() * 0.5, a: Math.random() * 6.28, sp: 0.6 + Math.random(), col: FLOWER_COLS[Math.floor(Math.random() * 6)] });
      if (k === 'snow') gparts.push({ k: k, x: Math.random(), y: -0.05, vx: (Math.random() - 0.5) * 0.02, vy: 0.03 + Math.random() * 0.04, s: 1.5 + Math.random() * 2 });
    }
    if (count.petal < wantPetals && Math.random() < 0.3) push(ambient === 'leaves' ? 'leaves' : 'petal');
    if (count.fly < wantFly && Math.random() < 0.1) push('fly');
    if (count.bee < wantBee && Math.random() < 0.2) push('bee');
    if (count.bf < wantBf && Math.random() < 0.1) push('bf');
    if (count.snow < wantSnow && Math.random() < 0.6) push('snow');
    for (var j = gparts.length - 1; j >= 0; j--) {
      var g = gparts[j];
      if (g.k === 'petal') { g.x += g.vx * dt; g.y += g.vy * dt; g.r += dt * 2; if (g.y > 1.05) gparts.splice(j, 1); }
      else if (g.k === 'snow') { g.x += g.vx * dt + Math.sin(gardenT * 2 + g.y * 9) * 0.0004; g.y += g.vy * dt; if (g.y > 1.05) gparts.splice(j, 1); }
      else if (g.k === 'fly') { g.x += g.vx * dt; g.y += g.vy * dt; if (g.x < -0.05 || g.x > 1.05 || g.y < 0 || g.y > 1.05) gparts.splice(j, 1); }
      else if (g.k === 'bee') { g.a += dt * g.sp * 2; g.x = 0.86 + Math.cos(g.a) * 0.07; g.y = 0.5 + Math.sin(g.a * 1.3) * 0.06; }
      else if (g.k === 'bf') { g.a += dt * g.sp; g.x += Math.cos(g.a) * 0.0012; g.y += Math.sin(g.a * 1.7) * 0.001; if (g.x < -0.05 || g.x > 1.05) gparts.splice(j, 1); }
    }
  }
  function drawGardenParts(c, t, W, H, th) {
    for (var pi = 0; pi < gparts.length; pi++) {
      var gp = gparts[pi];
      if (gp.k === 'petal') {
        c.globalAlpha = 0.75; c.fillStyle = gp.col;
        c.save(); c.translate(gp.x * W, gp.y * H); c.rotate(gp.r);
        c.beginPath(); c.ellipse(0, 0, gp.s, gp.s * 0.6, 0, 0, 6.29); c.fill(); c.restore();
      } else if (gp.k === 'snow') {
        c.globalAlpha = 0.9; c.fillStyle = '#fff';
        c.beginPath(); c.arc(gp.x * W, gp.y * H, gp.s, 0, 6.29); c.fill();
      } else if (gp.k === 'fly') {
        c.globalAlpha = 0.5 + 0.5 * Math.sin(t * 6 + gp.r);
        c.fillStyle = '#fff6b0';
        c.beginPath(); c.arc(gp.x * W, gp.y * H, 2.2, 0, 6.29); c.fill();
        c.globalAlpha = 0.22;
        c.beginPath(); c.arc(gp.x * W, gp.y * H, 6, 0, 6.29); c.fill();
      } else if (gp.k === 'bee') {
        c.globalAlpha = 1; c.fillStyle = '#ffd76a';
        c.beginPath(); c.arc(gp.x * W, gp.y * H, 3, 0, 6.29); c.fill();
        c.fillStyle = '#332';
        c.fillRect(gp.x * W - 1, gp.y * H - 3, 2, 6);
      } else if (gp.k === 'bf') {
        var fl = Math.abs(Math.sin(t * 9 + gp.a));
        c.globalAlpha = 0.9; c.fillStyle = gp.col;
        c.save(); c.translate(gp.x * W, gp.y * H);
        c.beginPath(); c.ellipse(-3, 0, 4 * fl + 1, 3, -0.5, 0, 6.29); c.fill();
        c.beginPath(); c.ellipse(3, 0, 4 * fl + 1, 3, 0.5, 0, 6.29); c.fill();
        c.fillStyle = '#332'; c.fillRect(-1, -3, 2, 6);
        c.restore();
      }
    }
    c.globalAlpha = 1;
  }
  function pips(lvl) { var s = ''; for (var i = 0; i < 2; i++) s += i < lvl ? '★' : '☆'; return s; }
  // 0..100 — garden 0 bloom (campaign + stars + equipment + epilogue)
  function bloom0() {
    var b = 0;
    b += clamp(save.campaign_progress, 1, 200) / 200 * 55;
    b += totalStars() / 600 * 20;
    var eqSum = 0;
    for (var i = 0; i < EQUIP.length; i++) eqSum += equipLvl(EQUIP[i].id);
    b += eqSum / 12 * 20;
    if (save.story_seen && save.story_seen.indexOf('b200') >= 0) b = Math.max(b, 100);
    return Math.round(clamp(b, 0, 100));
  }
  function bloom() { return bloomOf(save.active_garden || 0); }
  var gardenPop = {};   // id -> timestamp of purchase pop
  var gparts = [];      // garden ambient particles
  var gardenT = 0;

  /* ================= TUTORIAL ================= */
  function setupTutorial() {
    G.tutActive = true;
    G.tutStep = 1;
    G.tutMove = ME.findFirstMove(G.grid);
    if (!G.tutMove) { ME.shuffleGrid(G.grid, levelRng); G.tutMove = ME.findFirstMove(G.grid); }
    showTutBanner(t('tut_step1'), null, null);
  }
  function showTutBanner(text, btnLabel, onBtn) {
    hideTutBanner();
    var b = el('div', 'tutbanner');
    b.id = 'tutBanner';
    b.innerHTML = '<div class="tuttext">' + text + '</div>';
    if (btnLabel) {
      var bb = btn(btnLabel, 'small green', function () { onBtn && onBtn(); });
      b.appendChild(bb);
    }
    var skip = el('button', 'tutskip', t('tut_skip'));
    skip.addEventListener('click', function () { finishTutorial(); });
    b.appendChild(skip);
    var gs = $('#screen-game');
    if (gs) gs.appendChild(b);
  }
  function hideTutBanner() {
    var old = $('#tutBanner');
    if (old && old.parentNode) old.parentNode.removeChild(old);
  }
  function tutAfterMove() {
    if (G.tutStep === 1) {
      G.tutStep = 2;
      G.tutMove = null;
      showTutBanner(t('tut_step2'), t('tut_next'), function () {
        G.tutStep = 3;
        showTutBanner(t('tut_step3'), t('tut_done'), function () { finishTutorial(); });
      });
      persist();
    } else if (G.tutStep >= 3) {
      // free play during step 3 banner — normal checks
      if (isGoalComplete()) { finishTutorialSilent(); winLevel(); return; }
      if (G.moves <= 0) { finishTutorialSilent(); loseLevel(); return; }
    }
  }
  function finishTutorialSilent() { G.tutActive = false; G.tutStep = 0; hideTutBanner(); save.tutorial_done = true; persist(); }
  function finishTutorial() {
    finishTutorialSilent();
    if (isGoalComplete()) winLevel();
    else if (G.moves <= 0) loseLevel();
  }

  /* ================= PLATFORM WIRING ================= */
  var autoPauseOverlay = false;
  function wirePlatform() {
    try {
      P.on('pause', function () {
        if (G.screen === 'game' && !overlayOpen()) { setPausedRaw(true); autoPauseOverlay = true; showPauseOverlay(); }
        else setPausedRaw(true);
      });
      P.on('resume', function () {
        if (autoPauseOverlay && overlayOpen()) { closeOverlay(); autoPauseOverlay = false; }
        if (!overlayOpen()) { setPausedRaw(false); Sound.resume(); }
      });
      P.on('mute', function () { Sound.suspend(); });
      P.on('unmute', function () { Sound.resume(); });
    } catch (e) { /* adapter without events */ }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        if (G.screen === 'game' && !overlayOpen()) { setPausedRaw(true); showPauseOverlay(); }
        else setPausedRaw(true);
      } else if (!overlayOpen()) {
        setPausedRaw(false);
        Sound.resume();
      }
    });
    window.addEventListener('blur', function () {
      if (G.screen === 'game' && !overlayOpen()) { setPausedRaw(true); }
    });
    window.addEventListener('resize', function () { layout(); layoutGarden(); });
    window.addEventListener('orientationchange', function () { setTimeout(layout, 250); });

    // [8] block zoom / context menu / selection
    document.addEventListener('contextmenu', function (e) { e.preventDefault(); });
    document.addEventListener('selectstart', function (e) { e.preventDefault(); });
    document.addEventListener('dblclick', function (e) { e.preventDefault(); });
    document.addEventListener('touchstart', function (e) { if (e.touches && e.touches.length > 1) e.preventDefault(); }, { passive: false });
    document.addEventListener('gesturestart', function (e) { e.preventDefault(); });
  }

  function registerSW() {
    try {
      if ('serviceWorker' in navigator && location.protocol.indexOf('http') === 0) {
        navigator.serviceWorker.register('sw.js').catch(function () { /* offline cache optional */ });
      }
    } catch (e) { /* noop */ }
  }

  /* ================= BOT (for QA & promo video) ================= */
  var botTimer = null;
  function startBot(speed) {
    stopBot();
    function loop() {
      botTimer = setTimeout(function () {
        try {
          if (!paused && G.screen === 'game' && !overlayOpen()) {
            if (G.phase === 'idle' && !G.tutActive) {
              var mv = ME.findFirstMove(G.grid);
              if (mv) trySwap(mv[0], mv[1]);
            } else if (G.phase === 'idle' && G.tutActive && G.tutMove) {
              trySwap(G.tutMove[0], G.tutMove[1]);
            }
          } else if (overlayOpen()) {
            var g = document.querySelector('#overlayRoot .btn.green');
            if (g) g.click();
          }
        } catch (e) { /* keep bot alive */ }
        loop();
      }, (speed || 1) * (260 + Math.random() * 400));
    }
    loop();
  }
  function stopBot() { if (botTimer) { clearTimeout(botTimer); botTimer = null; } }

  /* ================= BOOT ================= */
  function boot() {
    buildShell();
    showScreen('loading');
    var params = {};
    try {
      var qs = new URLSearchParams(window.location.search);
      qs.forEach(function (v, k) { params[k] = v; });
    } catch (e) { /* noop */ }

    loadAssets(function (p) {
      var f = $('#loadFill'); if (f) f.style.width = Math.round(p * 100) + '%';
      var pc = $('#loadPct'); if (pc) pc.textContent = Math.round(p * 100) + '%';
    }).then(function () {
      var vk = window.VKBridgeAdapter;
      if (vk && vk.detect && vk.detect()) {
        return vk.init().catch(function () { return false; }).then(function (ok) { return ok ? 'vk' : 'local'; });
      }
      var gpOkPromise;
      try { gpOkPromise = window.GamePushAdapter.init(); } catch (e) { gpOkPromise = Promise.resolve(false); }
      return gpOkPromise.catch(function () { return false; }).then(function (gpOk) { return gpOk ? 'gp' : 'local'; });
    }).then(function (which) {
      P = which === 'vk' ? window.VKBridgeAdapter : (which === 'gp' ? window.GamePushAdapter : window.LocalAdapter);
      var cloudP;
      try { cloudP = Promise.resolve(P.load()); } catch (e) { cloudP = Promise.resolve(null); }
      return cloudP.catch(function () { return null; }).then(function (cloud) {
        var local = loadLocal();
        var migrated = installSave(cloud, local);
        var conflict = false;
        if (cloud && local && cloud.schema_version === SCHEMA && local.schema_version === SCHEMA) {
          var dp = Math.abs((cloud.campaign_progress || 1) - (local.campaign_progress || 1));
          var dStars = Math.abs(starsOf(cloud) - starsOf(local));
          conflict = dp > 10 || dStars > 30;
        }
        if (conflict) pendingConflict = { cloud: cloud, local: local, choseCloud: starsOf(cloud) + (cloud.campaign_progress || 0) >= starsOf(local) + (local.campaign_progress || 0) };

        var lang = save.settings.lang || '';
        if (!lang) { try { lang = P.getLang() || 'en'; } catch (e) { lang = 'en'; } }
        if (params.lang) lang = params.lang;
        setLang(String(lang).slice(0, 2).toLowerCase() === 'ru' ? 'ru' : 'en');
        applyPrefs();
        registerSW();

        Sound.enabled = save.settings.sound !== false;
        Sound.musicEnabled = save.settings.music !== false;

        try { P.ready(); } catch (e) { /* noop */ }
        wirePlatform();
        G.sessionStart = Date.now();
        G.playSegmentStart = Date.now();

        requestAnimationFrame(frame);
        ensureQuests();
        if (params.notut) { save.tutorial_done = true; }
        if (params.nostory) { G.storyOff = true; }
        if (params.level) { startLevel(parseInt(params.level, 10) || 1); }
        else if (params.daily) { startLevel(0, { daily: true }); }
        else showScreen('menu');
        if (migrated) toast(t('msg_migrated'));
        if (pendingConflict) showConflictDialog(pendingConflict);
        if (params.bot) startBot(parseFloat(params.bot) || 1);
        window.ggReady = true;
        window.dispatchEvent(new Event('gg-ready'));
      });
    }).catch(function (err) {
      // never leave a blank screen
      try {
        P = window.LocalAdapter;
        installSave(null, loadLocal());
        setLang('en');
        wirePlatform();
        requestAnimationFrame(frame);
        showScreen('menu');
        window.ggReady = true;
        window.dispatchEvent(new Event('gg-ready'));
      } catch (e2) {
        var ld = $('#screen-loading');
        if (ld) ld.innerHTML = '<div class="panel"><b>Error</b><br>' + (err && err.message ? err.message : '') + '</div>';
      }
    });

    // first user gesture unlocks audio
    var unlock = function () {
      Sound.init();
      if (save.settings.music !== false) Sound.refreshMusic();
      document.removeEventListener('pointerdown', unlock);
      document.removeEventListener('keydown', unlock);
    };
    document.addEventListener('pointerdown', unlock);
    document.addEventListener('keydown', unlock);
  }

  /* ================= PUBLIC / TEST API ================= */
  var api = {
    version: '1.1.0',
    t: t,
    setLang: function (l) { setLang(l); showScreen(G.screen); },
    getLang: function () { return LANG; },
    getSave: function () { return save; },
    setSaveField: function (k, v) { save[k] = v; persist(); },
    G: G,
    ME: ME,
    LG: LG,
    Sound: Sound,
    images: images,
    P: function () { return P; },
    startLevel: startLevel,
    trySwap: trySwap,
    toast: toast,
    showScreen: showScreen,
    getState: function () {
      return {
        screen: G.screen, phase: G.phase, level: G.levelNum, daily: G.isDaily,
        moves: G.moves, movesUsed: G.movesUsed, score: G.score,
        maxCascade: G.maxCascade, collected: G.collected,
        blocksDone: G.blocksDone, blocksTotal: G.blocksTotal,
        delivered: G.delivered, deliveredTotal: G.deliveredTotal,
        gems: countGems(), resolving: resolving, paused: paused,
        overlay: overlayOpen(), tut: G.tutActive, tutStep: G.tutStep,
        goal: G.level ? G.level.goal : null, winShown: G.winShown, loseShown: G.loseShown
      };
    },
    botMove: function () {
      if (G.phase !== 'idle' || paused || overlayOpen() || !G.grid) return false;
      if (G.tutActive && G.tutMove) return trySwap(G.tutMove[0], G.tutMove[1]);
      var mv = ME.findFirstMove(G.grid, G.portalPairs);
      if (!mv) return false;
      return trySwap(mv[0], mv[1]);
    },
    testTap: function (r, c) {
      if (G.phase !== 'idle' || paused || overlayOpen() || !G.grid) return false;
      var cell = G.grid[r][c];
      if (!cell || cell.t !== T.GEM) return false;
      if (cell.sp !== SP.NONE) { G.selected = null; tapActivateSpecial(r, c); return true; }
      if (G.selected && ME.areAdjacent(G.selected, [r, c])) {
        var s = G.selected; G.selected = null;
        return trySwap(s, [r, c]);
      }
      G.selected = [r, c];
      return true;
    },
    ensureMoves: function () { return ensureMovesAvailable(); },
    bloom: bloom,
    ghostNext: ghostNext,
    countChoc: countChoc,
    isPortalPair: isPortalPair,
    setEvent: function (id) { G.eventOverride = id; },
    currentEvent: function () { return currentEvent(); },
    guestSpawn: guestSpawn,
    guestClaim: guestClaim,
    startEndless: startEndless,
    endlessCfg: endlessCfg,
    endlessUnlocked: endlessUnlocked,
    requestLevel: requestLevel,
    ensureQuests: ensureQuests,
    questsClaimable: questsClaimable,
    chestReady: chestReady,
    openChest: openChest,
    setFast: function (v) { save.settings.fast = !!v; persist(); },
    photoGarden: photoGarden,
    weekKey: weekKey,
    applyPrefs: applyPrefs,
    bloomOf: bloomOf,
    bless: bless,
    activeGarden: activeGarden,
    gardenUnlocked: gardenUnlocked,
    setSpeed: function (v) { timeScale = Math.max(0.1, v || 1); },
    findMove: function () { return G.grid ? ME.findFirstMove(G.grid, G.portalPairs) : null; },
    startBot: startBot,
    stopBot: stopBot,
    getFps: function () { return fpsStats.fps; },
    isPaused: function () { return paused; },
    tweenCount: function () { return tweens.length; },
    particleCount: function () { return particles.length; },
    goalProgress: goalProgress,
    dailyAvailable: dailyAvailable,
    totalStars: totalStars,
    checkAchievements: checkAchievements,
    persist: persist,
    closeOverlay: closeOverlay,
    winLevel: winLevel,
    boot: boot
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  return api;
})();

;

</script>
</body>
</html>
