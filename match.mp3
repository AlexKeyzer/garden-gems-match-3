/* ==== platform-local.js ==== */
/* ============================================================
 * Garden Gems — LocalAdapter (debug / fallback without SDK)
 * Full PlatformAdapter interface. No network, no ads — mocks.
 * ============================================================ */
(function () {
  'use strict';
  var LS_KEY = 'gg_save_v1';

  var handlers = {};
  function emit(ev, arg) {
