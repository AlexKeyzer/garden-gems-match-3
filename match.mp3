/* ==== platform-vk.js ==== */
/* ============================================================
 * Garden Gems — VKBridgeAdapter (VK Games / VK Mini Apps)
 * Vendor: @vkontakte/vk-bridge 3.0.2 (MIT), file vk-bridge.js
 * in the build root exposes window.vkBridge.
 *
 * Platform-ads model (chosen by the publisher): the game does NOT
 * trigger interstitial/rewarded itself — VK/AppsCentrum shows ads on
 * its own pauses. Therefore interstitial() is a no-op success and
 * rewarded() gracefully reports "unavailable" (every rewarded button
 * in the game has a free alternative: retry, coins, boosters).
 *
 * Used bridge methods (all defensive, try/catch + promise catch):
 *   VKWebAppInit                 — mandatory init handshake
 *   VKWebAppGetConfig            — user language
 *   VKWebAppStorageSet/Get       — cloud save per VK user
 *   events VKWebAppViewHide / VKWebAppViewRestore — pause/resume
 * ============================================================ */
(function () {
  'use strict';

  var handlers = {};
  function emit(ev, arg) {
    var list = handlers[ev];
    if (list) for (var i = 0; i < list.length; i++) { try { list[i](arg); } catch (e) { /* noop */ } }
  }
  function bridge() { return window.vkBridge || null; }
  function send(type, params) {
    var b = bridge();
    if (!b || !b.send) return Promise.reject(new Error('no bridge'));
    try {
      var p = b.send(type, params);
      return Promise.resolve(p).catch(function (e) { throw e; });
    } catch (e) { return Promise.reject(e); }
  }

  window.VKBridgeAdapter = {
    name: 'vk',
    _lang: '',
    _unsub: null,

    detect: function () {
      if (bridge()) return true;
      try {
        if (/[?&]vk_app_id=/.test(location.search)) return true;
        if (/vk\.com|vk.ru/.test(document.referrer)) return true;
      } catch (e) { /* noop */ }
      return false;
    },

    init: function () {
      var self = this;
      if (!this.detect()) return Promise.resolve(false);
      return send('VKWebAppInit').catch(function () { /* still inside VK web? */ }).then(function () {
        try {
          var b = bridge();
          if (b && b.subscribe) {
            self._unsub = b.subscribe(function (e) {
              if (!e || !e.type) return;
              if (e.type === 'VKWebAppViewHide') emit('pause');
              if (e.type === 'VKWebAppViewRestore') emit('resume');
            });
          } else if (b && b.on) {
            b.on('VKWebAppViewHide', function () { emit('pause'); });
            b.on('VKWebAppViewRestore', function () { emit('resume'); });
          }
        } catch (e) { /* noop */ }
        return send('VKWebAppGetConfig').then(function (cfg) {
          var l = (cfg && (cfg.lang || cfg.language)) || '';
          self._lang = String(l).slice(0, 2).toLowerCase();
          return true;
        }).catch(function () { true; });
      });
    },

    ready: function () { /* VK has no gameStart analogue; platform tracks session */ },
    gameplayStart: function () { },
    gameplayStop: function () { },

    on: function (ev, cb) { (handlers[ev] = handlers[ev] || []).push(cb); },
    off: function (ev, cb) {
      var list = handlers[ev]; if (!list) return;
      var i = list.indexOf(cb); if (i >= 0) list.splice(i, 1);
    },

    /* platform-ads model: no self-triggered ads */
    interstitial: function (cbOk) { setTimeout(function () { if (cbOk) cbOk(); }, 30); },
    rewarded: function (cbReward, cbClose, cbErr) {
      setTimeout(function () { if (cbErr) cbErr(new Error('platform ads model')); }, 30);
    },

    save: function (data) {
      send('VKWebAppStorageSet', { key: 'gg_save_v1', value: JSON.stringify(data) }).catch(function () { /* localStorage mirror remains */ });
    },
    load: function () {
      return send('VKWebAppStorageGet', { keys: ['gg_save_v1'] }).then(function (r) {
