<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#123a12">
<title>Garden Gems: Match 3</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;overscroll-behavior:none;touch-action:none;
  font-family:"Trebuchet MS",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  background:#0d2c10;color:#fff;user-select:none;-webkit-user-select:none}
#bg{position:fixed;inset:0;background-color:#1d4a1d;background-size:cover;background-position:center;
  background-image:linear-gradient(160deg,#2f7a2f 0%,#1d5a22 45%,#123f18 100%);z-index:0;
  animation:bgBreath 14s ease-in-out infinite alternate}
@keyframes bgBreath{from{transform:scale(1)}to{transform:scale(1.045)}}
#bg::after{content:"";position:absolute;inset:0;
  background:radial-gradient(120% 80% at 50% -10%,rgba(255,246,190,.22),rgba(0,0,0,0) 55%),
             radial-gradient(140% 100% at 50% 110%,rgba(0,0,0,.42),rgba(0,0,0,0) 60%)}
/* ambient petals & fireflies */
#ambient{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.petal{position:absolute;top:-6%;animation:fall linear infinite;color:#ffd3e0;
  text-shadow:0 0 6px rgba(255,180,200,.5);filter:saturate(1.2)}
@keyframes fall{0%{transform:translateY(-8vh) rotate(0deg) translateX(0)}
  25%{transform:translateY(22vh) rotate(90deg) translateX(6vw)}
  50%{transform:translateY(50vh) rotate(200deg) translateX(-4vw)}
  75%{transform:translateY(78vh) rotate(300deg) translateX(5vw)}
  100%{transform:translateY(112vh) rotate(390deg) translateX(0)}}
.firefly{position:absolute;width:5px;height:5px;border-radius:50%;background:#fff6b0;
  box-shadow:0 0 10px 3px rgba(255,240,150,.75);animation:fly ease-in-out infinite alternate}
@keyframes fly{from{transform:translate(0,0);opacity:.15}
  30%{opacity:.9}to{transform:translate(9vw,-7vh);opacity:.2}}
#ui{position:fixed;inset:0;z-index:2}
.screen{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;
  padding:calc(10px + env(safe-area-inset-top)) 12px calc(10px + env(safe-area-inset-bottom));overflow:hidden}
.screen.active{display:flex}
.panel{background:linear-gradient(180deg,rgba(28,66,30,.94),rgba(14,40,17,.96));
  border:2px solid rgba(255,215,110,.35);border-radius:22px;
  padding:16px;box-shadow:0 14px 40px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.14);max-height:100%}
.panel.big{width:min(420px,92vw);display:flex;flex-direction:column;gap:10px;align-items:stretch;text-align:center;position:relative;overflow:hidden}
.panel.big::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(90% 40% at 50% 0%,rgba(255,240,170,.14),rgba(0,0,0,0))}
.paneltitle{font-size:23px;font-weight:800;letter-spacing:.3px;
  text-shadow:0 2px 0 rgba(60,30,0,.5),0 4px 12px rgba(0,0,0,.5)}
.title-small{font-size:18px;font-weight:700;margin-bottom:10px;text-align:center}
.btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;cursor:pointer;
  font:inherit;font-weight:800;color:#fff;
  background:linear-gradient(180deg,#79c247 0%,#4d9230 52%,#3c7a24 53%,#2f6a1c 100%);
  border-radius:16px;padding:12px 18px;font-size:16px;
  box-shadow:0 4px 0 #1e4a12,0 8px 18px rgba(0,0,0,.42),inset 0 2px 0 rgba(255,255,255,.35);
  transition:transform .06s,filter .12s;text-shadow:0 1px 2px rgba(0,0,0,.45);min-height:44px;overflow:hidden}
.btn::after{content:"";position:absolute;left:8%;right:8%;top:6%;height:38%;border-radius:12px;
  background:linear-gradient(180deg,rgba(255,255,255,.42),rgba(255,255,255,.05));pointer-events:none}
.btn:hover{filter:brightness(1.07)}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 #1e4a12,0 4px 10px rgba(0,0,0,.35),inset 0 2px 0 rgba(255,255,255,.3)}
.btn.green{background:linear-gradient(180deg,#8ede5a 0%,#57a533 52%,#468c27 53%,#35701b 100%);box-shadow:0 4px 0 #24520f,0 8px 18px rgba(0,0,0,.42),inset 0 2px 0 rgba(255,255,255,.4)}
.btn.gold{background:linear-gradient(180deg,#ffe08a 0%,#f0b23c 52%,#dd9a22 53%,#c07f10 100%);color:#5a3a00;
  box-shadow:0 4px 0 #8a5c00,0 8px 18px rgba(0,0,0,.42),inset 0 2px 0 rgba(255,255,255,.55);text-shadow:0 1px 0 rgba(255,255,255,.35)}
.btn.red{background:linear-gradient(180deg,#ef8a70 0%,#c94f38 52%,#b8402e 53%,#93301f 100%);box-shadow:0 4px 0 #611f13,0 8px 18px rgba(0,0,0,.42),inset 0 2px 0 rgba(255,255,255,.35)}
.btn.small{padding:8px 12px;font-size:14px;border-radius:12px;min-height:36px}
.btn.big{font-size:19px;padding:15px 22px}
.btn.disabled{filter:grayscale(.7) brightness(.75)}
.btn.pulse{animation:pulse 1.6s infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.045)}}
.btnicon{width:22px;height:22px;object-fit:contain;filter:drop-shadow(0 1px 2px rgba(0,0,0,.5))}
.coinmini{width:18px;height:18px;vertical-align:-3px}
.sub{font-size:13px;opacity:.85;line-height:1.45;text-shadow:0 1px 2px rgba(0,0,0,.5)}
.chip{background:linear-gradient(180deg,rgba(20,50,22,.85),rgba(8,28,10,.9));
  border:1px solid rgba(255,215,110,.4);border-radius:13px;
  padding:5px 10px;font-size:13px;font-weight:800;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 3px 8px rgba(0,0,0,.35)}
.chip img,#hudCoins img{width:20px;height:20px;object-fit:contain}
.chip.big{flex-direction:column;gap:0;padding:6px 12px;min-width:76px}
.chip.big b{font-size:21px;line-height:1.1;color:#ffe9a8;text-shadow:0 2px 4px rgba(0,0,0,.55)}
.chip.big span{font-size:10px;opacity:.8;text-transform:uppercase;letter-spacing:.6px}
.chip.green{background:linear-gradient(180deg,rgba(70,150,60,.7),rgba(35,90,30,.8))}
.chip.small{font-size:12px;padding:4px 8px}
.loadbar{width:220px;height:12px;background:rgba(0,0,0,.45);border-radius:8px;overflow:hidden;margin:6px auto;
  box-shadow:inset 0 2px 4px rgba(0,0,0,.5)}
#loadFill{height:100%;width:0;background:linear-gradient(90deg,#ffe08a,#8ede5a);transition:width .2s;
  box-shadow:0 0 10px rgba(180,255,120,.6)}
#loadPct{text-align:center;font-size:13px;opacity:.85}
#screen-loading{justify-content:center}
/* menu */
#screen-menu::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg,rgba(5,18,5,.62),rgba(5,18,5,0) 36%,rgba(5,18,5,0) 60%,rgba(5,18,5,.5))}
#screen-menu>*{position:relative}
.menutop{width:min(460px,94vw);display:flex;justify-content:flex-end}
.coinschip{background:linear-gradient(180deg,rgba(30,60,25,.9),rgba(10,30,10,.95));
  border:2px solid rgba(255,215,90,.55);border-radius:16px;padding:6px 14px;
  font-weight:900;display:flex;align-items:center;gap:7px;font-size:16px;color:#ffe9a8;
  box-shadow:0 4px 12px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.15)}
.coinschip img{width:24px;height:24px;filter:drop-shadow(0 0 6px rgba(255,215,90,.7))}
.gametitle{font-size:clamp(26px,6.6vw,42px);font-weight:900;text-align:center;margin:8px 0 4px;line-height:1.1;letter-spacing:.5px;
  background:linear-gradient(180deg,#fffbe0 8%,#ffe08a 42%,#f2a93b 68%,#c97a12 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 3px 0 rgba(80,45,0,.65)) drop-shadow(0 7px 18px rgba(0,0,0,.55))}
.garden{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:6px 0 10px;width:min(460px,94vw)}
.figslot{width:46px;height:46px;border-radius:14px;background:rgba(0,0,0,.35);border:2px dashed rgba(255,255,255,.25);
  display:flex;align-items:center;justify-content:center;font-size:20px;opacity:.6;cursor:pointer;
  box-shadow:inset 0 2px 6px rgba(0,0,0,.4)}
.figslot.owned{border:2px solid rgba(255,215,90,.6);background:rgba(255,240,180,.12);opacity:1;
  box-shadow:0 0 12px rgba(255,215,90,.35),inset 0 1px 0 rgba(255,255,255,.2)}
.figslot img{width:40px;height:40px;object-fit:contain;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}
.menucol{display:flex;flex-direction:column;gap:10px;width:min(340px,92vw);margin-top:2px}
.menurow{display:flex;gap:9px}
.menurow .btn{flex:1}
.menurow .btn img.btnicon{width:20px;height:20px}
/* pages */
.pagehead{width:min(560px,96vw);display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.pageheadtitle{font-size:19px;font-weight:900;text-shadow:0 2px 0 rgba(50,25,0,.5),0 4px 10px rgba(0,0,0,.5)}
.pagenav{display:flex;gap:10px;align-items:center;margin-bottom:8px}
.pagechip{font-weight:900;font-size:14px;background:rgba(0,0,0,.35);padding:5px 14px;border-radius:11px;
  border:1px solid rgba(255,215,110,.3)}
.lvlgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;width:min(560px,96vw);overflow-y:auto;
  padding:4px;touch-action:pan-y;flex:1;align-content:start}
.lvlbtn{position:relative;aspect-ratio:1;border:none;border-radius:16px;cursor:pointer;font:inherit;color:#fff;
  background:linear-gradient(180deg,#7cc24b 0%,#4d9230 55%,#3a7527 100%);
  box-shadow:0 3px 0 #24551c,0 6px 12px rgba(0,0,0,.4),inset 0 2px 0 rgba(255,255,255,.3);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;transition:transform .06s}
.lvlbtn:active{transform:translateY(2px)}
.lvlnum{font-size:20px;font-weight:900;text-shadow:0 2px 3px rgba(0,0,0,.5)}
.lvlstars{font-size:10px;color:#ffd76a;letter-spacing:1px;text-shadow:0 1px 2px rgba(0,0,0,.6)}
.lvlbtn.locked{background:linear-gradient(180deg,#4a5548,#333d33);box-shadow:0 3px 0 #222;opacity:.75;cursor:default}
.lvlbtn.locked .lvlnum{opacity:.6}
.lock{font-size:13px}
.lvlbtn.boss{background:linear-gradient(180deg,#e07ab8 0%,#a03a86 55%,#8a3070 100%);box-shadow:0 3px 0 #5c1c48,0 0 14px rgba(224,122,184,.5),inset 0 2px 0 rgba(255,255,255,.35)}
.bossflag{position:absolute;top:-6px;right:-4px;background:linear-gradient(180deg,#ffe08a,#e8a52c);color:#5a3a00;
  font-size:8px;font-weight:900;padding:2px 6px;border-radius:8px;transform:rotate(8deg);
  box-shadow:0 2px 5px rgba(0,0,0,.4)}
/* shop / achievements */
.shopbody,.achbody{width:min(560px,96vw);overflow-y:auto;touch-action:pan-y;flex:1;display:flex;flex-direction:column;gap:8px;padding-bottom:8px}
.sechead{font-size:16px;font-weight:900;margin:6px 0 0;text-shadow:0 2px 4px rgba(0,0,0,.5);color:#ffe9a8}
.shoprow,.achrow{display:flex;align-items:center;gap:10px;
  background:linear-gradient(180deg,rgba(25,58,26,.8),rgba(10,32,12,.85));
  border:1px solid rgba(255,215,110,.25);border-radius:16px;padding:8px 12px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.1)}
.shoprow img{width:42px;height:42px;object-fit:contain;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}
.shopname{flex:1;font-weight:800;font-size:14px}
.achrow.done{opacity:.72}
.achmedal{font-size:24px;width:34px;text-align:center;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}
.achtext{flex:1}
.achtext b{font-size:14px}
.setbody{width:min(420px,94vw);display:flex;flex-direction:column;gap:12px}
.setrow{display:flex;align-items:center;justify-content:space-between;gap:10px;font-weight:800;font-size:15px}
.langbox{display:flex;gap:8px}
/* game screen */
#screen-game{gap:6px;justify-content:flex-start}
#hud{width:min(560px,98vw);display:flex;flex-direction:column;gap:5px}
.hudrow{display:flex;align-items:center;justify-content:space-between;gap:8px}
.hudrow2{display:flex;align-items:center;gap:8px}
#goalBox{flex:1;background:linear-gradient(180deg,rgba(15,40,16,.85),rgba(6,22,8,.9));
  border:1px solid rgba(255,215,110,.35);border-radius:14px;padding:5px 10px;
  box-shadow:inset 0 2px 5px rgba(0,0,0,.45)}
#goalText{font-size:12px;font-weight:800;margin-bottom:4px;line-height:1.2;color:#f4ffd8}
.progressbar{height:10px;background:rgba(0,0,0,.5);border-radius:7px;overflow:hidden;box-shadow:inset 0 2px 4px rgba(0,0,0,.55)}
#goalFill{height:100%;width:0;border-radius:7px;transition:width .3s;
  background:linear-gradient(90deg,#ffe08a,#8ede5a);box-shadow:0 0 10px rgba(190,255,120,.65)}
.iconbtn{background:linear-gradient(180deg,rgba(30,64,30,.9),rgba(10,30,12,.95));
  border:1px solid rgba(255,215,110,.4);color:#ffe9a8;border-radius:12px;
  width:42px;height:38px;font-weight:900;font-size:15px;cursor:pointer;letter-spacing:1px;
  box-shadow:0 3px 8px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.15)}
#boardWrap{flex:1;width:100%;display:flex;align-items:center;justify-content:center;min-height:0;position:relative}
#boardFrame{position:relative;padding:16px;border-radius:26px;
  background:url("img/board_frame.png") center/100% 100% no-repeat;
  filter:drop-shadow(0 16px 34px rgba(0,0,0,.6))}
#board{border-radius:14px;display:block;background:rgba(8,28,10,.55);
  box-shadow:inset 0 0 24px rgba(0,0,0,.55),inset 0 0 0 2px rgba(255,255,255,.07);
  touch-action:none;max-width:100%;max-height:100%}
#boosterBar{display:flex;gap:8px;width:min(420px,94vw);margin-top:6px}
.boosterbtn{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;cursor:pointer;font:inherit;
  background:linear-gradient(180deg,rgba(28,62,28,.88),rgba(9,28,11,.94));
  border:1px solid rgba(255,215,110,.35);border-radius:15px;padding:6px 4px;color:#fff;min-height:54px;
  box-shadow:0 4px 10px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.14);transition:transform .06s}
.boosterbtn:active{transform:translateY(2px)}
.boosterbtn.active{border-color:#ffd76a;background:linear-gradient(180deg,rgba(120,95,20,.5),rgba(70,50,5,.6));
  box-shadow:0 0 16px rgba(255,215,90,.55)}
.biconimg{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 2px 3px rgba(0,0,0,.55))}
.starsline{color:#ffd76a;font-weight:900;letter-spacing:1px;text-shadow:0 2px 4px rgba(0,0,0,.5)}
.blabel{font-size:10px;font-weight:800;opacity:.9}
.bcount{position:absolute;top:-6px;right:-4px;background:linear-gradient(180deg,#ffe08a,#e8a52c);color:#5a3a00;
  font-size:11px;font-weight:900;min-width:19px;height:19px;border-radius:10px;display:flex;align-items:center;
  justify-content:center;padding:0 4px;box-shadow:0 2px 5px rgba(0,0,0,.45)}
/* overlay */
#overlayRoot{position:fixed;inset:0;z-index:20;display:none;align-items:center;justify-content:center;
  background:rgba(0,0,0,.58);padding:16px;backdrop-filter:blur(2px)}
#overlayRoot.open{display:flex}
.overlay{animation:pop .22s ease-out}
@keyframes pop{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
.starsrow{display:flex;justify-content:center;gap:14px;font-size:48px;margin:4px 0}
.bigstar{color:#57573f;transition:all .2s;text-shadow:0 3px 8px rgba(0,0,0,.5)}
.bigstar.on{color:#ffd76a;text-shadow:0 0 18px rgba(255,215,90,.85),0 3px 6px rgba(0,0,0,.5)}
.scoreline{font-size:15px;font-weight:800}
.coinline{font-size:21px;font-weight:900;color:#ffd76a;display:flex;align-items:center;justify-content:center;gap:8px;
  text-shadow:0 2px 5px rgba(0,0,0,.55)}
.btnrow{display:flex;gap:9px;justify-content:center;flex-wrap:wrap}
.btnrow .btn{flex:1}
.colorrow{display:flex;gap:9px;justify-content:center;flex-wrap:wrap}
.colorbtn{width:46px;height:46px;border-radius:50%;border:3px solid rgba(255,255,255,.65);cursor:pointer;
  box-shadow:0 4px 10px rgba(0,0,0,.45),inset 0 -7px 12px rgba(0,0,0,.3),inset 0 7px 12px rgba(255,255,255,.4)}
.confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.confetti i{position:absolute;top:-8%;width:9px;height:14px;border-radius:2px;opacity:.95;
  animation:confFall linear forwards}
@keyframes confFall{to{transform:translateY(115vh) rotate(720deg);opacity:.7}}
/* toast */
#toast{position:fixed;left:50%;bottom:calc(96px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);
  background:linear-gradient(180deg,rgba(20,48,20,.97),rgba(8,26,9,.98));
  border:2px solid rgba(255,215,90,.55);color:#fff;padding:10px 20px;border-radius:16px;
  font-size:14px;font-weight:800;z-index:40;opacity:0;pointer-events:none;transition:all .25s;
  max-width:90vw;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.5)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
/* tutorial banner */
.tutbanner{position:absolute;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%);
  width:min(420px,92vw);background:linear-gradient(180deg,rgba(18,52,20,.97),rgba(8,30,10,.98));
  border:2px solid #8ede5a;border-radius:18px;padding:12px 14px;
  z-index:15;display:flex;flex-direction:column;gap:9px;align-items:center;
  box-shadow:0 10px 30px rgba(0,0,0,.6),0 0 18px rgba(142,222,90,.35);animation:pop .25s ease-out}
.tuttext{font-size:14px;font-weight:800;text-align:center;line-height:1.4}
.tutskip{position:absolute;top:-11px;right:-8px;background:linear-gradient(180deg,#d9604a,#a83a28);color:#fff;
  border:none;border-radius:10px;font:inherit;font-size:11px;font-weight:900;padding:4px 10px;cursor:pointer;
  box-shadow:0 2px 6px rgba(0,0,0,.45)}




/* events / guests / cup / a11y */
.eventbanner{width:min(460px,94vw);text-align:center;font-size:12px;font-weight:800;color:#ffe9a8;
  background:linear-gradient(90deg,rgba(0,0,0,0),rgba(0,0,0,.35),rgba(0,0,0,0));
  padding:4px 8px;border-radius:10px;text-shadow:0 1px 3px rgba(0,0,0,.6)}
.guestcard{display:flex;gap:10px;align-items:center;background:linear-gradient(180deg,rgba(70,50,20,.85),rgba(35,24,8,.9));
  border:2px solid rgba(255,215,110,.5);border-radius:16px;padding:8px 10px}
.guestcard img{width:52px;height:52px;object-fit:contain;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}
.cuprow{background:rgba(0,0,0,.3);border:1px solid rgba(255,215,110,.25);border-radius:12px;padding:8px 12px;font-weight:800}
.cuprow.big{font-size:18px;color:#ffe9a8}
body.bigtext #ui{font-size:115%}
body.bigtext .btn{font-size:18px}
body.bigtext .sub{font-size:15px}
body.bigtext #goalText{font-size:14px}
body.motionreduce #ambient{display:none}
body.motionreduce .btn.pulse,body.motionreduce .chestbtn.ready{animation:none}
/* v1.4 convenience */
.hudbtns{display:flex;gap:6px}
.goalic{width:18px;height:18px;object-fit:contain;vertical-align:-4px;margin-right:6px;filter:drop-shadow(0 1px 2px rgba(0,0,0,.5))}
#goalText{display:flex;align-items:center}
.prerows{display:flex;flex-direction:column;gap:7px;text-align:left;margin:2px 0 4px}
.prerow{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700}
.prerow .goalic{width:22px;height:22px}
.prek{opacity:.78}
.chestbtn{width:42px;height:42px;border-radius:13px;border:2px solid rgba(255,215,90,.55);
  background:linear-gradient(180deg,rgba(30,60,25,.9),rgba(10,30,10,.95));
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  box-shadow:0 4px 10px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.15)}
.chestbtn img{width:22px;height:22px}
.chestbtn.ready{animation:pulse 1.4s infinite;border-color:#ffe08a;box-shadow:0 0 16px rgba(255,215,90,.65)}
.menutop{gap:8px}
.menuspacer{flex:1}
/* gardens map */
.mapbody{width:min(560px,96vw);overflow-y:auto;touch-action:pan-y;flex:1;display:grid;
  grid-template-columns:1fr 1fr;gap:10px;padding-bottom:10px;align-content:start}
.mapcard{position:relative;border-radius:18px;padding:10px;min-height:120px;display:flex;flex-direction:column;
  justify-content:flex-end;gap:6px;border:2px solid rgba(255,255,255,.25);
  box-shadow:0 8px 20px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.25);overflow:hidden}
.mapcard.locked{filter:grayscale(.85) brightness(.65)}
.mapcard.here{border-color:#ffd76a;box-shadow:0 0 18px rgba(255,215,90,.5),0 8px 20px rgba(0,0,0,.4)}
.mapinfo b{font-size:14px;text-shadow:0 2px 4px rgba(0,0,0,.6)}
.mapinfo .sub{font-size:11px}
.bloombar.small{height:12px;margin-top:4px}
.bloombar.small span{font-size:9px}
.blessline{width:min(560px,96vw);font-size:12px;font-weight:800;color:#ffe9a8;text-align:center;
  text-shadow:0 1px 3px rgba(0,0,0,.6);margin:2px 0}
.blessline.on{color:#b6ff8a;text-shadow:0 0 10px rgba(140,255,120,.5)}
/* living garden scene */
.gardenview{width:min(560px,96vw);margin:2px 0 6px}
#gardenCanvas{width:100%;border-radius:18px;display:block;
  box-shadow:0 10px 28px rgba(0,0,0,.5),inset 0 0 0 2px rgba(255,215,110,.25);
  background:#20301c}
.bloombar{position:relative;height:16px;margin-top:6px;border-radius:9px;background:rgba(0,0,0,.45);
  overflow:hidden;box-shadow:inset 0 2px 4px rgba(0,0,0,.5)}
#bloomFill{height:100%;width:0;border-radius:9px;transition:width .5s;
  background:linear-gradient(90deg,#8ede5a,#ffe08a,#ef6fae);box-shadow:0 0 10px rgba(190,255,120,.6)}
#bloomLabel{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:10px;font-weight:900;letter-spacing:.6px;text-shadow:0 1px 2px rgba(0,0,0,.7)}
/* garden equipment */
.gardenbody{width:min(560px,96vw);overflow-y:auto;touch-action:pan-y;flex:1;display:flex;flex-direction:column;gap:10px;padding-bottom:10px}
.eqcard{display:flex;align-items:center;gap:10px;background:linear-gradient(180deg,rgba(25,58,26,.85),rgba(10,32,12,.9));
  border:1px solid rgba(255,215,110,.28);border-radius:18px;padding:10px 12px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 4px 12px rgba(0,0,0,.35)}
.eqcard.locked{filter:grayscale(.75) brightness(.7)}
.eqcard{flex-wrap:wrap}
.eqcard .btn{width:100%;justify-content:center}
.eqart{width:64px;height:64px;flex:none;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(60% 60% at 50% 45%,rgba(255,240,170,.22),rgba(0,0,0,.25));border-radius:14px}
.eqart img{width:56px;height:56px;object-fit:contain;filter:drop-shadow(0 3px 5px rgba(0,0,0,.5))}
.eqinfo{flex:1;min-width:0}
.eqname{font-weight:900;font-size:14px;display:flex;gap:8px;align-items:center}
.eqpips{color:#ffd76a;letter-spacing:2px;font-size:12px;text-shadow:0 1px 2px rgba(0,0,0,.6)}
/* story dialogue */
.storybox{display:flex;gap:12px;width:min(460px,94vw);align-items:stretch;animation:pop .22s ease-out;
  background:linear-gradient(180deg,rgba(28,66,30,.96),rgba(12,36,15,.98));
  border:2px solid rgba(255,215,110,.4);border-radius:20px;padding:14px;
  box-shadow:0 16px 44px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.14)}
.storyport{width:96px;flex:none;display:flex;align-items:flex-end;justify-content:center;
  background:radial-gradient(70% 70% at 50% 40%,rgba(255,240,170,.25),rgba(0,0,0,.3));border-radius:16px}
.storyport img{width:88px;height:88px;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(0,0,0,.55))}
.storybody{flex:1;display:flex;flex-direction:column;gap:8px;min-width:0}
.storyname{font-weight:900;color:#ffe9a8;font-size:14px;letter-spacing:.4px;text-shadow:0 2px 4px rgba(0,0,0,.55)}
.storytext{font-size:14px;line-height:1.5;font-weight:600;text-shadow:0 1px 2px rgba(0,0,0,.5)}
.storydots{display:flex;gap:5px}
.storydots i{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.25)}
.storydots i.on{background:#ffd76a;box-shadow:0 0 6px rgba(255,215,90,.8)}
.journalbody{max-height:52vh;overflow-y:auto;touch-action:pan-y;display:flex;flex-direction:column;gap:10px;text-align:left}
.jscene{background:rgba(0,0,0,.25);border:1px solid rgba(255,215,110,.2);border-radius:12px;padding:8px 10px;display:flex;flex-direction:column;gap:4px}
.jline{font-size:12.5px;line-height:1.45}
.jline b{color:#ffe9a8}
/* landscape */
@media (orientation:landscape) and (max-height:520px){
  #screen-game{flex-direction:row;align-items:stretch;gap:8px}
  #hud{width:170px;flex:none;justify-content:center}
  .hudrow{flex-direction:column;align-items:stretch}
  .hudrow2{flex-direction:column}
  #boardWrap{flex:1}
  #boosterBar{width:110px;flex:none;flex-direction:column;margin-top:0}
  .tutbanner{bottom:8px;width:min(300px,40vw)}
  .gametitle{font-size:clamp(20px,4vw,32px)}
  .garden{margin:2px 0 4px}
  .menucol{width:min(300px,44vw)}
  #screen-menu{flex-direction:row;flex-wrap:wrap;justify-content:center;align-content:center;gap:6px}
  .menutop{position:absolute;top:8px;right:12px;width:auto}
  #boardFrame{padding:8px;border-radius:18px}
}
@media (max-height:430px){.garden{display:none}}
</style>
</head>
<body>
<script>
/* GamePush SDK bootstrap. Replace GP_PROJECT_ID / GP_PUBLIC_TOKEN with the
   values from your GamePush panel, then rebuild. Until they are replaced the
   loader is skipped entirely (no network calls, no ad-blocker noise) and the
   game runs on LocalAdapter. */
window.GP_PROJECT_ID = 'YOUR_PROJECT_ID';
window.GP_PUBLIC_TOKEN = 'YOUR_PUBLIC_TOKEN';
window.onGPInit = function (gp) {
  try { window.gp = gp; } finally { window.dispatchEvent(new Event('gp-ready')); }
};
(function () {
  if (!window.GP_PROJECT_ID || window.GP_PROJECT_ID === 'YOUR_PROJECT_ID') return;
  ((s, c, o, r, e) => { var f = 0, t = {}, p = 0, m = r.length, w = [], j = u => { if (f || t[u]) return; f = 1; t[u] = 1; var d = c.createElement(o); d.async = 1; d.src = u + e; d.onerror = () => { f = 0; n() }; var a = c.getElementsByTagName(o)[0]; a.parentNode.insertBefore(d, a) }, n = () => { for (var k = 0; k < w.length; k++)if (!t[w[k]]) return j(w[k]) }, q = () => { ++p >= m && !f && n() }; r.forEach(u => s.fetch(u, { method: "HEAD" }).then(x => { x && x.ok ? (w.push(u), j(u)) : q() }).catch(q)); s.setTimeout(() => { f || n() }, 5000) })(window, document, "script", atob("aHR0cHM6Ly9ncy5lcG9uZXNoLmNvbS9zZGsvZ2FtZS1zY29yZS5qcyxodHRwczovL3MzLmdhbWVwdXNoLmNvbS9maWxlcy9ncy9zZGsvZ2FtZS1zY29yZS5qcyxodHRwczovL3MzLWV1LmdhbWVwdXNoLmNvbS9zZGsvZ2FtZS1zY29yZS5qcyxodHRwczovL2dhbWVwdXNoLmNvbS9zZGsvZ2FtZS1zY29yZS5qcw==").split(","), "?projectId=" + encodeURIComponent(window.GP_PROJECT_ID) + "&publicToken=" + encodeURIComponent(window.GP_PUBLIC_TOKEN) + "&callback=onGPInit");
})();
</script>
<script src="vk-bridge.js"></script>
<script>
/* ==== match-engine.js ==== */
/* ============================================================
 * Garden Gems: Match 3 — MATCH ENGINE (pure logic, no DOM)
 * Board model, match finding, gravity, refill, cascades,
 * specials creation, available-moves check, shuffle.
 * Works in browser (window.MatchEngine) and node (module.exports).
 * ============================================================ */
(function (root, factory) {
  'use strict';
  var M = factory();
  if (typeof module !== 'undefined' && module.exports) module.exports = M;
  else root.MatchEngine = M;
})(typeof self !== 'undefined' ? self : this, function () {
  'use strict';

  var SIZE = 9;
  var T = { EMPTY: 0, GEM: 1, BLOCK: 2, ITEM: 3, CHOC: 4 };
  var SP = { NONE: 0, BOMB: 1, LIGHTNING: 2, RAINBOW: 3 };
  var MAX_CASCADES = 10;

  /* ---------- seeded RNG (mulberry32) ---------- */
  function makeRng(seed) {
    var a = (seed >>> 0) || 1;
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function hashSeed(n) { // deterministic per-level seed
    var h = 2166136261 ^ n;
    h = Math.imul(h, 16777619);
    return h >>> 0;
  }

  /* ---------- grid helpers ---------- */
  function makeGrid() {
    var g = new Array(SIZE);
    for (var r = 0; r < SIZE; r++) { g[r] = new Array(SIZE); for (var c = 0; c < SIZE; c++) g[r][c] = null; }
    return g;
  }
  function cloneGrid(g) {
    var n = makeGrid();
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = g[r][c];
      n[r][c] = cell ? { t: cell.t, c: cell.c, sp: cell.sp, hp: cell.hp, it: cell.it } : null;
    }
    return n;
  }
  function inb(r, c) { return r >= 0 && r < SIZE && c >= 0 && c < SIZE; }
  function isGem(cell) { return !!cell && cell.t === T.GEM; }
  function key(r, c) { return r * SIZE + c; }

  /* ---------- board creation ---------- */
  // cfg: {colors, blocks:[[r,c,hp]], items:[[r,c,id]], rngSeed, bias:{color,weight}}
  function createBoard(cfg) {
    var rng = makeRng(hashSeed(cfg.rngSeed || 1));
    var g = makeGrid();
    var i;
    if (cfg.blocks) for (i = 0; i < cfg.blocks.length; i++) {
      var b = cfg.blocks[i];
      g[b[0]][b[1]] = { t: T.BLOCK, c: -1, sp: SP.NONE, hp: b[2] || 1, it: 0 };
    }
    if (cfg.items) for (i = 0; i < cfg.items.length; i++) {
      var it = cfg.items[i];
      g[it[0]][it[1]] = { t: T.ITEM, c: -1, sp: SP.NONE, hp: 0, it: it[2] || 1 };
    }
    // fill gems avoiding instant matches (optional bias toward a goal color)
    var biasP = 0;
    if (cfg.bias && cfg.bias.weight > 1 && cfg.bias.color >= 0 && cfg.bias.color < cfg.colors) {
      biasP = (cfg.bias.weight - 1) / (cfg.bias.weight - 1 + cfg.colors);
    }
    function pickColor() {
      if (biasP > 0 && rng() < biasP) return cfg.bias.color;
      return Math.floor(rng() * cfg.colors);
    }
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      if (g[r][c]) continue;
      var tries = 0, col;
      do {
        col = pickColor();
        tries++;
      } while (tries < 40 && createsInstantMatch(g, r, c, col));
      g[r][c] = { t: T.GEM, c: col, sp: SP.NONE, hp: 0, it: 0 };
    }
    // guarantee at least one available move
    var guard = 0;
    while (!hasAvailableMoves(g) && guard < 60) { shuffleGrid(g, rng); guard++; }
    return g;
  }

  function createsInstantMatch(g, r, c, col) {
    // horizontal left
    if (c >= 2 && gemColor(g, r, c - 1) === col && gemColor(g, r, c - 2) === col) return true;
    // vertical up
    if (r >= 2 && gemColor(g, r - 1, c) === col && gemColor(g, r - 2, c) === col) return true;
    return false;
  }
  function gemColor(g, r, c) {
    if (!inb(r, c)) return -2;
    var cell = g[r][c];
    if (!cell || cell.t !== T.GEM) return -2;
    if (cell.ice) return -2; // frozen gems don't match until thawed
    return cell.c;
  }

  /* ---------- match finding ---------- */
  // returns { hRuns: [...], vRuns: [...] } each run = {cells:[[r,c]..], color}
  function findRuns(g) {
    var hRuns = [], vRuns = [], r, c, run, col;
    for (r = 0; r < SIZE; r++) {
      c = 0;
      while (c < SIZE) {
        col = gemColor(g, r, c);
        if (col < 0) { c++; continue; }
        run = [[r, c]];
        var cc = c + 1;
        while (cc < SIZE && gemColor(g, r, cc) === col) { run.push([r, cc]); cc++; }
        if (run.length >= 3) hRuns.push({ cells: run, color: col, dir: 'h' });
        c = cc;
      }
    }
    for (c = 0; c < SIZE; c++) {
      r = 0;
      while (r < SIZE) {
        col = gemColor(g, r, c);
        if (col < 0) { r++; continue; }
        run = [[r, c]];
        var rr = r + 1;
        while (rr < SIZE && gemColor(g, rr, c) === col) { run.push([rr, c]); rr++; }
        if (run.length >= 3) vRuns.push({ cells: run, color: col, dir: 'v' });
        r = rr;
      }
    }
    return { hRuns: hRuns, vRuns: vRuns };
  }

  function hasMatch(g) {
    var runs = findRuns(g);
    return runs.hRuns.length > 0 || runs.vRuns.length > 0;
  }

  /*
   * Full match analysis.
   * pivot: [r,c] of last swapped cell (preferred spawn point) or null.
   */
  function analyzeMatches(g, pivot) {
    var runs = findRuns(g);
    var remove = {};
    var spawns = [];
    var usedForSpawn = {};
    var i, j, run, cellK;

    // 1) detect L/T intersections -> LIGHTNING
    for (i = 0; i < runs.hRuns.length; i++) {
      for (j = 0; j < runs.vRuns.length; j++) {
        if (runs.hRuns[i].color !== runs.vRuns[j].color) continue;
        var inter = intersect(runs.hRuns[i].cells, runs.vRuns[j].cells);
        if (inter && !usedForSpawn['L' + key(inter[0], inter[1])]) {
          usedForSpawn['L' + key(inter[0], inter[1])] = 1;
          spawns.push({ r: inter[0], c: inter[1], sp: SP.LIGHTNING, color: runs.hRuns[i].color });
          markRun(runs.hRuns[i]); markRun(runs.vRuns[j]);
          runs.hRuns[i].consumed = true; runs.vRuns[j].consumed = true;
        }
      }
    }
    // 2) straight runs len>=5 -> RAINBOW, len==4 -> BOMB
    var all = runs.hRuns.concat(runs.vRuns);
    for (i = 0; i < all.length; i++) {
      run = all[i];
      markRun(run);
      if (run.consumed) continue;
      if (run.cells.length >= 5) {
        var pr = pickPivot(run.cells, pivot);
        spawns.push({ r: pr[0], c: pr[1], sp: SP.RAINBOW, color: run.color });
        run.consumed = true;
      } else if (run.cells.length === 4) {
        var pb = pickPivot(run.cells, pivot);
        spawns.push({ r: pb[0], c: pb[1], sp: SP.BOMB, color: run.color });
        run.consumed = true;
      }
    }
    function markRun(run) {
      for (var k = 0; k < run.cells.length; k++) remove[key(run.cells[k][0], run.cells[k][1])] = 1;
    }

    // remove-list minus spawn cells (spawn cells survive, transformed)
    var spawnKeys = {};
    for (i = 0; i < spawns.length; i++) spawnKeys[key(spawns[i].r, spawns[i].c)] = spawns[i];

    // existing specials caught in blast -> chain activate
    var activate = [];
    var removeList = [];
    for (cellK in remove) {
      if (!Object.prototype.hasOwnProperty.call(remove, cellK)) continue;
      var rr2 = Math.floor(cellK / SIZE), cc2 = cellK % SIZE;
      if (spawnKeys[cellK]) continue; // will be transformed, not removed
      var cell2 = g[rr2][cc2];
      removeList.push([rr2, cc2]);
      if (cell2 && cell2.t === T.GEM && cell2.sp !== SP.NONE) activate.push([rr2, cc2]);
    }
    return { remove: remove, removeList: removeList, spawns: spawns, spawnKeys: spawnKeys, activate: activate,
      runCount: runs.hRuns.length + runs.vRuns.length };
  }

  function intersect(a, b) {
    for (var i = 0; i < a.length; i++) for (var j = 0; j < b.length; j++)
      if (a[i][0] === b[j][0] && a[i][1] === b[j][1]) return a[i];
    return null;
  }
  function pickPivot(cells, pivot) {
    if (pivot) for (var i = 0; i < cells.length; i++)
      if (cells[i][0] === pivot[0] && cells[i][1] === pivot[1]) return cells[i];
    return cells[Math.floor(cells.length / 2)];
  }

  /* ---------- special effects: collect blast cells ---------- */
  function specialBlastCells(g, r, c, sp, targetColor) {
    var out = [];
    var i, j;
    if (sp === SP.BOMB) {
      for (i = r - 1; i <= r + 1; i++) for (j = c - 1; j <= c + 1; j++) {
        if (inb(i, j) && isGem(g[i][j]) && !g[i][j].ice) out.push([i, j]);
      }
    } else if (sp === SP.LIGHTNING) {
      var col = targetColor;
      if (col === undefined || col === null || col < 0) col = mostCommonColor(g);
      for (i = 0; i < SIZE; i++) for (j = 0; j < SIZE; j++) {
        var cell = g[i][j];
        if (isGem(cell) && !cell.ice && cell.c === col) out.push([i, j]);
      }
    } else if (sp === SP.RAINBOW) {
      var col2 = targetColor;
      if (col2 === undefined || col2 === null || col2 < 0) col2 = mostCommonColor(g);
      for (i = 0; i < SIZE; i++) for (j = 0; j < SIZE; j++) {
        var cell2 = g[i][j];
        if (isGem(cell2) && !cell2.ice && cell2.c === col2) out.push([i, j]);
      }
      out.push([r, c]); // rainbow itself
    }
    return out;
  }

  function mostCommonColor(g) {
    var counts = colorCounts(g);
    var best = 0, bestN = -1;
    for (var c in counts) if (counts[c] > bestN) { bestN = counts[c]; best = +c; }
    return best;
  }
  function colorCounts(g) {
    var counts = {};
    for (var r = 0; r < SIZE; r++) for (var c = 0; c < SIZE; c++) {
      var cell = g[r][c];
      if (isGem(cell) && cell.c >= 0) counts[cell.c] = (counts[cell.c] || 0) + 1;
    }
    return counts;
  }

  /* ---------- gravity ---------- */
  // Blocks are static obstacles: gems above a block stop on top of it.
  // Returns moves: [{r,c,fromR,cell}]
  function applyGravityBlocked(g) {
    var moves = [];
    for (var c = 0; c < SIZE; c++) {
      var write = SIZE - 1;
      var r = SIZE - 1;
      while (r >= 0) {
        var cell = g[r][c];
        if (cell && (cell.t === T.BLOCK || cell.t === T.CHOC)) {
          write = r - 1; r--; continue;
        }
        if (cell && cell.honey) {
          write = r - 1; r--; continue; // sticky: doesn't fall, gems pile above
        }
        if (cell && (cell.t === T.GEM || cell.t === T.ITEM)) {
          if (write !== r) {
            g[write][c] = cell; g[r][c] = null;
            moves.push({ r: write, c: c, fromR: r, cell: cell });
          }
          write--;
        }
        r--;
      }
    }
    return moves;
  }

  /* ---------- refill ---------- */
  function refill(g, colors, rng, allowRefill, bias) {
    var spawns = [];
    if (allowRefill === false) return spawns;
    var biasP = 0;
    if (bias && bias.weight > 1 && bias.color >= 0 && bias.color < colors) {
      biasP = (bias.weight - 1) / (bias.weight - 1 + colors);
    }
    for (var c = 0; c < SIZE; c++) {
      var pending = 0;    // spawn stack above the board
      var blockRow = -1;  // last block row in this column (segment divider)
      for (var r = 0; r < SIZE; r++) {
        var cur = g[r][c];
        if (cur && (cur.t === T.BLOCK || cur.t === T.CHOC || cur.honey)) { blockRow = r; pending = 0; continue; }
        if (cur) continue;
        var col = (biasP > 0 && rng() < biasP) ? bias.color : Math.floor(rng() * colors);
        var nc = { t: T.GEM, c: col, sp: SP.NONE, hp: 0, it: 0 };
        g[r][c] = nc;
        pending++;
        spawns.push({ r: r, c: c, cell: nc, fromR: blockRow >= 0 ? blockRow : -pending });
      }
    }
    return spawns;
  }

  /* ---------- available moves ---------- */
  function areAdjacent(a, b) {
    return Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) === 1;
  }
  function swapInGrid(g, a, b) {
    var tmp = g[a[0]][a[1]];
    g[a[0]][a[1]] = g[b[0]][b[1]];
    g[b[0]][b[1]] = tmp;
  }
  function isSwappable(cell) { return !!cell && cell.t === T.GEM && !cell.ice && !cell.honey; }

  function swapCreatesMatch(g, a, b) {
    swapInGrid(g, a, b);
    var m = hasMatch(g);
    swapInGrid(g, a, b);
    return m;
  }

  function hasAvailableMoves(g, extra) {
    var firstMove = findFirstMove(g, extra);
    return !!firstMove;
  }
  // returns [ [r1,c1],[r2,c2] ] of a valid move or null; extra = portal pairs
  function findFirstMove(g, extra) {
    var r, c;
    if (extra && extra.length) {
      for (var e = 0; e < extra.length; e++) {
        var pa = extra[e][0], pb = extra[e][1];
        if (isSwappable(g[pa[0]][pa[1]]) && isSwappable(g[pb[0]][pb[1]]) &&
            (swapCreatesMatch(g, pa, pb) || g[pa[0]][pa[1]].sp !== SP.NONE || g[pb[0]][pb[1]].sp !== SP.NONE)) return [pa, pb];
      }
    }
    for (r = 0; r < SIZE; r++) for (c = 0; c < SIZE; c++) {
      var cell = g[r][c];
      if (!isSwappable(cell)) continue;
      // specials can always be swapped with a normal gem neighbor
      if (cell.sp !== SP.NONE) {
        var nb = [[r - 1, c], [r + 1, c], [r, c - 1], [r, c + 1]];
        for (var i = 0; i < nb.length; i++) {
          var p = nb[i];
          if (inb(p[0], p[1]) && isSwappable(g[p[0]][p[1]])) return [[r, c], p];
        }
      }
      if (c + 1 < SIZE && isSwappable(g[r][c + 1]) && swapCreatesMatch(g, [r, c], [r, c + 1])) return [[r, c], [r, c + 1]];
      if (r + 1 < SIZE && isSwappable(g[r + 1][c]) && swapCreatesMatch(g, [r, c], [r + 1, c])) return [[r, c], [r + 1, c]];
    }
    return null;
  }

  /* ---------- shuffle (preserve specials & blocks & items), iterative ---------- */
  function shuffleGrid(g, rng) {
    rng = rng || Math.random;
    var gems = [];
    var pos = [];
    var r, c, i, k;
    for (r = 0; r < SIZE; r++) for (c = 0; c < SIZE; c++) {
      var cell0 = g[r][c];
      if (isSwappable(cell0)) { gems.push(cell0); pos.push([r, c]); }
    }
    function fisher() {
      for (var i2 = gems.length - 1; i2 > 0; i2--) {
        var j = Math.floor(rng() * (i2 + 1));
        var tmp = gems[i2]; gems[i2] = gems[j]; gems[j] = tmp;
      }
      for (var k2 = 0; k2 < pos.length; k2++) g[pos[k2][0]][pos[k2][1]] = gems[k2];
    }
    for (var attempt = 0; attempt < 80; attempt++) {
      fisher();
      if (!hasMatch(g) && hasAvailableMoves(g)) return g;
    }
    // last resort: recolor plain gems (keep specials), interleaved with position shuffles
    for (k = 0; k < 40; k++) {
      for (r = 0; r < SIZE; r++) for (c = 0; c < SIZE; c++) {
        var cl = g[r][c];
        if (isSwappable(cl) && cl.sp === SP.NONE) {
          var tries = 0;
          do { cl.c = Math.floor(rng() * 8); tries++; } while (tries < 30 && createsInstantMatch(g, r, c, cl.c));
        }
      }
      if (k % 4 === 3) fisher();
      if (!hasMatch(g) && hasAvailableMoves(g)) return g;
    }
    return g;
  }

  return {
    SIZE: SIZE, T: T, SP: SP, MAX_CASCADES: MAX_CASCADES,
    makeRng: makeRng, hashSeed: hashSeed,
    makeGrid: makeGrid, cloneGrid: cloneGrid, inb: inb, isGem: isGem, key: key,
    createBoard: createBoard, findRuns: findRuns, hasMatch: hasMatch,
    analyzeMatches: analyzeMatches, specialBlastCells: specialBlastCells,
    colorCounts: colorCounts, mostCommonColor: mostCommonColor,
    applyGravity: applyGravityBlocked, applyGravityBlocked: applyGravityBlocked,
    refill: refill, hasAvailableMoves: hasAvailableMoves, findFirstMove: findFirstMove,
    swapInGrid: swapInGrid, swapCreatesMatch: swapCreatesMatch, areAdjacent: areAdjacent,
    isSwappable: isSwappable, shuffleGrid: shuffleGrid, createsInstantMatch: createsInstantMatch
  };
});

