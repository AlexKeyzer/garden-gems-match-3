/* ==== levels.js ==== */
/* ============================================================
 * Garden Gems — 200 campaign levels (deterministic generator)
 * Bands:  1-60  easy   (5-6 colors, goals: score / collect)
 *        61-140 medium (6-7 colors, goals: collect / blocks / deliver)
 *       141-200 hard   (7-8 colors, goals: blocks / deliver / clear)
 * Every 20th level = BOSS (special layout, x coins reward).
 * ============================================================ */
(function (root, factory) {
  'use strict';
  var L = factory();
  if (typeof module !== 'undefined' && module.exports) module.exports = L;
  else root.LevelGen = L;
})(typeof self !== 'undefined' ? self : this, function () {
  'use strict';

  function rngFrom(seed) {
    var a = (seed >>> 0) || 1;
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function pick(rng, arr) { return arr[Math.floor(rng() * arr.length)]; }
  function rint(rng, a, b) { return a + Math.floor(rng() * (b - a + 1)); }

  // symmetric boss layouts (block cells, hp) — 9x9, keep borders & bottom row mostly free
  var BOSS_LAYOUTS = [
    // ring
    [[3,3,2],[3,4,2],[3,5,2],[4,3,2],[4,5,2],[5,3,2],[5,4,2],[5,5,2]],
    // cross
    [[2,4,1],[3,4,1],[4,2,1],[4,3,2],[4,4,2],[4,5,2],[4,6,1],[5,4,1],[6,4,1]],
    // corners
    [[1,1,2],[1,7,2],[7,1,2],[7,7,2],[4,4,2],[2,4,1],[6,4,1]],
    // walls
    [[2,2,1],[2,3,2],[2,5,2],[2,6,1],[6,2,1],[6,3,2],[6,5,2],[6,6,1]],
    // diamond
    [[1,4,1],[3,2,1],[3,6,1],[4,4,2],[5,2,1],[5,6,1],[7,4,1]],
    // pillars
    [[2,2,2],[3,2,1],[2,6,2],[3,6,1],[5,2,1],[6,2,2],[5,6,1],[6,6,2]],
    // zigzag
    [[1,2,1],[2,4,2],[3,6,1],[5,2,1],[6,4,2],[7,6,1]],
    // fortress
    [[2,3,1],[2,4,2],[2,5,1],[3,3,1],[3,5,1],[4,4,2],[5,3,1],[5,5,1]],
    // spiral-ish
    [[1,1,1],[1,2,1],[2,7,1],[3,7,1],[5,1,1],[6,1,1],[7,6,1],[7,7,1],[4,4,2]],
    // double cross
    [[2,2,1],[2,6,1],[6,2,1],[6,6,1],[4,4,2],[4,3,1],[4,5,1],[3,4,1],[5,4,1]]
  ];
  // simple layouts for non-boss block levels
  var BLOCK_LAYOUTS = [
    [[3,3,1],[3,5,1],[5,3,1],[5,5,1]],
    [[2,4,1],[4,2,1],[4,6,1],[6,4,1]],
    [[1,1,1],[1,7,1],[7,1,1],[7,7,1]],
    [[4,1,1],[4,2,2],[4,6,2],[4,7,1]],
    [[3,4,2],[4,3,1],[4,5,1],[5,4,2]],
    [[0,3,1],[0,5,1],[2,2,1],[2,6,1]],
    [[5,1,1],[5,4,2],[5,7,1],[6,4,1]],
    [[2,1,1],[3,4,1],[2,7,1],[6,4,2]]
  ];

  function makeLevel(n) {
    var rng = rngFrom((n * 2654435761) >>> 0);
    var boss = (n % 20 === 0);
    var lv = { n: n, boss: !!boss, seed: (n * 7919 + 13) >>> 0 };
    var band = n <= 60 ? 1 : (n <= 140 ? 2 : 3);

    // colors
    if (band === 1) lv.colors = n <= 3 ? 5 : (rng() < 0.6 ? 5 : 6);
    else if (band === 2) lv.colors = rng() < 0.55 ? 6 : 7;
    else lv.colors = (n > 170 && rng() < 0.4) ? 8 : (rng() < 0.5 ? 7 : 8);
    // boss levels keep band color ranges (spec: 6-7 on 61-140); difficulty via layout & goals

    // goal
    var gt;
    if (boss) gt = pick(rng, band === 1 ? ['score', 'collect'] : (band === 2 ? ['blocks', 'deliver', 'collect'] : ['blocks', 'deliver', 'clear']));
    else {
      if (band === 1) gt = (n <= 5) ? 'score' : pick(rng, ['score', 'score', 'collect', 'collect']);
      else if (band === 2) gt = pick(rng, ['collect', 'blocks', 'deliver', 'score']);
      else gt = pick(rng, ['blocks', 'deliver', 'collect', 'blocks']);
    }
    // 'clear the board' — rare, hardest levels only (3 of 200)
    if (n === 160 || n === 180 || n === 200) gt = 'clear';
    lv.goal = { type: gt };

    var movesBase;
    if (band === 1) movesBase = rint(rng, 18, 24);
    else if (band === 2) movesBase = rint(rng, 20, 26);
    else movesBase = rint(rng, 22, 30);
    if (boss) movesBase += 4;

    if (gt === 'score') {
      var target = band === 1 ? rint(rng, 8, 16) * 250 : (band === 2 ? rint(rng, 18, 30) * 250 : rint(rng, 30, 45) * 250);
      if (boss) target = Math.round(target * 1.5);
      if (n === 1) { target = 1000; lv.moves = 25; }   // hook: first level = instant dopamine
      lv.goal.target = target;
      if (n !== 1) lv.moves = movesBase;
    } else if (gt === 'collect') {
      lv.goal.color = rint(rng, 0, lv.colors - 1);
      lv.biasColor = lv.goal.color;
      var q = band === 1 ? rint(rng, 18, 26) : (band === 2 ? rint(rng, 28, 40) : rint(rng, 40, 55));
      if (boss) q = Math.round(q * 1.2);
      lv.goal.target = q;
      lv.moves = Math.max(movesBase, Math.ceil(q / 1.6) + 6);
    } else if (gt === 'blocks') {
      var layout = boss ? BOSS_LAYOUTS[(n / 20 - 1) % BOSS_LAYOUTS.length] : pick(rng, BLOCK_LAYOUTS);
      lv.blocks = layout.map(function (b) { return [b[0], b[1], band === 3 && rng() < 0.3 ? 2 : b[2]]; });
      lv.goal.target = lv.blocks.length; // all blocks destroyed
      lv.moves = movesBase + (boss ? 4 : 2);
    } else if (gt === 'deliver') {
      var cnt = band === 2 ? rint(rng, 2, 3) : rint(rng, 3, 5);
      if (boss) cnt += 1;
      lv.items = [];
      var usedC = {};
      for (var i = 0; i < cnt; i++) {
        var cc;
        var guard = 0;
        do { cc = rint(rng, 0, 8); guard++; } while (usedC[cc] && guard < 20);
        usedC[cc] = 1;
        lv.items.push([rint(rng, 2, 4), cc, (i % 5) + 1]);
      }
      lv.goal.target = cnt;
      lv.moves = movesBase + 6;
    } else if (gt === 'clear') {
      lv.noRefill = true;
      lv.goal.target = 81; // informational; win when zero gems left
      lv.moves = rint(rng, 26, 34);
      if (boss) lv.moves += 6;
    }

    // late-campaign mechanics: portals & chocolate
    if (band === 3 && n % 16 === 0) {
      lv.portals = [[[2, 1], [6, 7]], [[1, 5], [7, 3]], [[3, 0], [5, 8]], [[0, 4], [8, 4]]][(n / 16) % 4 | 0];
      // keep portal cells free of blocks/items
      function onPortal(r, c) {
        return lv.portals[0].some(function (p) { return p[0] === r && p[1] === c; }) ||
               lv.portals[1].some(function (p) { return p[0] === r && p[1] === c; });
      }
      if (lv.blocks) {
        lv.blocks = lv.blocks.filter(function (b) { return !onPortal(b[0], b[1]); });
        if (lv.goal.type === 'blocks') lv.goal.target = lv.blocks.length;
        if (!lv.blocks.length) { delete lv.blocks; if (lv.goal.type === 'blocks') { lv.goal = { type: 'score', target: 6000 }; } }
      }
      if (lv.items) {
        lv.items = lv.items.filter(function (it) { return !onPortal(it[0], it[1]); });
        if (lv.goal.type === 'deliver') { lv.goal.target = lv.items.length; }
        if (!lv.items.length) { delete lv.items; lv.goal = { type: 'score', target: 6000 }; }
      }
    }
    if (band === 3 && n % 19 === 0 && gt !== 'clear') {
      lv.goal = { type: 'choc' };
      lv.choc = [[3, 3], [5, 5]];
      lv.moves = movesBase + 4;
    }
    lv.reward = boss ? 200 : 50;
    return lv;
  }

  function all() {
    var arr = [];
    for (var n = 1; n <= 200; n++) arr.push(makeLevel(n));
    return arr;
  }

  return { makeLevel: makeLevel, all: all, BOSS_LAYOUTS: BOSS_LAYOUTS };
});

;
